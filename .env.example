# Copie para `.env` e preencha os valores. Sem as chaves o site roda em modo local
# (dados no localStorage) e o login social Clerk fica desativado.

# --- Supabase (login por email/senha + sincronização em nuvem) ---
# Project Settings > API no painel do Supabase.
# Use a URL BASE do projeto, sem `/rest/v1/`:
#   certo:  https://xxxxxxxx.supabase.co
#   errado: https://xxxxxxxx.supabase.co/rest/v1/
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# E-mail com permissão de administrador (página /admin)
PUBLIC_ADMIN_EMAIL=

# --- Clerk (login social) ---
# A integração só é ativada quando as DUAS chaves existem.
# Publique as MESMAS variáveis na Vercel (Production e Preview).
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Para o Clerk também poder GRAVAR no Supabase (Third-Party Auth):
#   1. Clerk Dashboard > Connect with Supabase (adiciona o claim `role: authenticated`)
#   2. Supabase Dashboard > Authentication > Third-Party Auth > Clerk (informe o domínio do Clerk)
# Sem esse passo, o login social funciona mas as escritas continuam exigindo
# o login por e-mail/senha do Supabase em /login.
