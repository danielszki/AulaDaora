# Copie para `.env` e preencha os valores. Sem as chaves o site roda em modo local
# (dados no localStorage) e o login social Clerk fica desativado.

# --- Supabase (login por email/senha + sincronização em nuvem) ---
# Project Settings > API no painel do Supabase
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# E-mail com permissão de administrador (página /admin)
PUBLIC_ADMIN_EMAIL=

# --- Clerk (login social) ---
# A integração só é ativada quando as DUAS chaves existem.
PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
