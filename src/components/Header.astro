---
import { clerkEnabled } from '../lib/clerk';

const clerkAtivo = clerkEnabled();

const links = [
  { href: '/', label: 'Início' },
  { href: '/arvore', label: 'Árvore Genealógica' },
  { href: '/kizuna', label: 'Kizuna' },
  { href: '/linha-do-tempo', label: 'Linha do Tempo' },
  { href: '/historias', label: 'Histórias' },
  { href: '/galeria', label: 'Galeria' },
  { href: '/sobre', label: 'Sobre' },
];

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="header">
  <div class="container">
    <nav class="menu">
      <a class="menu__logo" href="/">Família Kato <span class="jp" lang="ja" aria-hidden="true">加藤</span></a>
      <ul class="menu__links">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={current === link.href ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="menu__auth" id="menu-auth">
        {
          clerkAtivo ? (
            <>
              <a class="menu__auth-btn" href="/sign-in">
                Entrar
              </a>
              <a class="menu__auth-btn menu__auth-btn--destaque" href="/sign-up">
                Criar conta
              </a>
            </>
          ) : (
            <a class="menu__auth-btn" href="/login">
              Entrar
            </a>
          )
        }
      </div>

      <script>
        (function () {
          const container = document.getElementById('menu-auth');
          if (!container) return;

          function atualizar() {
            const c = window.Clerk;
            const temSessao = c?.session;
            if (!temSessao) return; // mantém Entrar/Criar conta visíveis

            const email =
              c.user?.primaryEmailAddress?.emailAddress ||
              c.user?.email_addresses?.[0]?.emailAddress ||
              '';
            container.innerHTML = '';
            const info = document.createElement('span');
            info.className = 'menu__auth-info';
            info.textContent = email || 'Usuário';
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'menu__auth-btn menu__auth-btn--sair';
            btn.textContent = 'Sair';
            btn.addEventListener('click', async () => {
              try { await c.signOut(); } catch {}
              container.innerHTML = '';
              const a1 = document.createElement('a');
              a1.className = 'menu__auth-btn';
              a1.href = '/sign-in';
              a1.textContent = 'Entrar';
              const a2 = document.createElement('a');
              a2.className = 'menu__auth-btn menu__auth-btn--destaque';
              a2.href = '/sign-up';
              a2.textContent = 'Criar conta';
              container.appendChild(a1);
              container.appendChild(a2);
            });
            container.appendChild(info);
            container.appendChild(btn);
          }

          if (window.Clerk?.session) {
            atualizar();
          } else {
            const verificar = () => {
              if (window.Clerk?.session) {
                atualizar();
              } else if (window.Clerk && typeof window.Clerk.addListener === 'function') {
                window.Clerk.addListener(({ session }) => {
                  if (session) atualizar();
                });
              } else {
                setTimeout(verificar, 300);
              }
            };
            verificar();
          }
        })();
      </script>
    </nav>
  </div>
</header>

<style>
  .menu__auth { display: flex; align-items: center; gap: 0.5rem; margin-left: auto; }
  .menu__auth-btn { font-family: inherit; font-size: 0.9rem; padding: 0.4rem 0.9rem; border: 1.5px solid var(--montanha, #6b7d6f); border-radius: 999px; background: transparent; color: inherit; cursor: pointer; text-decoration: none; }
  .menu__auth-btn:hover { border-color: var(--vinho, #8a3b3b); }
  .menu__auth-btn--destaque { background: var(--vinho, #8a3b3b); border-color: var(--vinho, #8a3b3b); color: #fff; }
  .menu__auth-btn--destaque:hover { filter: brightness(1.1); }
  .menu__auth-info {
    font-size: 0.85rem;
    color: var(--texto-suave);
    margin-right: 0.5rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 14rem;
  }
  .menu__auth-btn--sair {
    font-size: 0.85rem;
    padding: 0.35rem 0.75rem;
    border-color: var(--vinho, #8a3b3b);
    color: var(--vinho, #8a3b3b);
    background: transparent;
  }
  .menu__auth-btn--sair:hover {
    background: var(--vinho, #8a3b3b);
    color: #fff;
  }
</style>
