---
import { pessoaPorId, tipoDeEvento } from '../data/familia';
import type { Evento } from '../data/familia';

interface Props {
  evento: Evento;
  compacto?: boolean;
}

const { evento, compacto = false } = Astro.props;

const tipo = tipoDeEvento(evento);
const pessoa = evento.pessoa ? pessoaPorId(evento.pessoa) : undefined;
const rotuloTipo = { nascimento: 'Nascimento', despedida: 'Despedida', marco: 'Marco' }[tipo];
---

<article
  class:list={['evento', `evento--${tipo}`, { 'evento--compacto': compacto }]}
  data-tipo={tipo}
  data-reveal
>
  <div class="evento__linha">
    <span class="evento__ano">{evento.ano}</span>
  </div>

  <div class="evento__corpo">
    <div class="evento__topo">
      <span class="evento__tag">{rotuloTipo}</span>
      {evento.foto && (
        <figure class="evento__foto">
          <img src={evento.foto} alt={evento.titulo} loading="lazy" />
        </figure>
      )}
    </div>
    <h3 class="evento__titulo">{evento.titulo}</h3>
    {!compacto && <p class="evento__descricao">{evento.descricao}</p>}
    {!compacto && pessoa && (
      <a class="evento__link" href={`/pessoa/${pessoa.id}`}>
        Conhecer {pessoa.nome}
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </a>
    )}
  </div>
</article>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observador = new IntersectionObserver((entradas) => {
      for (const entrada of entradas) {
        if (entrada.isIntersecting) {
          entrada.target.classList.add('evento--visivel');
          observador.unobserve(entrada.target);
        }
      }
    }, { threshold: 0.15 });
    document.querySelectorAll('.evento:not(.evento--compacto)').forEach((el) => observador.observe(el));
  } else {
    document.querySelectorAll('.evento:not(.evento--compacto)').forEach((el) => el.classList.add('evento--visivel'));
  }
</script>

<style>
  .evento {
    display: flex;
    gap: 1.1rem;
    align-items: stretch;
    position: relative;
    padding-bottom: 1.4rem;
  }

  .evento:last-child {
    padding-bottom: 0.6rem;
  }

  .evento__linha {
    position: relative;
    flex: 0 0 76px;
    display: flex;
    justify-content: center;
    align-items: flex-start;
  }

  .evento__linha::before {
    content: '';
    position: absolute;
    top: 6px;
    bottom: -14px;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    background: linear-gradient(var(--oliva), var(--montanha));
  }

  .evento:last-child .evento__linha::before {
    bottom: 50%;
  }

  .evento__ano {
    position: relative;
    z-index: 1;
    background: var(--vinho);
    color: #fff;
    border-radius: 999px;
    padding: 0.28rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 700;
    white-space: nowrap;
    box-shadow: 0 1px 6px rgba(59, 52, 54, 0.18);
  }

  .evento--nascimento .evento__ano {
    background: var(--verde);
  }

  .evento--despedida .evento__ano {
    background: var(--vinho-escuro);
  }

  .evento--marco .evento__ano {
    background: var(--oliva-escuro);
  }

  .evento__corpo {
    background: var(--montanha-claro);
    border: 1px solid var(--montanha);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
    flex: 1;
    min-width: 0;
  }

  .evento__topo {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.8rem;
    margin-bottom: 0.45rem;
  }

  .evento__tag {
    font-size: 0.68rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--texto-suave);
    border: 1px solid var(--montanha);
    background: #fff;
    border-radius: 999px;
    padding: 0.18rem 0.7rem;
  }

  .evento__foto {
    flex: 0 0 auto;
    margin: 0;
    width: 96px;
    height: 72px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--montanha);
  }

  .evento__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .evento__titulo {
    margin: 0 0 0.3rem;
    font-size: 1rem;
    line-height: 1.3;
  }

  .evento__descricao {
    margin: 0;
    font-size: 0.9rem;
    color: var(--texto-suave);
  }

  .evento__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-top: 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--vinho);
  }

  .evento__link svg {
    width: 0.9em;
    height: 0.9em;
    transition: transform 0.2s;
  }

  .evento__link:hover svg {
    transform: translateX(3px);
  }

  .evento--compacto .evento__linha {
    flex-basis: 62px;
  }

  .evento--compacto .evento__corpo {
    padding: 0.7rem 1rem;
  }

  .evento--compacto .evento__ano {
    font-size: 0.66rem;
  }

  /* Revelação ao rolar */
  .js .evento:not(.evento--compacto) {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }

  .js .evento--visivel {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .js .evento:not(.evento--compacto) {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>