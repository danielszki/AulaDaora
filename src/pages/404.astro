---
import Base from '../layouts/Base.astro';
---

<Base title="Página não encontrada">
  <section class="section">
    <div class="container" style="max-width: 620px; text-align: center">
      <span class="eyebrow">404</span>
      <h1>Essa página não existe</h1>
      <p class="lead" style="margin-inline: auto">
        Pode ter sido um link antigo. Volta para o início e continua de onde
        parou.
      </p>
      <p style="margin-top: 1.5rem"><a class="btn" href="/">Voltar ao início</a></p>
    </div>
  </section>
</Base>
