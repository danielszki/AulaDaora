---
import Base from '../layouts/Base.astro';
import { pessoas, semVinculo, type Pessoa } from '../data/familia';

const soltos = semVinculo();

function pessoaToJSON(p: Pessoa) {
  return {
    id: p.id,
    nome: p.nome,
    apelido: p.apelido,
    nascimento: p.nascimento,
    falecimento: p.falecimento,
    geracao: p.geracao,
    pais: p.pais,
    conjuges: p.conjuges,
    foto: p.foto || '',
    bio: p.bio || '',
    local: p.local || '',
    profissao: p.profissao || '',
    observacao: p.observacao || '',
    agregado: p.agregado || false,
    sexo: '',
    exDe: [] as string[],
  };
}

const seed: ReturnType<typeof pessoaToJSON>[] = pessoas.map(pessoaToJSON);
const seedSoltos = soltos.map(pessoaToJSON);

// Passa pro cliente os dados e o resolvedor de soltos (sem vínculo original).
const dadosSeed = JSON.stringify(seed);
const dadosSoltos = JSON.stringify(seedSoltos);
const idsSoltes = soltos.map((p) => p.id);

const fotosSite = [
  ...new Set(pessoas.map((p) => p.foto).filter((f) => f && f.startsWith('/fotos/'))),
];
const planoPos = [
  { top: '4%', left: '-5%', w: 300, rot: -6 },
  { top: '36%', left: '-7%', w: 250, rot: 5 },
  { top: '66%', left: '-5%', w: 300, rot: -4 },
  { top: '6%', left: '70%', w: 270, rot: 4 },
  { top: '44%', left: '74%', w: 290, rot: -5 },
  { top: '74%', left: '67%', w: 250, rot: 6 },
  { top: '16%', left: '36%', w: 210, rot: 3 },
  { top: '52%', left: '31%', w: 240, rot: -3 },
  { top: '84%', left: '42%', w: 250, rot: -5 },
  { top: '0%', left: '46%', w: 190, rot: 2 },
  { top: '78%', left: '-6%', w: 270, rot: -3 },
  { top: '20%', left: '86%', w: 230, rot: -6 },
];
const fotosPlano: { src: string; top: string; left: string; w: number; rot: number }[] = [];
for (let i = 0; i < Math.min(planoPos.length, fotosSite.length); i++) {
  fotosPlano.push({ src: fotosSite[i] || '', ...planoPos[i] });
}
---

<Base
  title="Árvore Genealógica"
  description="A árvore completa da Família Kato, dos mais velhos aos mais novos — explore, edite e adicione familiares."
>
  <section class="section t-pagina">
    <div class="t-container">
      <span class="eyebrow">Árvore Genealógica</span>
      <h1>A família inteira, de Yotaro e Toyo até hoje</h1>
      <p class="lead">
        A árvore abre mostrando <strong>toda a família</strong>, começando pelos
        mais velhos: Yotaro e Toyo Kato, no topo. Arraste para mover, use a roda
        do mouse (ou os botões <strong>+</strong> e <strong>−</strong>) para dar
        zoom, e o botão <strong>⌖</strong> mostra a árvore toda de uma vez.
        Clique em alguém para ver o perfil. Com a edição ligada, os cards mostram
        botões claros para adicionar pai/mãe, filho(a), irmão(ã) ou cônjuge.
      </p>

      <div class="t-toolbar">
        <label class="t-modo">
          <input type="checkbox" id="t-modo" checked />
          <span class="t-modo__faixa"><span class="t-modo__botao"></span></span>
          <span class="t-modo__rotulo">Edição</span>
        </label>

        <div class="t-busca">
          <input
            type="search"
            id="t-busca-input"
            class="t-busca__input"
            placeholder="Procurar por nome…"
            autocomplete="off"
          />
          <div class="t-busca__resultados" id="t-busca-resultados" hidden></div>
        </div>

        <span class="t-aviso" id="t-aviso" role="status" hidden></span>

        <div class="t-menu">
          <button class="t-menu__botao" id="t-menu-btn" type="button" aria-label="Menu">☰</button>
          <div class="t-menu__dropdown" id="t-menu-dropdown" hidden>
            <button type="button" data-acao="familia">Árvore da família (foco numa pessoa)</button>
            <button type="button" data-acao="inteira">Árvore inteira (toda a família, dos mais velhos aos mais novos)</button>
            <button type="button" data-acao="lista">Lista completa (sem diagrama, boa para ler de cima a baixo)</button>
            <button type="button" data-acao="encaixar">Encaixar na tela</button>
            <button type="button" data-acao="focar">Focar na pessoa selecionada</button>
            <button type="button" data-acao="restaurar">Restaurar dados originais</button>
          </div>
        </div>
      </div>

      <div class="t-legenda" id="t-legenda">
        <span><i class="t-leg t-leg--linha" aria-hidden="true"></i> Pais ↔ filhos</span>
        <span><i class="t-leg t-leg--casal" aria-hidden="true"></i> Casal</span>
        <span><i class="t-leg t-leg--eu" aria-hidden="true"></i> Verde: a pessoa selecionada</span>
        <span><i class="t-leg t-leg--coracao" aria-hidden="true"></i> ♥ sai do casal</span>
      </div>

      <div class="t-viewport" id="t-viewport">
        <div class="t-plano" aria-hidden="true">
          {fotosPlano.map(
            (f) => (
              <div
                class="t-plano__foto"
                draggable="false"
                onselectstart="return false;"
                ondragstart="return false;"
                style={`top:${f.top};left:${f.left};width:${f.w}px;transform:rotate(${f.rot}deg)`}
              >
                <img
                  src={f.src}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                />
              </div>
            )
          )}
          <span class="t-plano__coracao" style="top:24%;right:7%">♥</span>
          <span class="t-plano__coracao" style="top:46%;right:2%">♥</span>
          <span class="t-plano__coracao" style="top:70%;right:9%">♥</span>
        </div>
        <div class="t-canvas" id="t-canvas">
          <div class="t-linhas" id="t-linhas"></div>
          <div class="t-nos" id="t-nos"></div>
        </div>

        <aside class="t-perfil" id="t-perfil" hidden>
          <button class="t-perfil__fechar" id="t-perfil-fechar" type="button" aria-label="Fechar">✕</button>
          <div class="t-perfil__conteudo" id="t-perfil-conteudo"></div>
        </aside>

        <div class="t-zoom">
          <button id="t-zoom-reset" type="button" title="Mostrar a árvore toda" aria-label="Mostrar a árvore toda">⌖ Tudo</button>
          <button id="t-zoom-in" type="button" title="Aproximar" aria-label="Aproximar">+</button>
          <button id="t-zoom-out" type="button" title="Afastar" aria-label="Afastar">−</button>
        </div>

        <div class="t-dicas" id="t-dicas" role="note" aria-hidden="true">
          <span class="t-dicas__icone" id="t-dicas-icone">⇢</span>
          <span class="t-dicas__texto" id="t-dicas-texto">Arraste para mover a árvore</span>
        </div>
      </div>

      <div class="t-soltos" id="t-soltos" hidden>
        <strong>Pessoas que ainda não conseguimos ligar à árvore principal:</strong>
        <span id="t-soltos-nomes"></span>
      </div>
    </div>
  </section>
</Base>

<script define:vars={{ dadosSeed, dadosSoltos, idsSoltes }}>
  // ---------------------------------------------------------------
  // Estado
  // ---------------------------------------------------------------
  const CHAVE = 'kato-arvore-v1';
  const CARD_W = 250;
  const CARD_H = 300;
  const CASAL_GAP = 32;
  const GAP_X = 36;
  const GAP_Y = 96;

  let pessoas = [];
  let egoId = 'daniel-suzuki';
  let modo = 'inteira'; 

  function carregar() {
    try {
      const guardado = localStorage.getItem(CHAVE);
      if (guardado) {
        const arr = JSON.parse(guardado);
        if (Array.isArray(arr) && arr.length) return arr;
      }
    } catch {}
    return JSON.parse(dadosSeed);
  }

  function persistir() {
    try {
      localStorage.setItem(CHAVE, JSON.stringify(pessoas));
      toast('Alterações salvas neste dispositivo.');
      return true;
    } catch {
      toast('Não foi possível salvar — suas alterações continuam na tela.');
      return false;
    }
  }

  function restaurar() {
    if (!window.confirm('Restaurar os dados originais? As alterações feitas neste dispositivo serão removidas.')) return;
    try {
      localStorage.removeItem(CHAVE);
    } catch {}
    pessoas = JSON.parse(dadosSeed);
    derivarSexo();
    selecionadoId = null;
    esconderPerfil();
    render();
    toast('Dados restaurados para o original.');
  }

  let selecionadoId = null;
  const mapa = new Map();
  const estadoEdicao = { ativo: true };

  // ---------------------------------------------------------------
  // Gênero: deriva bordas do par conjuges (bipartição simples)
  // ---------------------------------------------------------------
  function derivarSexo() {
    const sexo = new Map();
    const conjPendentes = new Set(pessoas.filter((p) => p.conjuges.length).map((p) => p.id));

    const marcaPar = (id, s) => {
      if (sexo.has(id)) return;
      sexo.set(id, s);
      conjPendentes.add(id);
    };

    const raiz1 = pessoas.find((p) => p.id === 'yotaro-kato');
    if (raiz1) marcaPar('yotaro-kato', 'M');
    const tamanio = (id) => {
      const p = mapa.get(id);
      if (!p) return;
      const s = sexo.get(id);
      p.sexo = s || '';
      p.conjuges.forEach((c) => {
        const par = mapa.get(c);
        if (par && s) {
          if (!sexo.has(c)) {
            sexo.set(c, s === 'M' ? 'F' : 'M');
            tamanio(c);
          } else if (sexo.get(c) !== (s === 'M' ? 'F' : 'M')) {
            // família.me marca o primeiro como M; mantém o primeiro
          }
        }
      });
    };

    // Varredura simples: para todo par, marca oposto; mantém o primeiro visitado.
    pessoas.forEach(() => {});
    // Passo 1: raiz
    tamanio('yotaro-kato');
    // Passo 2: qualquer par ainda sem gênero
    for (const p of pessoas) {
      if (p.conjuges.length && !sexo.has(p.id)) {
        sexo.set(p.id, 'M');
        tamanio(p.id);
      }
    }
    // Gênero explícito para o núcleo da família (evita cores trocadas)
    const sexoExplicito = {
      'daniel-suzuki': 'M',
      'tamae-suzuki': 'F',
      'kiyoshi-suzuki': 'M',
      'matsuko-suzuki': 'F',
      'moacir': 'M',
      'yotaro-kato': 'M',
      'toyo-kato': 'F',
    };
    for (const p of pessoas) {
      if (sexoExplicito[p.id]) p.sexo = sexoExplicito[p.id];
      else if (!p.sexo) p.sexo = sexo.get(p.id) || '';
    }
  }

  // ---------------------------------------------------------------
  // Construção da árvore (igual à lógica do familia.ts)
  // ---------------------------------------------------------------
  function constroiUniao(membros) {
    const filhos = [];
    const vistos = new Set();
    for (const m of membros) {
      for (const f of pessoas.filter((pp) => pp.pais.includes(m.id))) {
        if (vistos.has(f.id)) continue;
        vistos.add(f.id);
        const parceiro = f.conjuges
          .map((c) => mapa.get(c))
          .find((p) => p && p.id !== m.id);
        filhos.push(constroiUniao([f, parceiro].filter(Boolean)));
      }
    }
    filhos.sort((a, b) => dataDe(a.membros[0]) - dataDe(b.membros[0]));
    return { membros, filhos };
  }

  function arvore() {
    const y = mapa.get('yotaro-kato');
    const t = mapa.get('toyo-kato');
    return constroiUniao([y, t].filter(Boolean));
  }

  function dataDe(p) {
    const m = (p.nascimento || '').match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
    if (!m) return Number.MAX_SAFE_INTEGER;
    return Number(m[3]) * 10000 + Number(m[2]) * 100 + Number(m[1]);
  }

  function filhosDe(id) {
    return pessoas.filter((p) => p.pais.includes(id));
  }

  // ---------------------------------------------------------------
  // Layout (tidy: cada casal centrado sobre o próprio bloco de filhos)
  // ---------------------------------------------------------------
  function largura(u) {
    const casal = u.membros.length * CARD_W + (u.membros.length - 1) * CASAL_GAP;
    if (!u.filhos.length) return casal;
    const filhosW =
      u.filhos.reduce((acc, f) => acc + largura(f), 0) + (u.filhos.length - 1) * GAP_X;
    return Math.max(casal, filhosW);
  }

  function render() {
    pessoas = pessoas.filter(Boolean);
    mapa.clear();
    pessoas.forEach((p) => mapa.set(p.id, p));
    const nosEl = document.getElementById('t-nos');
    const svgEl = document.getElementById('t-linhas');
    nosEl.innerHTML = '';
    svgEl.innerHTML = '';
    if (!pessoas.length) {
      aviso('Nenhuma pessoa ainda. Use o menu de edição para começar.');
      syncSoltos();
      return;
    }
    if (modo === 'inteira') renderInteira();
    else if (modo === 'lista') renderLista();
    else renderFamilia();
    syncSoltos();
    const legenda = document.getElementById('t-legenda');
    if (legenda) legenda.hidden = modo === 'lista';
  }

  function renderInteira() {
    const raiz = arvore();
    if (raiz.membros.length) desenharNo(raiz, 0, 0);
    aviso('Árvore inteira: <strong>toda a família, de Yotaro e Toyo (no topo) até os mais novos</strong>. Arraste para mover, faça zoom com os botões <strong>+</strong>/<strong>−</strong> (ou a roda do mouse) e use <strong>⌖</strong> para ver a árvore toda.');
  }

  // Lista hierárquica legível: uma alternativa completa ao diagrama
  function renderLista() {
    const nosEl = document.getElementById('t-nos');
    const raiz = arvore();
    const linhas = [];
    let nivel = 0;
    const vistos = new Set();
    const percorre = (u) => {
      nivel++;
      u.membros.forEach((p, i) => {
        if (vistos.has(p.id)) return;
        vistos.add(p.id);
        const detalhe = [];
        if (p.nascimento) detalhe.push(p.nascimento);
        if (p.falecimento) detalhe.push('f. ' + p.falecimento);
        if ((p.conjuges || []).length) {
          const nomes = p.conjuges.map((c) => (mapa.get(c) || {}).nome).filter(Boolean);
          if (nomes.length) detalhe.push('casado(a) com ' + nomes.join(', '));
        }
        linhas.push(
          `<li><span class="t-lista__social">${'—'.repeat(Math.min(nivel, 8))}</span><a class="t-lista__nome" href="/pessoa/${esc(p.id)}">${esc(p.nome)}</a>` +
          `<span class="t-lista__detalhe">${esc(detalhe.join(' · '))}</span>` +
          `<button type="button" class="t-lista__ver" data-ver="${esc(p.id)}" title="Abrir na árvore">Ver na árvore ⌖</button></li>`
        );
      });
      u.filhos.forEach(percorre);
      nivel--;
    };
    percorre(raiz);
    const soltos = pessoas
      .filter((p) => !vistos.has(p.id) && p.geracao !== 0)
      .map((p) => ({ p }));
    const mais = pessoas.filter((p) => p.geracao === 0 && !vistos.has(p.id));
    let html = '<div class="t-lista">';
    html += '<h2 class="t-lista__titulo">Toda a família, de cima para baixo</h2>';
    if (linhas.length) html += '<ul class="t-lista__ul">' + linhas.join('') + '</ul>';
    if (mais.length) {
      html += '<h3 class="t-lista__sub">Antepassados citados (vínculo a confirmar)</h3><ul class="t-lista__ul">';
      html += mais.map((p) => `<li><span class="t-lista__social">—</span><a class="t-lista__nome" href="/pessoa/${esc(p.id)}">${esc(p.nome)}</a><span class="t-lista__detalhe">Antepassado citado na planilha da família</span></li>`).join('');
      html += '</ul>';
    }
    if (soltos.length) {
      html += '<h3 class="t-lista__sub">Sem vínculo identificado ainda</h3><ul class="t-lista__ul">';
      html += soltos.map(({ p }) => `<li><span class="t-lista__social">—</span><a class="t-lista__nome" href="/pessoa/${esc(p.id)}">${esc(p.nome)}</a><span class="t-lista__detalhe">${esc(anosTexto(p))}</span></li>`).join('');
      html += '</ul>';
    }
    html += '</div>';
    nosEl.innerHTML = html;
    nosEl.querySelectorAll('button[data-ver]').forEach((b) => {
      b.addEventListener('click', () => {
        const id = b.dataset.ver;
        const p = mapa.get(id);
        if (!p) return;
        selecionadoId = id;
        egoId = id;
        modo = 'familia';
        render();
        requestAnimationFrame(() => {
          pintarSelecao();
          mostrarPerfil(p);
          focar();
        });
      });
    });
    aviso('Lista completa: <strong>toda a família em texto, da mais antiga à mais nova</strong>. Toque num nome para abrir a página da pessoa, ou em “Ver na árvore” para voltar ao diagrama já no lugar certo.');
  }

  function renderFamilia() {
    const ego = mapa.get(egoId);
    if (!ego) {
      const candidato = pessoas.find((p) => (p.conjuges || []).length) || pessoas[0];
      if (!candidato) return;
      egoId = candidato.id;
      renderFamilia();
      return;
    }
    aviso(`Árvore de <strong>${esc(ego.nome)}</strong>: ancestrais e filhos. Clique em alguém e use o menu para mudar o centro.`);

    // Gerações acima (até 2 níveis de anciãos, ou seja 3 gerações ao todo): ger[0] = mais antiga
    const ger = [];
    let linha = [ego];
    for (let d = 0; d < 2; d++) {
      const acima = [];
      const vistos = new Set();
      for (const p of linha) {
        for (const pid of p.pais || []) {
          const q = mapa.get(pid);
          if (q && !vistos.has(q.id)) { vistos.add(q.id); acima.push(q); }
        }
      }
      if (!acima.length) break;
      linha = acima;
      const casais = [];
      for (const a of acima) {
        const par = a.conjuges.map((c) => mapa.get(c)).find((q) => q && q.id !== a.id);
        const membros = [a, par].filter(Boolean);
        if (!casais.some((c) => c.some((m) => membros.includes(m)))) casais.push(membros);
      }
      ger.unshift(casais);
    }

    const egoCasal = [ego].concat((ego.conjuges || []).map((c) => mapa.get(c)).filter(Boolean));
    const filhosUn = filhosDe(ego.id).sort((a, b) => dataDe(a) - dataDe(b)).map((f) => {
      const par = f.conjuges.map((c) => mapa.get(c)).find((q) => q && q.id !== f.id);
      return { membros: [f, par].filter(Boolean), filhos: [] };
    });

    // Montagem de baixo para cima: cada casal ancestral vira o nó-pai do nível abaixo
    let unidade = { membros: egoCasal, filhos: filhosUn };
    let linhaPessoas = egoCasal;
    for (let i = ger.length - 1; i >= 0; i--) {
      const casais = ger[i];
      const abaixo = unidade;
      const pessoasAbaixo = linhaPessoas;
      unidade = {
        membros: [],
        filhos: casais.map((c) => ({
          membros: c,
          filhos: c.some((cm) => pessoasAbaixo.some((np) => (np.pais || []).includes(cm.id))) ? [abaixo] : [],
        })),
      };
      linhaPessoas = casais.flat();
    }

    const raizes = unidade.membros.length ? [unidade] : unidade.filhos;
    let ix = 0;
    raizes.forEach((u) => {
      desenharNo(u, ix + largura(u) / 2, 0);
      ix += largura(u) + GAP_X;
    });
  }

  function aviso(html) {
    const el = document.getElementById('t-aviso');
    el.innerHTML = html;
    el.hidden = false;
  }

  function desenharNo(u, x, y) {
    const nosEl = document.getElementById('t-nos');
    const membros = u.membros;
    const total = membros.length * CARD_W + (membros.length - 1) * CASAL_GAP;
    let cx = x - total / 2;

    membros.forEach((m, i) => {
      const el = card(m);
      el.style.left = cx + 'px';
      el.style.top = y + 'px';
      nosEl.appendChild(el);

      if (i < membros.length - 1) {
        const x1 = cx + CARD_W;
        const x2 = x1 + CASAL_GAP;
        const cy = y + CARD_H / 2;
        line(x1, cy, x2, cy, 't-linha--casal');
        const heart = document.createElement('div');
        heart.className = 't-coracao' + (ehEx(m) ? ' t-coracao--ex' : '');
        heart.style.left = (x1 + CASAL_GAP / 2 - 9) + 'px';
        heart.style.top = (cy - 9) + 'px';
        heart.textContent = ehEx(m) ? '♡' : '♥';
        heart.title = 'Casal';
        nosEl.appendChild(heart);
      }
      cx += CARD_W + CASAL_GAP;
    });

    if (u.filhos.length > 0) {
      const paiY = y + CARD_H;
      const busY = paiY + GAP_Y / 2;
      const filhoY = paiY + GAP_Y;
      const filhosW =
        u.filhos.reduce((acc, f) => acc + largura(f), 0) + (u.filhos.length - 1) * GAP_X;
      let fx = x - filhosW / 2;

      line(x, paiY, x, busY, 't-linha');
      const filhos = u.filhos;

      // barra horizontal que une os filhos ao pai
      if (filhos.length > 1) {
        const primeiro = fx + largura(filhos[0]) / 2;
        const ultimo = fx + filhosW - largura(filhos[filhos.length - 1]) / 2;
        line(primeiro, busY, ultimo, busY, 't-linha');
      }

      filhos.forEach((f) => {
        const fW = largura(f);
        const fCenter = fx + fW / 2;
        line(fCenter, busY, fCenter, filhoY, 't-linha');
        desenharNo(f, fCenter, filhoY);
        fx += fW + GAP_X;
      });
    }
  }

  function line(x1, y1, x2, y2, cls) {
    const l = document.createElement('div');
    const grossura = cls.indexOf('casal') >= 0 ? 3 : 4;
    if (x1 === x2) {
      l.style.width = grossura + 'px';
      l.style.height = Math.abs(y2 - y1) + 'px';
      l.style.left = (x1 - grossura / 2) + 'px';
      l.style.top = Math.min(y1, y2) + 'px';
    } else {
      l.style.height = grossura + 'px';
      l.style.width = Math.abs(x2 - x1) + 'px';
      l.style.left = Math.min(x1, x2) + 'px';
      l.style.top = (y1 - grossura / 2) + 'px';
    }
    l.className = 't-linha ' + cls;
    document.getElementById('t-linhas').appendChild(l);
  }

  function ehEx(p) {
    return (p.exDe || []).length > 0;
  }

  function card(p) {
    const el = document.createElement('div');
    el.className = 't-no';
    el.dataset.id = p.id;
    const foto = p.foto;
    const anos = anosTexto(p);
    const partes = parteNome(p);
    const sel = selecionadoId === p.id;
    const silhueta = `<svg class="t-card__silhueta" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="20" r="12" fill="currentColor"/><path d="M8 60c3.4-15.8 13.2-23.5 24-23.5S52.6 44.2 56 60z" fill="currentColor"/></svg>`;
    const capa = foto
      ? `<img class="t-card__foto" src="${esc(foto)}" alt="${esc(p.nome)}" loading="lazy" />`
      : silhueta;
    el.innerHTML = `
      <div class="t-card${sel ? ' t-card--sel' : ''}">
        <button type="button" class="t-editar" data-acao="editar" title="Editar dados" aria-label="Editar dados">✎</button>
        <div class="t-card__capa t-card__capa--${generoClasse(p)}">${capa}</div>
        <div class="t-card__info">
          <div class="t-card__primeiro">${esc(partes.primeiro || p.nome)}</div>
          ${partes.ultimo ? `<div class="t-card__ultimo">${esc(partes.ultimo)}</div>` : ''}
          ${anos ? `<div class="t-card__anos">${esc(anos)}</div>` : ''}
        </div>
        <div class="t-card__controles" data-edicao>
          <button type="button" class="t-ctrl t-ctrl--pai" data-acao="pai" title="Adicionar pai ou mãe"><span class="t-ctrl__icone">＋</span><span class="t-ctrl__rotulo">Pai/mãe</span></button>
          <button type="button" class="t-ctrl t-ctrl--filho" data-acao="filho" title="Adicionar filho(a)"><span class="t-ctrl__icone">＋</span><span class="t-ctrl__rotulo">Filho(a)</span></button>
          <button type="button" class="t-ctrl t-ctrl--irmao" data-acao="irmao" title="Adicionar irmão(ã)"><span class="t-ctrl__icone">＋</span><span class="t-ctrl__rotulo">Irmão(ã)</span></button>
          <button type="button" class="t-ctrl t-ctrl--conjuge" data-acao="conjuge" title="Adicionar cônjuge"><span class="t-ctrl__icone">♥</span><span class="t-ctrl__rotulo">Cônjuge</span></button>
        </div>
      </div>`;

    el.addEventListener('click', (ev) => {
      if (ev.target.closest('[data-acao]')) return;
      selecionadoId = p.id;
      pintarSelecao();
      mostrarPerfil(p);
    });

    el.tabIndex = 0;
    el.setAttribute('role', 'button');
    el.setAttribute('aria-label', `Abrir perfil de ${p.nome}`);
    el.addEventListener('keydown', (ev) => {
      if (ev.key === 'Enter' || ev.key === ' ') {
        ev.preventDefault();
        selecionadoId = p.id;
        pintarSelecao();
        mostrarPerfil(p);
      }
    });

    el.querySelectorAll('[data-acao]').forEach((btn) => {
      btn.addEventListener('click', (ev) => {
        if (!estadoEdicao.ativo) return;
        ev.stopPropagation();
        const acao = btn.dataset.acao;
        if (acao === 'editar') abrirEditar(p.id);
        else abrirNovo(acao, p.id);
      });
    });
    return el;
  }

  function pintarSelecao() {
    document.querySelectorAll('.t-no').forEach((n) => {
      n.classList.toggle('t-no--sel', n.dataset.id === selecionadoId);
    });
  }

  function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, (ch) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
  }

  function parteNome(p) {
    const partes = (p.nome || '').trim().split(/\s+/);
    if (partes.length <= 1) return { primeiro: p.nome || '', ultimo: '' };
    return { primeiro: partes.slice(0, -1).join(' '), ultimo: partes[partes.length - 1] };
  }

  function nomeIniciais(nome) {
    return (nome || '').split(/\s+/).map((n) => n[0]).filter(Boolean).slice(0, 2).join('').toUpperCase();
  }

  function anosTexto(p) {
    const extrair = (s) => {
      const m = (s || '').match(/\d{4}/);
      return m ? m[0] : s || '';
    };
    const n = extrair(p.nascimento);
    const f = extrair(p.falecimento);
    if (n && f) return `${n} – ${f}`;
    if (n) return `${n}`;
    if (f) return `f. ${f}`;
    return '';
  }

  function generoClasse(p) {
    if (p.sexo === 'F') return 'fem';
    if (p.sexo === 'M') return 'masc';
    return 'neu';
  }

  function seloGenero(p) {
    return p.sexo === 'M' ? '♂' : p.sexo === 'F' ? '♀' : '';
  }

  // ---------------------------------------------------------------
  // Pan / zoom / encaixe
  // ---------------------------------------------------------------
  const viewport = document.getElementById('t-viewport');
  const canvas = document.getElementById('t-canvas');
  let escala = 1;
  let tx = 0;
  let ty = 0;

  function aplicar() {
    canvas.style.transform = `translate(${tx}px, ${ty}px) scale(${escala})`;
  }

  function encaixar() {
    const nos = document.querySelectorAll('.t-no');
    if (!nos.length) return;
    let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
    nos.forEach((el) => {
      const L = parseFloat(el.style.left);
      const T = parseFloat(el.style.top);
      minX = Math.min(minX, L);
      maxX = Math.max(maxX, L + CARD_W);
      minY = Math.min(minY, T);
      maxY = Math.max(maxY, T + CARD_H);
    });
    const pad = 56;
    const perfilAberto = perfil && !perfil.hidden;
    const sobre = perfilAberto ? 340 : 0;
    const w = maxX - minX + pad * 2;
    const h = maxY - minY + pad * 2;
    const rect = viewport.getBoundingClientRect();
    escala = Math.min((rect.width - sobre) / w, rect.height / h, 1);
    tx = (rect.width + sobre) / 2 - ((minX + maxX) / 2) * escala;
    ty = rect.height / 2 - ((minY + maxY) / 2) * escala;
    aplicar();
  }

  function focar() {
    if (!selecionadoId) { encaixar(); return; }
    const no = document.querySelector(`.t-no[data-id="${selecionadoId}"]`);
    if (!no) { encaixar(); return; }
    const rect = viewport.getBoundingClientRect();
    const perfilAberto = perfil && !perfil.hidden;
    const sobre = perfilAberto ? 340 : 0;
    const L = parseFloat(no.style.left) + CARD_W / 2;
    const T = parseFloat(no.style.top) + CARD_H / 2;
    escala = Math.max(escala, 1);
    tx = (rect.width + sobre) / 2 - L * escala;
    ty = rect.height / 2 - T * escala;
    aplicar();
  }

  function zoom(fator, cx, cy) {
    const nova = Math.max(0.15, Math.min(3, escala * fator));
    const ratio = nova / escala;
    tx = cx - (cx - tx) * ratio;
    ty = cy - (cy - ty) * ratio;
    escala = nova;
    aplicar();
  }

  let arrastando = false;
  let arrasto = null;

  viewport.addEventListener('mousedown', (e) => {
    if (e.target.closest('.t-card') || e.target.closest('button') || e.target.closest('.t-perfil')) return;
    arrastando = true;
    arrasto = { x: e.clientX - tx, y: e.clientY - ty };
    viewport.style.cursor = 'grabbing';
  });
  window.addEventListener('mousemove', (e) => {
    if (!arrastando) return;
    tx = e.clientX - arrasto.x;
    ty = e.clientY - arrasto.y;
    aplicar();
  });
  window.addEventListener('mouseup', () => {
    arrastando = false;
    viewport.style.cursor = 'grab';
  });
  viewport.addEventListener('wheel', (e) => {
    e.preventDefault();
    const rect = viewport.getBoundingClientRect();
    zoom(e.deltaY < 0 ? 1.12 : 0.9, e.clientX - rect.left, e.clientY - rect.top);
  }, { passive: false });

  document.getElementById('t-zoom-in').addEventListener('click', () => {
    const rect = viewport.getBoundingClientRect();
    zoom(1.2, rect.width / 2, rect.height / 2);
  });
  document.getElementById('t-zoom-out').addEventListener('click', () => {
    const rect = viewport.getBoundingClientRect();
    zoom(0.8, rect.width / 2, rect.height / 2);
  });
  document.getElementById('t-zoom-reset').addEventListener('click', encaixar);

  window.addEventListener('resize', () => {
    if (!selecionadoId) encaixar();
    else focar();
  });

  // ---------------------------------------------------------------
  // Modo edição (ligado/desligado)
  // ---------------------------------------------------------------
  const modoBtn = document.getElementById('t-modo');
  modoBtn.addEventListener('change', () => {
    estadoEdicao.ativo = modoBtn.checked;
    document.body.classList.toggle('t-sem-edicao', !estadoEdicao.ativo);
  });

  // ---------------------------------------------------------------
  // Busca
  // ---------------------------------------------------------------
  const buscaInput = document.getElementById('t-busca-input');
  const buscaResultados = document.getElementById('t-busca-resultados');
  buscaInput.addEventListener('input', () => {
    const termo = buscaInput.value.trim().toLowerCase();
    if (!termo) { buscaResultados.hidden = true; buscaResultados.innerHTML = ''; return; }
    const achados = pessoas
      .filter((p) => p.nome.toLowerCase().includes(termo))
      .slice(0, 8);
    buscaResultados.hidden = achados.length === 0;
    if (!achados.length) { buscaResultados.innerHTML = '<em class="t-busca__vazio">Ninguém encontrado.</em>'; return; }
    buscaResultados.innerHTML = achados
      .map((p) => `<button type="button" data-id="${p.id}">${esc(p.nome)}</button>`)
      .join('');
    buscaResultados.querySelectorAll('button').forEach((b) => {
      b.addEventListener('click', () => {
        selecionadoId = b.dataset.id;
        const p = mapa.get(selecionadoId);
        if (p) mostrarPerfil(p);
        encaixar();
        requestAnimationFrame(focar);
        buscaInput.value = '';
        buscaResultados.hidden = true;
        buscaResultados.innerHTML = '';
      });
    });
  });

  // ---------------------------------------------------------------
  // Menu
  // ---------------------------------------------------------------
  const menuBtn = document.getElementById('t-menu-btn');
  const menuDrp = document.getElementById('t-menu-dropdown');
  menuBtn.addEventListener('click', () => { menuDrp.hidden = !menuDrp.hidden; });
  menuDrp.addEventListener('click', (e) => {
    const btn = e.target.closest('button[data-acao]');
    if (!btn) return;
    menuDrp.hidden = true;
    const acao = btn.dataset.acao;
    if (acao === 'familia') {
      if (selecionadoId && mapa.get(selecionadoId)) egoId = selecionadoId;
      modo = 'familia';
      render();
      requestAnimationFrame(encaixar);
    } else if (acao === 'inteira') {
      modo = 'inteira';
      render();
      requestAnimationFrame(encaixar);
    } else if (acao === 'lista') {
      modo = 'lista';
      render();
    } else if (acao === 'encaixar') { encaixar(); }
    else if (acao === 'focar') { focar(); }
    else if (acao === 'restaurar') { restaurar(); }
  });

  // ---------------------------------------------------------------
  // Painel de perfil
  // ---------------------------------------------------------------
  const perfil = document.getElementById('t-perfil');
  const perfilConteudo = document.getElementById('t-perfil-conteudo');
  const perfilFechar = document.getElementById('t-perfil-fechar');

  function esconderPerfil() {
    perfil.hidden = true;
  }
  perfilFechar.addEventListener('click', () => { esconderPerfil(); selecionadoId = null; pintarSelecao(); });

  function listaNomes(ids) {
    return ids.map((id) => mapa.get(id)).filter(Boolean).map((p) => p.nome).join(', ');
  }

  function mostrarPerfil(p) {
    const filhos = filhosDe(p.id).map((f) => f.nome);
    const gen = p.sexo === 'M' ? 'Masculino' : p.sexo === 'F' ? 'Feminino' : 'Não informado';
    perfilConteudo.innerHTML = `
      <div class="t-perfil__topo">
        <span class="t-perfil__avatar t-perfil__avatar--${generoClasse(p)}">
          ${p.foto ? `<img src="${esc(p.foto)}" alt="${esc(p.nome)}" />` : nomeIniciais(p.nome)}
        </span>
        <span class="t-perfil__tag">${esc(p.nome.toUpperCase())}</span>
      </div>
      <div class="t-perfil__caixa">
        <span class="t-perfil__foto t-perfil__foto--${generoClasse(p)}">
          ${p.foto ? `<img src="${esc(p.foto)}" alt="${esc(p.nome)}" />` : `<span>${seloGenero(p) || nomeIniciais(p.nome)}</span>`}
        </span>
        <div class="t-perfil__caixa-texto">
          <h3>${esc(p.nome)}${p.apelido ? ` <small>“${esc(p.apelido)}”</small>` : ''}</h3>
          <p class="t-perfil__memorias">${esc(anosTexto(p) || 'Datas a confirmar')} · ${esc(gen)}</p>
        </div>
      </div>
      ${p.pais.length ? `<p class="t-perfil__linha"><strong>Pais:</strong> ${esc(listaNomes(p.pais))}</p>` : ''}
      ${p.conjuges.length ? `<p class="t-perfil__linha"><strong>Cônjuge:</strong> ${esc(listaNomes(p.conjuges))}${(p.exDe || []).length ? ' <em>(ex)</em>' : ''}</p>` : ''}
      ${filhos.length ? `<p class="t-perfil__linha"><strong>Filhos:</strong> ${esc(filhos.join(', '))}</p>` : ''}
      ${p.local ? `<p class="t-perfil__linha"><strong>Local:</strong> ${esc(p.local)}</p>` : ''}
      ${p.profissao ? `<p class="t-perfil__linha"><strong>Profissão:</strong> ${esc(p.profissao)}</p>` : ''}
      ${p.bio ? `<p class="t-perfil__bio">${esc(p.bio)}</p>` : ''}
      ${p.observacao ? `<p class="t-perfil__obs">${esc(p.observacao)}</p>` : ''}
      <p class="t-perfil__centro"><button type="button" data-perfil="centro">Colocar no centro da árvore</button></p>
      <div class="t-perfil__acoes" data-edicao>
        <button type="button" data-perfil="editar">Editar perfil</button>
        <a href="/pessoa/${p.id}">Ver página completa →</a>
      </div>`;
    perfil.hidden = false;
    perfilConteudo.querySelectorAll('[data-perfil]').forEach((b) => {
      b.addEventListener('click', () => {
        const acao = b.dataset.perfil;
        if (acao === 'centro') {
          egoId = p.id;
          modo = 'familia';
          render();
          requestAnimationFrame(encaixar);
          return;
        }
        if (!estadoEdicao.ativo) return;
        if (acao === 'editar') abrirEditar(p.id);
      });
    });
  }

  // ---------------------------------------------------------------
  // Modal genérico
  // ---------------------------------------------------------------
  function modal(html) {
    fecharModal();
    const overlay = document.createElement('div');
    overlay.className = 't-modal';
    overlay.innerHTML = `<div class="t-modal__caixa">${html}</div>`;
    document.body.appendChild(overlay);
    overlay.addEventListener('click', (e) => { if (e.target === overlay) fecharModal(); });
    return overlay;
  }
  function fecharModal() {
    const m = document.querySelector('.t-modal');
    if (m) m.remove();
  }

  // ---------------------------------------------------------------
  // Adicionar parente/cônjuge
  // ---------------------------------------------------------------
  const TIPOS = {
    pai: 'Pai ou mãe',
    filho: 'Filho(a)',
    irmao: 'Irmão(ã)',
    conjuge: 'Cônjuge (esposa/esposo)',
  };

  function abrirNovo(tipo, idAlvo) {
    const alvo = mapa.get(idAlvo);
    if (!alvo) return;
    const rotulo = TIPOS[tipo] || 'Novo parente';
    let sexoInicial = '';
    let exHtml = '';
    if (tipo === 'conjuge') {
      sexoInicial = alvo.sexo === 'M' ? 'F' : alvo.sexo === 'F' ? 'M' : '';
      exHtml = `
        <label class="t-modal__ex">
          <input type="checkbox" id="t-novo-ex" />
          <span>Marcar como ex-cônjuge</span>
        </label>`;
    }
    const overlay = modal(`
      <h2>Adicionar ${rotulo.toLowerCase()}</h2>
      <p class="t-modal__hint">Relacionado a <strong>${esc(alvo.nome)}</strong></p>
      <label class="t-modal__campo">
        Nome completo
        <input type="text" id="t-novo-nome" placeholder="Ex.: Caroline Silva" autocomplete="off" />
      </label>
      <div class="t-modal__gender">
        <span class="t-modal__gender-titulo">Gênero</span>
        <div class="t-modal__gender-picker" id="t-novo-gender">
          <button type="button" class="t-gen t-gen--m${sexoInicial === 'M' ? ' ativo' : ''}" data-gen="M">♂ Masculino</button>
          <button type="button" class="t-gen t-gen--f${sexoInicial === 'F' ? ' ativo' : ''}" data-gen="F">♀ Feminino</button>
          <button type="button" class="t-gen${!sexoInicial ? ' ativo' : ''}" data-gen="">Indefinido</button>
        </div>
      </div>
      ${exHtml}
      <div class="t-modal__acoes">
        <button type="button" class="t-modal__cancelar" id="t-novo-cancelar">Cancelar</button>
        <button type="button" class="t-modal__salvar" id="t-novo-salvar">Salvar</button>
      </div>`);
    escolherGeneroSem = sexoInicial;
    const nomeInput = overlay.querySelector('#t-novo-nome');
    const genBtns = overlay.querySelectorAll('#t-novo-gender .t-gen');
    genBtns.forEach((b) => b.addEventListener('click', () => {
      genBtns.forEach((x) => x.classList.remove('ativo'));
      b.classList.add('ativo');
      escolherGeneroSem = b.dataset.gen;
    }));
    overlay.querySelector('#t-novo-cancelar').addEventListener('click', fecharModal);
    overlay.querySelector('#t-novo-salvar').addEventListener('click', () => {
      const nome = nomeInput.value.trim();
      if (!nome) { nomeInput.focus(); return; }
      const ex = !!overlay.querySelector('#t-novo-ex')?.checked;
      salvarNovo(tipo, alvo, nome, escolherGeneroSem, ex);
    });
    nomeInput.focus();
  }

  let escolherGeneroSem = '';

  function criarId(nome) {
    const base = nome
      .toLowerCase()
      .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9-]+/g, '-')
      .replace(/^-+|-+$/g, '')
      .slice(0, 40) || 'pessoa';
    const suf = Date.now().toString(36);
    return `${base}-${suf}`;
  }

  function salvarNovo(tipo, alvo, nome, sexo, ex) {
    const id = criarId(nome);
    const nova = {
      id,
      nome,
      nascimento: '', falecimento: '', geracao: alvo.geracao + (tipo === 'filho' ? 1 : 0),
      pais: [], conjuges: [], foto: '', bio: '', local: '', profissao: '', observacao: '',
      agregado: false, sexo, exDe: [],
    };

    if (tipo === 'conjuge') {
      nova.conjuges = [alvo.id];
      if (ex) nova.exDe.push(alvo.id);
      alvo.conjuges = alvo.conjuges.filter((c) => c !== nova.id);
      alvo.conjuges.push(nova.id);
    } else if (tipo === 'filho') {
      nova.geracao = alvo.geracao + 1;
      nova.pais = [alvo.id].concat(alvo.conjuges);
      if (alvo.conjuges[0]) {
        const par = mapa.get(alvo.conjuges[0]);
        if (par) {
          par.pais = par.pais || [];
        }
      }
      alvo.pais = alvo.pais || [];
    } else if (tipo === 'irmao') {
      nova.geracao = alvo.geracao;
      nova.pais = alvo.pais.slice();
    } else if (tipo === 'pai') {
      nova.geracao = Math.max(0, alvo.geracao - 1);
      const paisOrig = alvo.pais.slice();
      if (paisOrig.length === 1) {
        const outro = mapa.get(paisOrig[0]);
        if (outro && !outro.conjuges.length) {
          outro.conjuges = [nova.id];
          nova.conjuges = [outro.id];
        }
      }
      nova.pais = [];
      alvo.pais = paisOrig.concat(nova.id);
    }

    pessoas.push(nova);
    persistir();
    render();
    selecionadoId = nova.id;
    pintarSelecao();
    mostrarPerfil(nova);
    fecharModal();
    locaNovo();
    toast(rotuloTipo(tipo) + ' adicionada à árvore.');
  }

  function rotuloTipo(tipo) {
    return ({ pai: 'Pessoa', filho: 'Filho(a)', irmao: 'Irmão(ã)', conjuge: 'Cônjuge' })[tipo] || 'Pessoa';
  }

  function locaNovo() {
    const no = document.querySelector('.t-no:last-of-type');
    if (no && selecionadoId) {
      requestAnimationFrame(() => {
        const alvo = document.querySelector(`.t-no[data-id="${selecionadoId}"]`);
        const rect = viewport.getBoundingClientRect();
        if (alvo) {
          const L = parseFloat(alvo.style.left) + CARD_W / 2;
          const T = parseFloat(alvo.style.top) + CARD_H / 2;
          escala = Math.max(escala, 0.9);
          tx = rect.width / 2 - L * escala;
          ty = rect.height / 2 - T * escala;
          aplicar();
        }
      });
    }
  }

  // ---------------------------------------------------------------
  // Editar perfil
  // ---------------------------------------------------------------
  function abrirEditar(id) {
    const p = mapa.get(id);
    if (!p) return;
    const parts = (p.nascimento || '').match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
    const nacD = parts ? parts[1] : '';
    const nacM = parts ? parts[2] : '';
    const nacA = parts ? parts[3] : '';
    const overlay = modal(`
      <h2>Editar ${esc(p.nome)}</h2>
      <label class="t-modal__campo">
        Nome completo
        <input type="text" id="t-edit-nome" value="${esc(p.nome)}" />
      </label>
      <label class="t-modal__campo">
        Foto
        <div class="t-modal__foto">
          <div class="t-modal__foto-preview" id="t-edit-foto-preview">
            ${p.foto ? `<img src="${esc(p.foto)}" alt="" />` : '<span class="t-modal__foto-vazio">Sem foto</span>'}
          </div>
          <div class="t-modal__foto-acoes">
            <input type="file" id="t-edit-foto" accept="image/*" />
            <button type="button" class="t-modal__foto-remover" id="t-edit-foto-remover">Remover foto</button>
          </div>
          <p class="t-modal__hint" style="margin-top:0.4rem">A foto fica guardada neste dispositivo (não vai para o site automaticamente).</p>
        </div>
      </label>
      <div class="t-modal__linha">
        <label class="t-modal__campo">Nascimento (dd/mm/aaaa)
          <input type="text" id="t-edit-nacd" value="${esc(nacD)}" placeholder="dd" />
        </label>
        <label class="t-modal__campo">
          <input type="text" id="t-edit-nacm" value="${esc(nacM)}" placeholder="mm" />
        </label>
        <label class="t-modal__campo">
          <input type="text" id="t-edit-naca" value="${esc(nacA)}" placeholder="aaaa" />
        </label>
      </div>
      <label class="t-modal__campo">
        Falecimento (texto livre)
        <input type="text" id="t-edit-fale" value="${esc(p.falecimento || '')}" placeholder="Deixe vazio se vivo" />
      </label>
      <div class="t-modal__gender">
        <span class="t-modal__gender-titulo">Gênero</span>
        <div class="t-modal__gender-picker" id="t-edit-gender">
          <button type="button" class="t-gen t-gen--m${p.sexo === 'M' ? ' ativo' : ''}" data-gen="M">♂ Masculino</button>
          <button type="button" class="t-gen t-gen--f${p.sexo === 'F' ? ' ativo' : ''}" data-gen="F">♀ Feminino</button>
          <button type="button" class="t-gen${!p.sexo ? ' ativo' : ''}" data-gen="">Indefinido</button>
        </div>
      </div>
      <label class="t-modal__campo">
        Bio / profissão / local
        <textarea id="t-edit-bio" rows="3">${esc(p.bio || '')}</textarea>
      </label>
      <div class="t-modal__acoes">
        <button type="button" class="t-modal__cancelar" id="t-edit-cancelar">Cancelar</button>
        <button type="button" class="t-modal__salvar" id="t-edit-salvar">Salvar</button>
      </div>`);
    let gen = p.sexo;
    let fotoAtual = p.foto || '';
    overlay.querySelectorAll('#t-edit-gender .t-gen').forEach((b) => b.addEventListener('click', () => {
      overlay.querySelectorAll('#t-edit-gender .t-gen').forEach((x) => x.classList.remove('ativo'));
      b.classList.add('ativo');
      gen = b.dataset.gen;
    }));

    const inputFoto = overlay.querySelector('#t-edit-foto');
    const previewFoto = overlay.querySelector('#t-edit-foto-preview');
    const removerFoto = overlay.querySelector('#t-edit-foto-remover');
    function atualizarPreviewFoto(src) {
      if (src) previewFoto.innerHTML = `<img src="${esc(src)}" alt="" />`;
      else previewFoto.innerHTML = '<span class="t-modal__foto-vazio">Sem foto</span>';
    }
    if (inputFoto) {
      inputFoto.addEventListener('change', () => {
        const arq = inputFoto.files && inputFoto.files[0];
        if (!arq) return;
        if (!arq.type.startsWith('image/')) { toast('Arquivo não é imagem.'); return; }
        const reader = new FileReader();
        reader.onload = (ev) => {
          const img = new Image();
          img.onload = () => {
            const MAX = 512;
            let w = img.width, h = img.height;
            if (w > MAX || h > MAX) {
              if (w >= h) { h = Math.round(h * MAX / w); w = MAX; }
              else { w = Math.round(w * MAX / h); h = MAX; }
            }
            const canvas = document.createElement('canvas');
            canvas.width = w; canvas.height = h;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(img, 0, 0, w, h);
            try {
              const dataUrl = canvas.toDataURL('image/jpeg', 0.82);
              fotoAtual = dataUrl;
              atualizarPreviewFoto(dataUrl);
            } catch {
              toast('Não foi possível processar a imagem.');
            }
          };
          img.src = ev.target.result;
        };
        reader.readAsDataURL(arq);
      });
    }
    if (removerFoto) {
      removerFoto.addEventListener('click', () => {
        fotoAtual = '';
        if (inputFoto) inputFoto.value = '';
        atualizarPreviewFoto('');
      });
    }

    overlay.querySelector('#t-edit-cancelar').addEventListener('click', fecharModal);
    overlay.querySelector('#t-edit-salvar').addEventListener('click', () => {
      const nome = overlay.querySelector('#t-edit-nome').value.trim();
      if (!nome) return;
      const d = overlay.querySelector('#t-edit-nacd').value.trim();
      const m = overlay.querySelector('#t-edit-nacm').value.trim();
      const a = overlay.querySelector('#t-edit-naca').value.trim();
      const natal = d && m && a ? `${d}/${m}/${a}` : (p.nascimento || '');
      p.nome = nome;
      if (d && m && a) p.nascimento = natal;
      p.falecimento = overlay.querySelector('#t-edit-fale').value.trim();
      p.sexo = gen;
      p.bio = overlay.querySelector('#t-edit-bio').value.trim();
      p.foto = fotoAtual;
      persistir();
      render();
      pintarSelecao();
      mostrarPerfil(p);
      fecharModal();
      toast('Perfil salvo.');
    });
  }

  // ---------------------------------------------------------------
  // Toast
  // ---------------------------------------------------------------
  function toast(msg) {
    const t = document.createElement('div');
    t.className = 't-toast';
    t.textContent = msg;
    document.body.appendChild(t);
    const limpar = () => t.remove();
    setTimeout(limpar, 4000);
  }

  // ---------------------------------------------------------------
  // Soltos + inicialização
  // ---------------------------------------------------------------
  function syncSoltos() {
    const hojeArvore = new Set();
    const percorre = (u) => { u.membros.forEach((p) => hojeArvore.add(p.id)); u.filhos.forEach(percorre); };
    percorre(arvore());
    const ainda = pessoas.filter((p) => idsSoltes.includes(p.id) && !hojeArvore.has(p.id));
    const bloco = document.getElementById('t-soltos');
    const nomes = document.getElementById('t-soltos-nomes');
    if (ainda.length && estadoEdicao.ativo) {
      bloco.hidden = false;
      nomes.innerHTML = ainda.map((p) => esc(p.nome)).join(' · ');
    } else {
      bloco.hidden = true;
    }
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') fecharModal();
  });

  // Boot
  pessoas = carregar();
  derivarSexo();
  viewport.style.cursor = 'grab';
  const foco = new URLSearchParams(window.location.search).get('focar');
  if (foco && pessoas.some((p) => p.id === foco)) {
    egoId = foco;
    modo = 'familia';
  }
  render();
  if (modo === 'familia' && mapa.get(egoId)) {
    selecionadoId = egoId;
    pintarSelecao();
    mostrarPerfil(mapa.get(egoId));
  }
  encaixar();
  if (modo === 'inteira') {
    const topo = document.querySelector('.t-no[data-id="yotaro-kato"], .t-no[data-id="toyo-kato"]');
    if (topo) {
      const rect = viewport.getBoundingClientRect();
      const L = parseFloat(topo.style.left);
      const T = parseFloat(topo.style.top);
      const cx = L + CARD_W + CASAL_GAP / 2;
      escala = Math.max(escala, Math.min(1, 0.78));
      tx = rect.width / 2 - cx * escala;
      ty = 22 - T * escala;
      aplicar();
    }
  }

  // ---------------------------------------------------------------
  // Dicas animadas: como ver, mexer e mudar a árvore
  // ---------------------------------------------------------------
  const dicaEl = document.getElementById('t-dicas');
  const dicaIcone = document.getElementById('t-dicas-icone');
  const dicaTexto = document.getElementById('t-dicas-texto');
  const DICAS = [
    { i: '⇢', t: 'Arraste o mapa para se mover pela árvore' },
    { i: '＋', t: 'Use + e − para aproximar e afastar (ou a roda do mouse)' },
    { i: '⌖', t: 'Para ver a árvore toda de uma vez, toque em “⌖ Tudo”' },
    { i: '✎', t: 'Passe o mouse num card e toque no ✎ para editar os dados' },
    { i: '♥', t: 'Com a edição ligada: ♥ adiciona cônjuge e ＋ pai/mãe, filho(a) ou irmão(ã)' },
    { i: '✋', t: 'Clique num card para abrir o perfil da pessoa' },
  ];
  let dicaK = 0;
  function dicaProxima() {
    const d = DICAS[dicaK % DICAS.length];
    dicaIcone.textContent = d.i;
    dicaTexto.textContent = d.t;
    dicaEl.classList.remove('t-dicas--ativa');
    void dicaEl.offsetWidth;
    dicaEl.classList.add('t-dicas--ativa');
    dicaK++;
  }
  setTimeout(dicaProxima, 800);
  setInterval(dicaProxima, 4600);
</script>

