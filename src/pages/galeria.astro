---
import Base from '../layouts/Base.astro';
import { albuns } from '../data/familia';
import { uploadPhoto, isCloudEnabled } from '../scripts/data';
---
<Base title="Galeria de Fotos" description="Álbuns de fotos da Família Kato por época.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Galeria de Fotos</span>
      <h1>Fotos da família, organizadas por época</h1>
      <p class="lead">
        Fotos enviadas pela família no grupo. Toque numa foto para ampliar.
      </p>

      <!-- Envio de fotos -->
      <section class="envio">
        <div class="envio__card">
          <h2>📷 Enviar uma foto nova</h2>
          <p class="envio__dica">
            Escolha uma imagem, informe para quem pertence e o álbum onde vai.
          </p>

          <form id="f-envio-foto" class="envio__form">
            <div class="envio__linha">
              <label class="envio__label">
                <span>Foto (imagem)</span>
                <input type="file" id="f-arquivo" accept="image/*" required />
              </label>
            </div>

            <div class="envio__linha">
              <label class="envio__label">
                <span>Para quem é esta foto?</span>
                <select id="f-familia" required>
                  <option value="">Selecione uma pessoa ou família…</option>
                  <optgroup label="Pessoas cadastradas">
                    {pessoasOpts()}
                  </optgroup>
                  <optgroup label="Álbuns existentes">
                    {albunsOpts()}
                  </optgroup>
                  <option value="__novo__">+ Adicionar nova pessoa/família</option>
                </select>
              </label>
            </div>

            <div id="novo-familia-campo" class="envio__linha" hidden>
              <label class="envio__label">
                <span>Nome da nova pessoa/família</span>
                <input type="text" id="f-novo-nome" placeholder="Ex.: Tia Maria" required />
              </label>
            </div>

            <div class="envio__linha">
              <label class="envio__label">
                <span>Legenda / descrição</span>
                <input type="text" id="f-legenda" placeholder="O que está na foto?" />
              </label>
            </div>

            <div class="envio__linha envio__botoes">
              <button type="submit" class="btn btn--destaque" id="b-enviar">
                Enviar foto
              </button>
              <button type="button" class="btn btn--ghost" id="b-cancelar">Cancelar</button>
            </div>
          </form>

          <p id="f-envio-feedback" class="envio__feedback"></p>

          <p class="envio__aviso">
            Precisa estar logado (Google/Clerk) para enviar. Se não estiver, o
            arquivo será salvo apenas neste dispositivo.
          </p>
        </div>
      </section>

      <!-- Álbuns existentes -->
      <section class="albuns">
        <div class="album">
          <div class="album__topo">
            <h2>Bastos ao longo dos anos</h2>
            <span class="pill">Vídeo · 28/09/2026</span>
          </div>
          <div class="album__video">
            <video controls preload="metadata" poster="/videos/vid-poster.jpg">
              <source src="/videos/VID-20260928-WA0000.mp4" type="video/mp4" />
              Seu navegador não suporta vídeos.
            </video>
          </div>
          <p class="album__legenda">
            Do passeio pela Festa do Ovo até as fotos antigas da família — reviva o
            reencontro com Bastos que a
            <a href="/pessoa/noriko-oyama">Noriko</a> conta em{" "}
            <a href="/historias#viagem-a-bastos">“A viagem a Bastos”</a>.
          </p>
        </div>

        {albuns.map((album) => (
          <section class="album">
            <div class="album__topo">
              <h2>{album.titulo}</h2>
              <span class="pill">
                {album.periodo} · {album.fotos.length} {album.fotos.length === 1 ? 'foto' : 'fotos'}
              </span>
            </div>
            <div class="album__grade">
              {album.fotos.map((foto) => (
                <a
                  class="album__item"
                  href={`/fotos/${foto}`}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${album.titulo} — foto em destaque`}
                >
                  <img src={`/fotos/${foto}`} alt={`${album.titulo}`} loading="lazy" />
                </a>
              ))}
            </div>
          </section>
        ))}
      </section>
    </div>
  </section>

  <div class="lightbox" id="lightbox" hidden>
    <button class="lightbox__fechar" type="button" aria-label="Fechar">×</button>
    <button class="lightbox__seta lightbox__seta--esq" type="button" aria-label="Foto anterior">‹</button>
    <figure class="lightbox__painel">
      <img src="" alt="" />
      <figcaption class="lightbox__legenda"></figcaption>
    </figure>
    <button class="lightbox__seta lightbox__seta--dir" type="button" aria-label="Próxima foto">›</button>
  </div>

  <script>
    import { pessoas } from '../data/familia';

    function pessoasOpts() {
      return pessoas
        .map((p) => `<option value="pessoa:${p.id}">${esc(p.nome)} (${anos(p)})</option>`)
        .join('');
    }

    function albunsOpts() {
      return albuns
        .map((a) => `<option value="album:${a.id}">${esc(a.titulo)} · ${a.periodo}</option>`)
        .join('');
    }

    function esc(s) {
      return String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    }

    function anos(p) {
      const partes = [];
      if (p.nascimento) partes.push(`n. ${p.nascimento}`);
      if (p.falecimento) partes.push(`f. ${p.falecimento}`);
      return partes.join(' · ') || '';
    }

    const form = document.getElementById('f-envio-foto');
    const selFamilia = document.getElementById('f-familia');
    const campoNovo = document.getElementById('novo-familia-campo');
    const inputNovo = document.getElementById('f-novo-nome');
    const fb = document.getElementById('f-envio-feedback');

    selFamilia.addEventListener('change', () => {
      campoNovo.hidden = selFamilia.value !== '__novo__';
      if (selFamilia.value === '__novo__') inputNovo.required = true;
      else inputNovo.required = false;
    });

    document.getElementById('b-cancelar').addEventListener('click', () => {
      form.reset();
      campoNovo.hidden = true;
      fb.textContent = '';
    });

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const arquivo = document.getElementById('f-arquivo').files?.[0];
      if (!arquivo) return;
      if (!arquivo.type.startsWith('image/')) {
        fb.textContent = 'Selecione uma imagem válida.';
        fb.className = 'envio__feedback envio__feedback--erro';
        return;
      }

      const btn = document.getElementById('b-enviar');
      btn.disabled = true;
      btn.textContent = 'Enviando…';

      const destino = selFamilia.value;
      const nomeNovo = inputNovo.value.trim();
      const legenda = document.getElementById('f-legenda').value.trim();

      let alvo = destino;
      if (destino === '__novo__' && nomeNovo) {
        alvo = `nova:${nomeNovo}`;
      }

      try {
        const cloud = window.__katoCloud;
        if (cloud && cloud.isCloudEnabled()) {
          const r = await cloud.uploadPhoto(arquivo);
          if (!r.ok) throw new Error(r.error || 'Falha no upload');
          fb.textContent = `Foto enviada com sucesso! URL: ${r.url}`;
          fb.className = 'envio__feedback envio__feedback--ok';
          form.reset();
          campoNovo.hidden = true;
        } else {
          fb.textContent = 'Nuvem não configurada. Foto não pôde ser enviada.';
          fb.className = 'envio__feedback envio__feedback--erro';
        }
      } catch (e) {
        fb.textContent = 'Erro ao enviar: ' + (e?.message || String(e));
        fb.className = 'envio__feedback envio__feedback--erro';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Enviar foto';
      }
    });
  </script>

  <style>
    .envio {
      margin: 2rem 0;
    }
    .envio__card {
      background: var(--montanha-claro);
      border: 1px solid var(--borda);
      border-radius: 10px;
      padding: 1.6rem;
      margin-bottom: 2.5rem;
    }
    .envio__card h2 {
      margin: 0 0 0.5rem;
      font-size: 1.25rem;
      color: var(--vinho);
    }
    .envio__dica {
      margin: 0 0 1.2rem;
      color: var(--texto-suave);
      font-size: 0.9rem;
    }
    .envio__form {
      display: grid;
      gap: 1rem;
      max-width: 640px;
    }
    .envio__linha {
      display: grid;
      gap: 0.4rem;
    }
    .envio__label {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }
    .envio__label span {
      font-size: 0.85rem;
      color: var(--texto-suave);
      font-weight: 600;
    }
    .envio__label input,
    .envio__label select {
      padding: 0.7rem 0.9rem;
      border-radius: 10px;
      border: 1.5px solid var(--borda);
      background: #fff;
      font-family: inherit;
      font-size: 0.95rem;
      width: 100%;
    }
    .envio__botoes {
      display: flex;
      gap: 0.8rem;
      margin-top: 0.4rem;
    }
    .envio__feedback {
      margin-top: 0.8rem;
      font-size: 0.88rem;
      padding: 0.7rem 1rem;
      border-radius: 10px;
      display: none;
    }
    .envio__feedback:not(:empty) {
      display: block;
    }
    .envio__feedback--ok {
      background: #e8f5e9;
      color: #2e7d32;
    }
    .envio__feedback--erro {
      background: #fdecea;
      color: #c62828;
    }
    .envio__aviso {
      margin-top: 1rem;
      font-size: 0.8rem;
      color: var(--texto-suave);
      font-style: italic;
    }
    .btn--destaque {
      background: var(--vinho, #8a3b3b);
      border-color: var(--vinho, #8a3b3b);
      color: #fff;
    }
    .btn--destaque:hover {
      filter: brightness(1.1);
    }
    .albuns {
      margin-top: 1rem;
    }
  </style>
</Base>
