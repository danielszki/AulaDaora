---
import Base from '../layouts/Base.astro';
import { albuns, pessoas } from '../data/familia';
import { uploadPhoto, isCloudEnabled } from '../scripts/data';

function esc(s: string): string {
  return String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

function anos(p: { nascimento?: string; falecimento?: string }): string {
  const partes: string[] = [];
  if (p.nascimento) partes.push(`n. ${p.nascimento}`);
  if (p.falecimento) partes.push(`f. ${p.falecimento}`);
  return partes.join(' · ') || '';
}

const opcoesHTML = `
<option value="">Selecione uma pessoa ou família…</option>
<optgroup label="Pessoas cadastradas">
${pessoas.map((p) => {
  const sufixo = anos(p);
  const nome = esc(p.nome);
  return `<option value="pessoa:${p.id}">${nome}${sufixo ? ' · ' + sufixo : ''}</option>`;
}).join('')}
</optgroup>
<optgroup label="Álbuns existentes">
${albuns.map((a) => {
  const titulo = esc(a.titulo);
  return `<option value="album:${a.id}">${titulo} · ${a.periodo}</option>`;
}).join('')}
</optgroup>
<option value="__novo__">+ Adicionar nova pessoa/família</option>
`;
---
<Base title="Galeria de Fotos" description="Álbuns de fotos da Família Kato por época.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Galeria de Fotos</span>
      <h1>Fotos da família, organizadas por época</h1>
      <p class="lead">
        Fotos enviadas pela família no grupo. Toque numa foto para ampliar.
      </p>

      <!-- Envio de fotos -->
      <section class="envio">
        <div class="envio__card">
          <h2>📷 Enviar uma foto nova</h2>
          <p class="envio__dica">
            Escolha uma imagem, informe para quem pertence e o álbum onde vai.
          </p>

          <form id="f-envio-foto" class="envio__form">
            <div class="envio__linha">
              <label class="envio__label">
                <span>Foto (imagem)</span>
                <input type="file" id="f-arquivo" accept="image/*" required />
              </label>
            </div>

            <div class="envio__linha">
              <label class="envio__label">
                <span>Para quem é esta foto?</span>
                <select id="f-familia" required set:html={opcoesHTML}></select>
              </label>
            </div>

            <div id="novo-familia-campo" class="envio__linha" hidden>
              <label class="envio__label">
                <span>Nome da nova pessoa/família</span>
                <input type="text" id="f-novo-nome" placeholder="Ex.: Tia Maria" required />
              </label>
            </div>

            <div class="envio__linha">
              <label class="envio__label">
                <span>Legenda / descrição</span>
                <input type="text" id="f-legenda" placeholder="O que está na foto?" />
              </label>
            </div>

            <div class="envio__linha envio__botoes">
              <button type="submit" class="btn btn--destaque" id="b-enviar">
                Enviar foto
              </button>
              <button type="button" class="btn btn--ghost" id="b-cancelar">Cancelar</button>
            </div>
          </form>

          <p id="f-envio-feedback" class="envio__feedback"></p>

          <p class="envio__aviso">
            Precisa estar logado (Google/Clerk) para enviar. Se não estiver, o
            arquivo será salvo apenas neste dispositivo.
          </p>
        </div>
      </section>

      <!-- Álbuns existentes -->
      <section class="albuns">
        <div class="album">
          <div class="album__topo">
            <h2>Bastos ao longo dos anos</h2>
            <span class="pill">Vídeo · 28/09/2026</span>
          </div>
          <div class="album__video">
            <video controls preload="metadata" poster="/videos/vid-poster.jpg">
              <source src="/videos/VID-20260928-WA0000.mp4" type="video/mp4" />
              Seu navegador não suporta vídeos.
            </video>
          </div>
          <p class="album__legenda">
            Do passeio pela Festa do Ovo até as fotos antigas da família — reviva o
            reencontro com Bastos que a
            <a href="/pessoa/noriko-oyama">Noriko</a> conta em{" "}
            <a href="/historias#viagem-a-bastos">“A viagem a Bastos”</a>.
          </p>
        </div>

        {albuns.map((album) => (
          <section class="album">
            <div class="album__topo">
              <h2>{album.titulo}</h2>
              <span class="pill">
                {album.periodo} · {album.fotos.length} {album.fotos.length === 1 ? 'foto' : 'fotos'}
              </span>
            </div>
            <div class="album__grade">
              {album.fotos.map((foto) => (
                <a
                  class="album__item"
                  href={`/fotos/${foto}`}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${album.titulo} — foto em destaque`}
                >
                  <img src={`/fotos/${foto}`} alt={`${album.titulo}`} loading="lazy" />
                </a>
              ))}
            </div>
          </section>
        ))}
      </section>
    </div>
  </section>

  <!-- Lightbox / carrossel de fotos (mesmo comportamento da página inicial) -->
  <div
    id="album-lightbox"
    class="lightbox"
    hidden
    aria-hidden="true"
    role="dialog"
    aria-modal="true"
    aria-label="Foto ampliada da galeria"
  >
    <div class="lightbox__backdrop" data-close></div>
    <div class="lightbox__panel">
      <button type="button" class="lightbox__fechar" data-close aria-label="Fechar (tecla Esc)">×</button>
      <div class="lightbox__stage">
        <button type="button" class="lightbox__nav lightbox__nav--prev" data-prev aria-label="Foto anterior (seta para a esquerda)">‹</button>
        <img id="galeria-lb-img" class="lightbox__img" src="" alt="" />
        <button type="button" class="lightbox__nav lightbox__nav--next" data-next aria-label="Próxima foto (seta para a direita)">›</button>
      </div>
      <div class="lightbox__meta">
        <span id="galeria-lb-contador" class="lightbox__contador">1 / 1</span>
        <span id="galeria-lb-legenda" class="lightbox__legenda"></span>
      </div>
      <div class="lightbox__thumbs" id="galeria-lb-thumbs" role="tablist" aria-label="Miniaturas do álbum"></div>
    </div>
  </div>

  <script>
    /* ---------- Envio de fotos ---------- */
    const form = document.getElementById('f-envio-foto');
    const selFamilia = document.getElementById('f-familia');
    const campoNovo = document.getElementById('novo-familia-campo');
    const inputNovo = document.getElementById('f-novo-nome');
    const fb = document.getElementById('f-envio-feedback');

    selFamilia.addEventListener('change', () => {
      campoNovo.hidden = selFamilia.value !== '__novo__';
      if (selFamilia.value === '__novo__') inputNovo.required = true;
      else inputNovo.required = false;
    });

    document.getElementById('b-cancelar').addEventListener('click', () => {
      form.reset();
      campoNovo.hidden = true;
      fb.textContent = '';
    });

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      const arquivo = document.getElementById('f-arquivo').files?.[0];
      if (!arquivo) return;
      if (!arquivo.type.startsWith('image/')) {
        fb.textContent = 'Selecione uma imagem válida.';
        fb.className = 'envio__feedback envio__feedback--erro';
        return;
      }

      const btn = document.getElementById('b-enviar');
      btn.disabled = true;
      btn.textContent = 'Enviando…';

      const destino = selFamilia.value;
      const nomeNovo = inputNovo.value.trim();
      const legenda = document.getElementById('f-legenda').value.trim();

      let alvo = destino;
      if (destino === '__novo__' && nomeNovo) {
        alvo = `nova:${nomeNovo}`;
      }

      try {
        const cloud = window.__katoCloud;
        if (cloud && cloud.isCloudEnabled()) {
          const r = await cloud.uploadPhoto(arquivo);
          if (!r.ok) throw new Error(r.error || 'Falha no upload');
          fb.textContent = `Foto enviada com sucesso! URL: ${r.url}`;
          fb.className = 'envio__feedback envio__feedback--ok';
          form.reset();
          campoNovo.hidden = true;
        } else {
          fb.textContent = 'Nuvem não configurada. Foto não pôde ser enviada.';
          fb.className = 'envio__feedback envio__feedback--erro';
        }
      } catch (e) {
        fb.textContent = 'Erro ao enviar: ' + (e?.message || String(e));
        fb.className = 'envio__feedback envio__feedback--erro';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Enviar foto';
      }
    });

    /* ---------- Lightbox / carrossel de fotos (igual ao index) ---------- */
    const lb = document.getElementById('album-lightbox');
    const lbImg = document.getElementById('galeria-lb-img');
    const lbCont = document.getElementById('galeria-lb-contador');
    const lbLeg = document.getElementById('galeria-lb-legenda');
    const lbThumbs = document.getElementById('galeria-lb-thumbs');
    const grades = Array.from(document.querySelectorAll('.album__grade'));
    const grupos = grades.map((g) => Array.from(g.querySelectorAll('.album__item')));

    let grupoAtual = 0;
    let idx = 0;
    let ultimoTrigger = null;

    function mostrar(i) {
      const g = grupos[grupoAtual];
      if (!g || !g.length) return;
      idx = ((i % g.length) + g.length) % g.length;
      const item = g[idx];
      const img = item.querySelector('img');
      lbImg.src = item.href || (img ? img.src : '');
      lbImg.alt = img ? img.alt : '';
      lbCont.textContent = `${idx + 1} / ${g.length}`;
      lbLeg.textContent = item.getAttribute('aria-label') || (img ? img.alt : '');
      if (lbThumbs) {
        lbThumbs.querySelectorAll('.lightbox__thumb').forEach((t, j) => {
          t.classList.toggle('is-active', j === idx);
          t.setAttribute('aria-selected', j === idx ? 'true' : 'false');
        });
        const ativo = lbThumbs.querySelector('.lightbox__thumb.is-active');
        if (ativo) ativo.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
      }
    }

    function montarThumbs() {
      if (!lbThumbs) return;
      lbThumbs.innerHTML = '';
      grupos[grupoAtual].forEach((item, j) => {
        const img = item.querySelector('img');
        const t = document.createElement('button');
        t.type = 'button';
        t.className = 'lightbox__thumb';
        t.setAttribute('aria-label', `Ir para a foto ${j + 1}`);
        t.setAttribute('aria-selected', 'false');
        t.innerHTML = `<img src="${img ? img.src : ''}" alt="" loading="lazy" decoding="async" />`;
        t.addEventListener('click', () => mostrar(j));
        lbThumbs.appendChild(t);
      });
    }

    function abrir(grupo, i, trigger) {
      grupoAtual = grupo;
      ultimoTrigger = trigger || null;
      montarThumbs();
      mostrar(i);
      lb.hidden = false;
      lb.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      const fechar = lb.querySelector('.lightbox__fechar');
      if (fechar) fechar.focus();
    }

    function fechar() {
      lb.hidden = true;
      lb.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      lbImg.removeAttribute('src');
      if (ultimoTrigger && typeof ultimoTrigger.focus === 'function') ultimoTrigger.focus();
    }

    function anterior() { mostrar(idx - 1); }
    function proxima() { mostrar(idx + 1); }

    grupos.forEach((g, gi) => {
      g.forEach((item, fi) => {
        item.addEventListener('click', (e) => {
          e.preventDefault();
          abrir(gi, fi, item);
        });
      });
    });

    lb.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', fechar));
    const btnPrev = lb.querySelector('[data-prev]');
    const btnNext = lb.querySelector('[data-next]');
    if (btnPrev) btnPrev.addEventListener('click', anterior);
    if (btnNext) btnNext.addEventListener('click', proxima);

    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') fechar();
      if (e.key === 'ArrowLeft') anterior();
      if (e.key === 'ArrowRight') proxima();
    });
  </script>

  <style>
    .envio {
      margin: 2rem 0;
    }
    .envio__card {
      background: var(--montanha-claro);
      border: 1px solid var(--borda);
      border-radius: 10px;
      padding: 1.6rem;
      margin-bottom: 2.5rem;
    }
    .envio__card h2 {
      margin: 0 0 0.5rem;
      font-size: 1.25rem;
      color: var(--vinho);
    }
    .envio__dica {
      margin: 0 0 1.2rem;
      color: var(--texto-suave);
      font-size: 0.9rem;
    }
    .envio__form {
      display: grid;
      gap: 1rem;
      max-width: 640px;
    }
    .envio__linha {
      display: grid;
      gap: 0.4rem;
    }
    .envio__label {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
    }
    .envio__label span {
      font-size: 0.85rem;
      color: var(--texto-suave);
      font-weight: 600;
    }
    .envio__label input,
    .envio__label select {
      padding: 0.7rem 0.9rem;
      border-radius: 10px;
      border: 1.5px solid var(--borda);
      background: #fff;
      font-family: inherit;
      font-size: 0.95rem;
      width: 100%;
    }
    .envio__botoes {
      display: flex;
      gap: 0.8rem;
      margin-top: 0.4rem;
    }
    .envio__feedback {
      margin-top: 0.8rem;
      font-size: 0.88rem;
      padding: 0.7rem 1rem;
      border-radius: 10px;
      display: none;
    }
    .envio__feedback:not(:empty) {
      display: block;
    }
    .envio__feedback--ok {
      background: #e8f5e9;
      color: #2e7d32;
    }
    .envio__feedback--erro {
      background: #fdecea;
      color: #c62828;
    }
    .envio__aviso {
      margin-top: 1rem;
      font-size: 0.8rem;
      color: var(--texto-suave);
      font-style: italic;
    }
    .btn--destaque {
      background: var(--vinho, #8a3b3b);
      border-color: var(--vinho, #8a3b3b);
      color: #fff;
    }
    .btn--destaque:hover {
      filter: brightness(1.1);
    }
    .albuns {
      margin-top: 1rem;
    }

    /* Álbuns de fotos */
    .album__grade {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
      gap: 0.7rem;
    }

    .album__item {
      display: block;
      aspect-ratio: 1;
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--montanha);
      background: var(--montanha-claro);
    }

    .album__item img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      background: var(--montanha-claro);
      transition: transform 0.25s;
    }

    .album__item:hover img {
      transform: scale(1.04);
    }

    .album__topo {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.8rem;
      margin-bottom: 1rem;
    }

    .album__topo h2 {
      font-size: 1.15rem;
      margin: 0;
      color: var(--vinho);
    }

    .album__legenda {
      max-width: 640px;
      font-size: 0.9rem;
      color: var(--texto-suave);
      margin: 0.6rem 0 0;
    }

    .album__legenda a {
      color: var(--vinho);
      font-weight: 600;
    }

    .album__video {
      max-width: 640px;
      border-radius: 12px;
      overflow: hidden;
      border: 1px solid var(--montanha);
      background: #000;
      box-shadow: var(--shadow);
    }

    .album__video video {
      width: 100%;
      display: block;
    }

    /* ---- Lightbox / carrossel de fotos (igual ao index) ---- */
    .lightbox {
      position: fixed;
      inset: 0;
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .lightbox[hidden] { display: none; }

    .lightbox__backdrop {
      position: absolute;
      inset: 0;
      background: rgba(20, 24, 22, 0.82);
      backdrop-filter: blur(4px);
    }

    .lightbox__panel {
      position: relative;
      z-index: 1;
      width: min(96vw, 1100px);
      max-height: 96vh;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      padding: 1rem 1rem 1.2rem;
      background: var(--papel);
      border-radius: 16px;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45);
    }

    .lightbox__fechar {
      position: absolute;
      top: 0.5rem;
      right: 0.6rem;
      z-index: 2;
      width: 44px;
      height: 44px;
      border: 0;
      border-radius: 999px;
      background: var(--creme);
      color: var(--carvao);
      font-size: 1.6rem;
      line-height: 1;
      cursor: pointer;
      box-shadow: var(--shadow);
    }

    .lightbox__stage {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 50vh;
      background: var(--creme);
      border-radius: 12px;
      overflow: hidden;
    }

    .lightbox__img {
      max-width: 100%;
      max-height: 78vh;
      object-fit: contain;
      border-radius: 8px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18);
    }

    .lightbox__nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      width: 48px;
      height: 48px;
      border: 0;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.9);
      color: var(--carvao);
      font-size: 2rem;
      line-height: 1;
      cursor: pointer;
      box-shadow: var(--shadow);
      z-index: 2;
    }
    .lightbox__nav--prev { left: 0.6rem; }
    .lightbox__nav--next { right: 0.6rem; }

    .lightbox__meta {
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      padding: 0 0.4rem;
    }
    .lightbox__contador {
      font-weight: 700;
      color: var(--verde);
      min-width: 4.5rem;
    }
    .lightbox__legenda {
      flex: 1;
      color: var(--texto-suave);
      font-size: 0.95rem;
    }

    .lightbox__thumbs {
      display: flex;
      gap: 0.5rem;
      overflow-x: auto;
      padding: 0.4rem 0.2rem 0.2rem;
      scroll-snap-type: x mandatory;
    }
    .lightbox__thumb {
      flex: 0 0 auto;
      width: 64px;
      height: 48px;
      padding: 0;
      border: 2px solid transparent;
      border-radius: 6px;
      overflow: hidden;
      cursor: pointer;
      scroll-snap-align: center;
      background: var(--creme);
    }
    .lightbox__thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      pointer-events: none;
    }
    .lightbox__thumb.is-active,
    .lightbox__thumb[aria-selected='true'] {
      border-color: var(--verde);
    }

    @media (max-width: 860px) {
      .lightbox__panel { padding: 0.7rem; }
      .lightbox__img { max-height: 60vh; }
      .lightbox__nav { width: 42px; height: 42px; font-size: 1.6rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      .lightbox__img, .lightbox__backdrop { transition: none; }
    }
  </style>
</Base>
