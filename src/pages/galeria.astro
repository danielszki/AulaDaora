---
import Base from '../layouts/Base.astro';
import { albuns } from '../data/familia';
---

<Base title="Galeria de Fotos" description="Álbuns de fotos da Família Kato por época.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Galeria de Fotos</span>
      <h1>Fotos da família, organizadas por época</h1>
      <p class="lead">
        Fotos enviadas pela família no grupo. Toque numa foto para ampliar.
      </p>

      <section class="album">
        <div class="album__topo">
          <h2>Bastos ao longo dos anos</h2>
          <span class="pill">Vídeo · 28/09/2026</span>
        </div>
        <div class="album__video">
          <video controls preload="metadata" poster="/videos/vid-poster.jpg">
            <source src="/videos/VID-20260928-WA0000.mp4" type="video/mp4" />
            Seu navegador não suporta vídeos.
          </video>
        </div>
        <p class="album__legenda">
          Do passeio pela Festa do Ovo até as fotos antigas da família — reviva o
          reencontro com Bastos que a <a href="/pessoa/noriko-oyama">Noriko</a> conta em
          <a href="/historias#viagem-a-bastos">“A viagem a Bastos”</a>.
        </p>
      </section>

      {
        albuns.map((album) => (
          <section class="album">
            <div class="album__topo">
              <h2>{album.titulo}</h2>
              <span class="pill">
                {album.periodo} · {album.fotos.length} {album.fotos.length === 1 ? 'foto' : 'fotos'}
              </span>
            </div>
            <div class="album__grade">
              {album.fotos.map((foto) => (
                <a
                  class="album__item"
                  href={`/fotos/${foto}`}
                  target="_blank"
                  rel="noopener"
                  aria-label={`${album.titulo} — foto em destaque`}
                >
                  <img
                    src={`/fotos/mini/${foto.replace(/\.(jpe?g|png)$/i, '.webp')}`}
                    data-full-src={`/fotos/${foto}`}
                    alt={`${album.titulo}`}
                    loading="lazy"
                    decoding="async"
                    fetchpriority="low"
                    width="480"
                    height="480"
                  />
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>

  <div class="lightbox" id="lightbox" hidden>
    <button class="lightbox__fechar" type="button" aria-label="Fechar">×</button>
    <button class="lightbox__seta lightbox__seta--esq" type="button" aria-label="Foto anterior">‹</button>
    <figure class="lightbox__painel">
      <img src="" alt="" />
      <figcaption class="lightbox__legenda"></figcaption>
    </figure>
    <button class="lightbox__seta lightbox__seta--dir" type="button" aria-label="Próxima foto">›</button>
  </div>
</Base>

<script>
  const albunsEl = Array.from(document.querySelectorAll<HTMLElement>('.album__grade'));
  const grupos = albunsEl.map((g) => Array.from(g.querySelectorAll<HTMLAnchorElement>('.album__item')));
  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const imagem = lightbox.querySelector('img') as HTMLImageElement;
  const legenda = lightbox.querySelector('.lightbox__legenda') as HTMLElement;
  const [fechar, esq, dir] = [
    lightbox.querySelector('.lightbox__fechar'),
    lightbox.querySelector('.lightbox__seta--esq'),
    lightbox.querySelector('.lightbox__seta--dir'),
  ] as HTMLButtonElement[];

  let grupoAtual = -1;
  let fotoAtual = -1;

  function abrir(grupo: number, foto: number) {
    grupoAtual = grupo;
    fotoAtual = foto;
    imagem.src = grupos[grupo][foto].dataset.fullSrc || grupos[grupo][foto].href;
    imagem.alt = grupos[grupo][foto].querySelector('img')?.alt ?? '';
    legenda.textContent = `${grupos[grupo][foto].querySelector('img')?.alt ?? ''} · ${foto + 1}/${grupos[grupo].length}`;
    lightbox.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function navegar(delta: number) {
    const total = grupos[grupoAtual].length;
    const proxima = (fotoAtual + delta + total) % total;
    abrir(grupoAtual, proxima);
  }

  function fecharLightbox() {
    lightbox.hidden = true;
    document.body.style.overflow = '';
    imagem.removeAttribute('src');
  }

  grupos.forEach((grupoEls, gi) => {
    grupoEls.forEach((item, fi) => {
      item.addEventListener('click', (e) => {
        e.preventDefault();
        abrir(gi, fi);
      });
    });
  });

  fechar.addEventListener('click', fecharLightbox);
  esq.addEventListener('click', () => navegar(-1));
  dir.addEventListener('click', () => navegar(1));
  lightbox.addEventListener('click', (e) => {
    if (e.target === lightbox) fecharLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (lightbox.hidden) return;
    if (e.key === 'Escape') fecharLightbox();
    if (e.key === 'ArrowLeft') navegar(-1);
    if (e.key === 'ArrowRight') navegar(1);
  });
</script>

<style>
  .album {
    margin-top: 2.5rem;
  }

  .album__topo {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }

  .album__topo h2 {
    font-size: 1.15rem;
    margin: 0;
    color: var(--vinho);
  }

  .album__grade {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.7rem;
  }

  .album__item {
    display: block;
    aspect-ratio: 1;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--montanha);
    background: var(--montanha-claro);
  }

  .album__item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--montanha-claro);
    transition: transform 0.35s ease, filter 0.35s ease;
    filter: saturate(.92);
  }

  .album__item:hover img {
    transform: scale(1.06);
    filter: saturate(1.08);
  }

  .album__video {
    max-width: 640px;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--montanha);
    background: #000;
    box-shadow: var(--shadow);
  }

  .album__video video {
    width: 100%;
    display: block;
  }

  .album__legenda {
    max-width: 640px;
    font-size: 0.9rem;
    color: var(--texto-suave);
    margin: 0.6rem 0 0;
  }

  .album__legenda a {
    color: var(--vinho);
    font-weight: 600;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 120;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: rgba(38, 30, 32, 0.92);
    padding: 1.2rem;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox__painel {
    margin: 0;
    max-width: min(92vw, 1100px);
    max-height: 90vh;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    text-align: center;
  }

  .lightbox__painel img {
    max-width: 100%;
    max-height: 82vh;
    border-radius: 8px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.45);
  }

  .lightbox__legenda {
    color: #e9e4e2;
    font-size: 0.85rem;
  }

  .lightbox__fechar {
    position: absolute;
    top: 1rem;
    right: 1.2rem;
    background: none;
    border: none;
    color: #fff;
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    padding: 0.4rem;
  }

  .lightbox__seta {
    background: rgba(255, 255, 255, 0.12);
    border: none;
    color: #fff;
    font-size: 2.2rem;
    line-height: 1;
    border-radius: 999px;
    width: 48px;
    height: 48px;
    cursor: pointer;
    flex: 0 0 auto;
  }

  .lightbox__seta:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .album__item { position: relative; box-shadow: 0 5px 18px rgba(43,36,29,.08); }
  .album__item img { display: block; background: linear-gradient(135deg,#eee9df,#dce4d9); }
  .album__grade { gap: .9rem; }
  @media (max-width:560px) { .album__grade { grid-template-columns: repeat(2,minmax(0,1fr)); gap: .55rem; } .album__item { border-radius: 12px; } }
</style>