---
import Base from '../layouts/Base.astro';
import PersonCard from '../components/PersonCard.astro';
import TimelineEvent from '../components/TimelineEvent.astro';
import HeroArt from '../components/HeroArt.astro';
import { pessoas, eventos, historias, albuns, filhosDe, geracaoLabel, anosDe } from '../data/familia';

const ultimas = historias.slice(0, 3);
const previewEventos = eventos.slice(0, 4);
const geracoesTotais = new Set(pessoas.map((p) => p.geracao)).size;

// Destaques fixos: fundadores, filha viva mais velha, fundador do grupo
const destaques = ['yotaro-kato', 'toyo-kato', 'kiyoe-kadita', 'carlos-akira-kato']
  .map((id) => pessoas.find((p) => p.id === id))
  .filter((p) => p !== undefined);

// "Conheça alguém": candidatos com algo para mostrar (foto, bio ou profissão)
const candidatos = pessoas
  .filter((p) => p.foto || p.bio || p.profissao)
  .map((p) => ({
    id: p.id,
    nome: p.nome,
    foto: p.foto || '',
    anos: anosDe(p),
    geracao: geracaoLabel(p.geracao),
  }));

// Uma geração por botão, com representante real (pessoa da geração com mais filhos)
const stripsGeracoes = [...new Set(pessoas.map((p) => p.geracao))]
  .sort((a, b) => a - b)
  .map((g) => {
    const da = pessoas.filter((p) => p.geracao === g);
    let rep = da[0];
    let max = -1;
    for (const p of da) {
      const n = filhosDe(p.id).length;
      if (n > max) {
        max = n;
        rep = p;
      }
    }
    return { label: geracaoLabel(g), total: da.length, href: `/arvore?focar=${rep.id}` };
  });

// Álbum: 8 fotos reais espalhadas pelos álbuns
const fotosAlbum: { src: string; alt: string }[] = [];
for (const album of albuns) {
  for (const f of album.fotos) {
    if (fotosAlbum.length >= 8) break;
    const src = `/fotos/${f}`;
    if (!fotosAlbum.some((x) => x.src === src)) fotosAlbum.push({ src, alt: `Foto do álbum ${album.titulo}` });
  }
}

const fotoHero = '/fotos/IMG-20260927-WA0014.jpg';
---

<Base
  title="Início"
  description="Bem-vindo à casa da família Kato: a nossa árvore, a nossa linha do tempo e as histórias que a gente conta."
>
  <section class="hero seigaiha">
    <div class="hero__art"><HeroArt /></div>
    <div class="container">
      <div class="hero__flex">
        <div class="hero__inner">
          <span class="eyebrow">Família Kato <span class="jp" lang="ja" aria-hidden="true">加藤</span></span>
          <h1>Vem cá, deixa eu te mostrar de onde a gente veio.</h1>
          <p class="lead">
            Nossa família tem origem japonesa e a história dela tomou forma no
            Brasil. Tudo começou com Yotaro e Toyo Kato — hoje somos{' '}
            {pessoas.length} pessoas registradas ao longo de {geracoesTotais}{' '}
            gerações, com nomes, datas, fotos e as histórias que a gente foi
            juntando.
          </p>
          <ul class="hero__stats" aria-label="Números do arquivo familiar">
            <li class="pill pill--familia">{pessoas.length} pessoas</li>
            <li class="pill pill--familia">{geracoesTotais} gerações</li>
            <li class="pill">{eventos.length} marcos no tempo</li>
            <li class="pill">{historias.length} histórias</li>
          </ul>
          <div class="hero__actions">
            <a class="btn" href="/arvore">Explorar a árvore</a>
            <a class="btn btn--ghost" href="/historias">Conhecer nossas histórias</a>
          </div>
        </div>
        <figure class="hero__foto">
          <img src={fotoHero} alt="Reunião da família no 92º aniversário de Kiyoe, em setembro de 2026" loading="eager" decoding="async" />
          <figcaption>Tia Kiyoe comemorando 92 anos, com a família reunida.</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="conheca">
    <div class="container">
      <span class="eyebrow">Comece por aqui</span>
      <h2 id="conheca">Conheça alguém da nossa família</h2>
      <p class="lead">Toque em qualquer nome para abrir a página da pessoa, com datas, foto e quem é parente de quem.</p>
      <div class="grid grid--3" style="margin-top: 1.6rem" id="painel-destaques">
        {destaques.map((pessoa) => <PersonCard pessoa={pessoa} />)}
      </div>
      <div class="sortear" style="margin-top: 1.6rem">
        <button class="btn btn--ghost" id="btn-sortear" type="button">Sortear alguém da família</button>
        <p class="sortear__alvo" id="sortear-alvo" aria-live="polite"></p>
      </div>
      <p><a class="btn" href="/arvore">Ver a árvore completa</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="geracoes">
    <div class="container">
      <span class="eyebrow">Por geração</span>
      <h2 id="geracoes">Explore a família geração a geração</h2>
      <p class="lead">Cada faixa abre a árvore já parando em alguém desse grupo — sem precisar navegar a árvore inteira do começo.</p>
      <ul class="faixa-geracoes" style="margin-top: 1.6rem">
        {
          stripsGeracoes.map((fg) => (
            <li>
              <a class="gen" href={fg.href}>
                <strong>{fg.label}</strong>
                <span>{fg.total} pessoa{fg.total === 1 ? '' : 's'}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="memorias">
    <div class="container">
      <span class="eyebrow">Memórias em destaque</span>
      <h2 id="memorias">O que a família conta</h2>
      <div class="grid grid--3" style="margin-top: 1.6rem">
        {
          ultimas.map((h) => (
            <article class="card historia-card">
              <h3><a href={`/historias#${h.id}`}>{h.titulo}</a></h3>
              <p class="historia-card__trecho">{h.texto.slice(0, 160).trim()}…</p>
              <p class="historia-card__meta">{h.autor} · {h.publicado}</p>
              <p><a href={`/historias#${h.id}`}>Ler história completa →</a></p>
            </article>
          ))
        }
      </div>
      <p style="margin-top: 1.4rem"><a href="/historias">Todas as histórias →</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="tempo">
    <div class="container">
      <span class="eyebrow">Nossa história no tempo</span>
      <h2 id="tempo">Os marcos da nossa história</h2>
      <div style="margin-top: 1.6rem; max-width: 760px">
        {previewEventos.map((evento) => <TimelineEvent evento={evento} compacto />)}
      </div>
      <a class="btn btn--ghost" href="/linha-do-tempo">Ver a linha do tempo inteira</a>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="album">
    <div class="container">
      <span class="eyebrow">Álbum familiar</span>
      <h2 id="album">Fotos que já fazem parte do acervo</h2>
      <ul class="album-strip" style="margin-top: 1.6rem">
        {
          fotosAlbum.map((f, i) => (
            <li>
              <button
                type="button"
                class="album-strip__btn"
                data-index={i}
                aria-label={`Ampliar foto ${i + 1} de ${fotosAlbum.length}: ${f.alt}`}
              >
                <img src={f.src} alt={f.alt} loading="lazy" decoding="async" />
              </button>
            </li>
          ))
        }
      </ul>
      <p style="margin-top: 1.4rem"><a class="btn" href="/galeria">Abrir o álbum completo</a></p>
    </div>
  </section>

  <section class="section" aria-labelledby="participe">
    <div class="container">
      <span class="eyebrow">Participe</span>
      <h2 id="participe">Essa história é de todo mundo</h2>
      <p class="lead">Achou um erro, tem uma foto esquecida numa gaveta ou lembra de uma história? Toda contribuição é bem-vinda.</p>
      <div class="grid grid--3" style="margin-top: 1.6rem">
        <div class="card">
          <h3>Corrigir informações</h3>
          <p>Nome errado, data errada, vínculo faltando? Fale com a família ou corrija na área de edição.</p>
          <p><a class="btn btn--ghost" href="/sobre">Falar conosco</a></p>
        </div>
        <div class="card">
          <h3>Enviar fotos e lembranças</h3>
          <p>Fotos antigas, relatos de memória, gravações — manda pelo grupo da família ou escreve no sobre.</p>
          <p><a class="btn btn--ghost" href="/historias">Ler o que já foi contado</a></p>
        </div>
        <div class="card">
          <h3>Cadastrar um familiar</h3>
          <p>Quem está faltando na árvore pode ser cadastrado direto na área da família, sem mexer em código.</p>
          <p><a class="btn" href="/admin">Abrir a área da família</a></p>
        </div>
      </div>
    </div>
  </section>
<!-- Lightbox / carrossel do álbum familiar -->
<div
  id="album-lightbox"
  class="lightbox"
  hidden
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-labelledby="lb-titulo"
>
  <div class="lightbox__backdrop" data-close></div>
  <div class="lightbox__panel">
    <h2 id="lb-titulo" class="sr-only">Foto ampliada do álbum familiar</h2>
    <button type="button" class="lightbox__fechar" data-close aria-label="Fechar (tecla Esc)">×</button>
    <div class="lightbox__stage">
      <button type="button" class="lightbox__nav lightbox__nav--prev" data-prev aria-label="Foto anterior (seta para a esquerda)">‹</button>
      <img id="lb-img" class="lightbox__img" src="" alt="" />
      <button type="button" class="lightbox__nav lightbox__nav--next" data-next aria-label="Próxima foto (seta para a direita)">›</button>
    </div>
    <div class="lightbox__meta">
      <span id="lb-contador" class="lightbox__contador">1 / 1</span>
      <span id="lb-legenda" class="lightbox__legenda"></span>
      <button type="button" class="lightbox__play" data-play aria-pressed="false" aria-label="Iniciar carrossel automático">▶ Reproduzir</button>
    </div>
    <div class="lightbox__thumbs" id="lb-thumbs" role="tablist" aria-label="Miniaturas do álbum">
      {
        fotosAlbum.map((f, i) => (
          <button
            type="button"
            class="lightbox__thumb"
            data-thumb={i}
            aria-label={`Ir para a foto ${i + 1}`}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            <img src={f.src} alt="" loading="lazy" decoding="async" />
          </button>
        ))
      }
    </div>
  </div>
</div>
<script type="application/json" id="album-data" set:html={JSON.stringify(fotosAlbum)}></script>

</Base>

<script define:vars={{ candidatos }}>
  const btn = document.getElementById('btn-sortear');
  const alvo = document.getElementById('sortear-alvo');
  const esc = (s) => String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  if (btn) {
    btn.addEventListener('click', () => {
      const p = candidatos[Math.floor(Math.random() * candidatos.length)];
      if (!p) return;
      const inicial = p.nome.split(' ').map((n) => n[0]).slice(0, 2).join('');
      alvo.innerHTML = `
        <a class="sortear__card" href="/pessoa/${esc(p.id)}">
          ${p.foto ? `<img src="${esc(p.foto)}" alt="" loading="lazy" />` : `<span class="sortear__iniciais">${esc(inicial)}</span>`}
          <strong>${esc(p.nome)}</strong>
          <span>${esc(p.anos || 'Datas a confirmar')} · ${esc(p.geracao)}</span>
        </a>`;
      alvo.hidden = false;
    });
  }
</script>

<script>
  // Lightbox / carrossel do álbum familiar
  const lb = document.getElementById('album-lightbox');
  const lbImg = document.getElementById('lb-img');
  const lbCont = document.getElementById('lb-contador');
  const lbLeg = document.getElementById('lb-legenda');
  const lbThumbs = document.getElementById('lb-thumbs');
  const dataEl = document.getElementById('album-data');
  const fotos = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
  const reduzido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let idx = 0;
  let timer = null;
  let lastTrigger = null;

  function mostrar(i) {
    if (!fotos.length) return;
    idx = ((i % fotos.length) + fotos.length) % fotos.length;
    const f = fotos[idx];
    lbImg.src = f.src;
    lbImg.alt = f.alt || '';
    lbCont.textContent = `${idx + 1} / ${fotos.length}`;
    lbLeg.textContent = f.alt || '';
    if (lbThumbs) {
      lbThumbs.querySelectorAll('.lightbox__thumb').forEach((t, j) => {
        t.setAttribute('aria-selected', j === idx ? 'true' : 'false');
        t.classList.toggle('is-active', j === idx);
      });
      const ativo = lbThumbs.querySelector('.lightbox__thumb.is-active');
      if (ativo) ativo.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
    }
  }

  function abrir(i, trigger) {
    if (!lb) return;
    lastTrigger = trigger || null;
    mostrar(i);
    lb.hidden = false;
    lb.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    const fechar = lb.querySelector('[data-close]');
    if (fechar) fechar.focus();
  }

  function fechar() {
    if (!lb) return;
    parar();
    lb.hidden = true;
    lb.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    if (lastTrigger && typeof lastTrigger.focus === 'function') lastTrigger.focus();
  }

  function anterior() { mostrar(idx - 1); }
  function proxima() { mostrar(idx + 1); }

  function iniciar() {
    if (timer || reduzido) return;
    const btn = lb.querySelector('[data-play]');
    timer = setInterval(() => proxima(), 4000);
    if (btn) { btn.textContent = '⏸ Pausar'; btn.setAttribute('aria-pressed', 'true'); btn.setAttribute('aria-label', 'Pausar carrossel automático'); }
  }
  function parar() {
    if (timer) { clearInterval(timer); timer = null; }
    const btn = lb ? lb.querySelector('[data-play]') : null;
    if (btn) { btn.textContent = '▶ Reproduzir'; btn.setAttribute('aria-pressed', 'false'); btn.setAttribute('aria-label', 'Iniciar carrossel automático'); }
  }
  function togglePlay() {
    if (timer) parar(); else iniciar();
  }

  // abrir ao clicar nas miniaturas do álbum
  document.querySelectorAll('.album-strip__btn').forEach((btn) => {
    btn.addEventListener('click', () => abrir(Number(btn.dataset.index) || 0, btn));
  });

  // controles do lightbox
  if (lb) {
    lb.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', fechar));
    const prev = lb.querySelector('[data-prev]');
    const next = lb.querySelector('[data-next]');
    if (prev) prev.addEventListener('click', anterior);
    if (next) next.addEventListener('click', proxima);
    const play = lb.querySelector('[data-play]');
    if (play) play.addEventListener('click', togglePlay);
    lb.querySelectorAll('[data-thumb]').forEach((t) => {
      t.addEventListener('click', () => mostrar(Number(t.dataset.thumb) || 0));
    });

    // teclado
    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') { e.preventDefault(); fechar(); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); anterior(); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); proxima(); }
    });

    // foco preso no modal
    lb.addEventListener('keydown', (e) => {
      if (e.key !== 'Tab') return;
      const focaveis = lb.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
      if (!focaveis.length) return;
      const primeiro = focaveis[0];
      const ultimo = focaveis[focaveis.length - 1];
      if (e.shiftKey && document.activeElement === primeiro) { e.preventDefault(); ultimo.focus(); }
      else if (!e.shiftKey && document.activeElement === ultimo) { e.preventDefault(); primeiro.focus(); }
    });

    // swipe em touch
    let startX = 0;
    const stage = lb.querySelector('.lightbox__stage');
    if (stage) {
      stage.addEventListener('touchstart', (e) => { startX = e.changedTouches[0].clientX; }, { passive: true });
      stage.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        if (Math.abs(dx) > 40) { if (dx > 0) anterior(); else proxima(); }
      }, { passive: true });
    }
  }
</script>

<style>
  .hero__flex {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(240px, 0.9fr);
    gap: 2.5rem;
    align-items: center;
  }

  .hero__stats {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.2rem 0 0;
    padding: 0;
  }

  .hero__foto {
    margin: 0;
    background: var(--papel);
    border: 1px solid var(--borda);
    box-shadow: 0 14px 34px rgba(41, 50, 45, 0.14);
    border-radius: 12px;
    padding: 0.8rem 0.8rem 1rem;
    transform: rotate(2.5deg);
  }

  .hero__foto img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 8px;
  }

  .hero__foto figcaption {
    font-size: 0.82rem;
    color: var(--texto-suave);
    padding-top: 0.6rem;
    text-align: center;
    font-family: var(--fonte-titulo);
  }

  .sortear__alvo {
    margin-top: 1rem;
  }

  .sortear__alvo[hidden] {
    display: none;
  }

  .sortear__card {
    display: inline-flex;
    align-items: center;
    gap: 0.9rem;
    background: var(--papel);
    border: 1px solid var(--borda);
    border-radius: 999px;
    padding: 0.5rem 1.3rem 0.5rem 0.5rem;
    box-shadow: var(--shadow);
    color: var(--texto);
  }

  .sortear__card img,
  .sortear__iniciais {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--verde-suave);
    color: var(--verde);
    font-weight: 700;
  }

  .sortear__card span:last-child {
    display: block;
    font-size: 0.8rem;
    color: var(--texto-suave);
  }

  .faixa-geracoes {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  .gen {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    border: 1px solid var(--borda);
    background: var(--papel);
    border-radius: 12px;
    padding: 0.65rem 1rem;
    color: var(--texto);
    box-shadow: var(--shadow);
  }

  .gen:hover {
    border-color: var(--verde);
    text-decoration: none;
  }

  .gen strong {
    font-family: var(--fonte-titulo);
    color: var(--verde);
  }

  .gen span {
    font-size: 0.82rem;
    color: var(--texto-suave);
  }

  .historia-card__trecho {
    color: var(--texto-suave);
    font-size: 0.94rem;
  }

  .historia-card__meta {
    font-size: 0.8rem;
    color: var(--texto-suave);
    border-top: 1px dashed var(--borda);
    padding-top: 0.6rem;
  }

  .album-strip {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.9rem;
  }

  .album-strip li {
    background: var(--papel);
    border: 1px solid var(--borda);
    border-radius: 10px;
    padding: 0.5rem 0.5rem 0.5rem;
    box-shadow: var(--shadow);
  }

  .album-strip img {
    width: 100%;
    aspect-ratio: 3 / 2; /* formato horizontal em todas as fotos */
    object-fit: cover;
    object-position: center 30%; /* mantém os rostos nos originais na vertical */
    border-radius: 6px;
  }

  .album-strip li:nth-child(odd) {
    transform: rotate(-1.2deg);
  }

  .album-strip li:nth-child(even) {
    transform: rotate(1.2deg);
  }

  @media (max-width: 860px) {
    .hero__flex {
      grid-template-columns: 1fr;
    }

    .hero__foto {
      max-width: 420px;
    }
  }
  /* ---- Botão da miniatura do álbum (clicável) ---- */
  .album-strip__btn {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    border-radius: 6px;
    overflow: hidden;
  }
  .album-strip__btn:focus-visible {
    outline: 3px solid var(--dourado);
    outline-offset: 2px;
  }
  .album-strip__btn img {
    pointer-events: none;
  }

  /* ---- Lightbox / carrossel ---- */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox[hidden] { display: none; }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(20, 24, 22, 0.82);
    backdrop-filter: blur(4px);
  }

  .lightbox__panel {
    position: relative;
    z-index: 1;
    width: min(96vw, 1100px);
    max-height: 96vh;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: 1rem 1rem 1.2rem;
    background: var(--papel);
    border-radius: 16px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.45);
  }

  .lightbox__fechar {
    position: absolute;
    top: 0.5rem;
    right: 0.6rem;
    z-index: 2;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 999px;
    background: var(--creme);
    color: var(--carvao);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
