    font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    color: #e4d7ae;
  }
  .kz-hero__desc {
    margin: 0;
    max-width: 46ch;
    font-size: 0.98rem;
    line-height: 1.55;
    color: rgba(243, 239, 228, 0.88);
  }

  /* ===================== ÁREA PRINCIPAL ===================== */
  .kz-main {
    background:
      radial-gradient(circle at 88% 12%, rgba(184, 158, 92, 0.07), transparent 42%),
      radial-gradient(circle at 6% 92%, rgba(73, 107, 84, 0.08), transparent 40%),
      #f6f1e5;
    padding: 1.6rem 0 2.6rem;
  }
  .kz-main .kz-main__grid {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr) auto;
    gap: 1.1rem;
    align-items: stretch;
    width: min(1500px, 100% - 3rem);
    max-width: none;
    margin-inline: auto;
  }

  /* ---------- rail de comandos ---------- */
  .kz-rail {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    padding: 0.8rem 0.4rem;
    background: rgba(255, 253, 247, 0.85);
    border: 1px solid #e6ddc7;
    border-radius: 16px;
    box-shadow: 0 4px 18px rgba(64, 52, 28, 0.06);
    height: fit-content;
    position: sticky;
    top: 1rem;
  }
  .kz-rail__btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.28rem;
    width: 66px;
    padding: 0.55rem 0.2rem;
    border: 0;
    background: none;
    border-radius: 12px;
    color: #3c4a40;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    cursor: pointer;
    text-decoration: none;
    transition: background 0.2s, color 0.2s, transform 0.2s;
  }
  .kz-rail__btn svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .kz-rail__btn:hover:not(:disabled) { background: #efe7d3; color: #274736; transform: translateY(-1px); }
  .kz-rail__btn:focus-visible { outline: 2px solid #496b54; outline-offset: 2px; }
  .kz-rail__btn:disabled { opacity: 0.38; cursor: default; }

  /* ---------- pesquisa ---------- */
  .kz-palco-col { min-width: 0; }

  /* filtros do palco */
  .kz-filtros { display: flex; flex-wrap: wrap; gap: 0.45rem; padding-inline: 0.6rem; margin-top: 0.9rem; z-index: 3; }
  .kz-filtro {
    font-family: var(--fonte-corpo);
    font-size: 0.74rem;
    font-weight: 600;
    color: #5d6a5f;
    background: #efe7d3;
    border: 1px solid #e6ddc7;
    border-radius: 999px;
    padding: 0.28rem 0.9rem;
    cursor: pointer;
    transition: background 0.16s, color 0.16s, border-color 0.16s, box-shadow 0.16s;
  }
  .kz-filtro:hover { background: #e5dcc2; color: #26332b; border-color: #d2c6a0; }
  .kz-filtro[aria-selected="true"] {
    background: #496b54;
    border-color: #496b54;
    color: #fffdf8;
    box-shadow: 0 2px 8px rgba(73, 107, 84, 0.3);
  }
  .kz-filtro[role="tab"]:focus-visible { outline: 2px solid #b3a06a; outline-offset: 1px; }

  .kz-busca {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 420px;
    margin: 0 auto 0.9rem;
    background: #fffdf8;
    border: 1px solid #e2d8bf;
    border-radius: 999px;
    padding: 0.42rem 1rem;
    box-shadow: 0 3px 12px rgba(64, 52, 28, 0.05);
  }
  .kz-busca svg { width: 17px; height: 17px; fill: none; stroke: #8a7d5c; stroke-width: 1.8; stroke-linecap: round; flex: 0 0 auto; }
  .kz-busca input {
    flex: 1;
    border: 0;
    background: none;
    font-size: 0.95rem;
    color: #2e3630;
    outline: none;
    min-width: 0;
  }
  .kz-sugestoes {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    background: #fffdf8;
    border: 1px solid #e2d8bf;
    border-radius: 14px;
    list-style: none;
    margin: 0;
    padding: 0.3rem;
    max-height: 300px;
    overflow: auto;
    z-index: 60;
    box-shadow: 0 14px 38px rgba(46, 40, 22, 0.16);
  }
  .kz-sugestoes li button {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    width: 100%;
    text-align: left;
    background: none;
    border: 0;
    padding: 0.5rem 0.7rem;
    border-radius: 9px;
    cursor: pointer;
    font-size: 0.92rem;
    color: #2e3630;
  }
  .kz-sugestoes li button:hover, .kz-sugestoes li button:focus-visible { background: #f1ead8; outline: none; }
  .kz-sugestoes small { color: #8a7d5c; font-size: 0.76rem; }

  /* ---------- palco ---------- */
  .kz-palco {
    position: relative;
    display: block;
    background:
      linear-gradient(180deg, rgba(255, 253, 247, 0.75), rgba(250, 245, 232, 0.9)),
      #faf6ea;
    border: 1px solid #e6ddc7;
    border-radius: 22px;
    box-shadow: 0 10px 40px rgba(64, 52, 28, 0.08), inset 0 1px 0 #fff;
    overflow: hidden;
  }
  /* seigaiha discreto no canto */
  .kz-palco::before {
    content: '';
    position: absolute;
    left: -30px;
    bottom: -30px;
    width: 340px;
    height: 220px;
    background-image: radial-gradient(circle at 50% 100%, transparent 22%, rgba(73, 107, 84, 0.06) 23%, rgba(73, 107, 84, 0.06) 25%, transparent 26%, transparent 33%, rgba(73, 107, 84, 0.05) 34%, rgba(73, 107, 84, 0.05) 36%, transparent 37%);
    background-size: 68px 40px;
    pointer-events: none;
  }
  .kz-linhas { position: absolute; inset: 0; pointer-events: none; z-index: 1; }
  .kz-linha { fill: none; stroke: #b3a06a; stroke-width: 1.6; opacity: 0.75; }
  .kz-linha__pt { fill: #f7f2e5; stroke: #8a7d5c; stroke-width: 1.4; }

  /* ---------- zonas (grid areas) removidas: os satélites orbitam via #kz-anel ---------- */
  /* ---------- overlay de grupo grande ---------- */
  .kz-overlay { position: absolute; inset: 0; z-index: 40; display: flex; align-items: center; justify-content: center; padding: 1.2rem; }
  .kz-overlay[hidden] { display: none; }
  .kz-overlay__fundo { position: absolute; inset: 0; background: rgba(38, 44, 36, 0.45); backdrop-filter: blur(2px); border-radius: 22px; }
  .kz-overlay__caixa {
    position: relative;
    z-index: 1;
    background: #fffdf8;
    border: 1px solid #ddd2b2;
    border-radius: 18px;
    padding: 1rem 1.1rem 1.2rem;
    width: min(100%, 760px);
    max-height: 88%;
    overflow: auto;
    box-shadow: 0 24px 64px rgba(20, 24, 20, 0.35);
  }
  .kz-overlay__topo { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.8rem; padding-bottom: 0.6rem; border-bottom: 1px solid #efe7d3; }
  .kz-overlay__topo h3 { margin: 0; font-family: var(--fonte-titulo); font-size: 1.15rem; color: #26332b; }
  .kz-overlay__topo h3 span { background: #efe7d3; border-radius: 999px; padding: 0.05rem 0.5rem; font-size: 0.75rem; color: #6c6248; font-family: var(--fonte-corpo); }
  .kz-overlay__topo button { border: 0; background: #f1ead8; width: 30px; height: 30px; border-radius: 50%; cursor: pointer; font-size: 1.1rem; color: #5d6a5f; flex: 0 0 auto; }
  .kz-overlay__topo button:hover { background: #e5dcc2; }
  .kz-overlay__cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(218px, 1fr)); gap: 0.6rem; }
  .kz-overlay__cards .kz-card { width: 100%; }

  /* ---------- cartão de parente ---------- */
  .kz-card {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 218px;
    padding: 0.5rem 0.65rem 0.5rem 0.5rem;
    background: #fffdf8;
    border: 1px solid #e8dfc9;
    border-radius: 14px;
    box-shadow: 0 3px 12px rgba(64, 52, 28, 0.07);
    cursor: pointer;
    text-align: left;
    scroll-margin-top: 96px;
    scroll-margin-bottom: 24px;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }
  .kz-card:hover, .kz-card:focus-visible {
    transform: translateY(-2px);
    border-color: #b3a06a;
    box-shadow: 0 8px 22px rgba(64, 52, 28, 0.13);
    outline: none;
  }
  .kz-card__foto {
    flex: 0 0 auto;
    width: 54px;
    height: 54px;
    border-radius: 10px;
    overflow: hidden;
    background: #efe7d3;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .kz-card__foto img { width: 100%; height: 100%; object-fit: cover; }
  .kz-card__foto .kz-retrato { width: 100%; height: 100%; }
  .kz-card__txt { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; }
  .kz-card__rot { font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: #9a8c64; }
  .kz-card__nome {
    font-family: var(--fonte-titulo);
    font-size: 0.92rem;
    font-weight: 600;
    color: #26332b;
    line-height: 1.15;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .kz-card__anos { font-size: 0.72rem; color: #5d6a5f; }
  .kz-card__ger { font-size: 0.64rem; color: #9a8c64; }
  .kz-card__rot { font-size: 0.6rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: #9a8c64; }
  .kz-card__nome {
    font-family: var(--fonte-titulo);
    font-size: 0.92rem;
    font-weight: 600;
    color: #26332b;
    line-height: 1.15;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .kz-card__anos { font-size: 0.72rem; color: #5d6a5f; }
  .kz-card__ger { font-size: 0.64rem; color: #9a8c64; }

  /* ---------- retrato (foto real ou placeholder premium) ---------- */
  .kz-retrato {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    background: #efe7d3;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .kz-retrato img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .kz-retrato--placeholder {
    color: #a8935a;
    font-family: var(--fonte-titulo);
    font-weight: 600;
  }
  .kz-retrato--placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(150deg, #496b54, #2f4a3a);
    opacity: 0.85;
    border-radius: 10px;
  }
  .kz-retrato--placeholder span {
    position: relative;
    z-index: 1;
    font-size: 1rem;
  }

  .kz-avt {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: linear-gradient(150deg, #496b54, #2f4a3a);
    color: #efe7d3;
    font-family: var(--fonte-titulo);
    font-weight: 600;
    font-size: 1rem;
  }

  /* ---------- centro da roda (disco) ---------- */
  .kz-centro { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 3; display: flex; align-items: center; justify-content: center; }
  .kz-foco {
    position: relative;
    width: clamp(470px, 62%, 600px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 38%, #fffdf4 0%, #f5edda 55%, #e7dbc0 100%);
    border: 1.5px solid #c8b075;
    box-shadow: 0 16px 42px rgba(46, 40, 22, 0.24), 0 0 0 6px rgba(250, 245, 232, 0.75), inset 0 2px 6px rgba(255, 255, 255, 0.9);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.3rem;
    text-align: center;
    padding: 1.2rem;
    scroll-margin-top: 96px;
  }
  .kz-foco[data-tem-foto="1"] {
    border-color: #d9b96a;
    box-shadow: 0 18px 48px rgba(46, 40, 22, 0.28), 0 0 0 6px rgba(247, 239, 214, 0.8), inset 0 2px 6px rgba(255, 255, 255, 0.9);
  }
  .kz-foco::after {
    content: '';
    position: absolute;
    inset: 8px;
    border-radius: 50%;
    border: 1px dashed rgba(179, 160, 106, 0.55);
    pointer-events: none;
  }
  .kz-foco__selo {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.26em;
    color: #a8935a;
  }
  .kz-foco__foto {
    width: 46%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    background: #efe7d3;
    border: 3px solid #efe6d0;
    box-shadow: 0 4px 14px rgba(46, 40, 22, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .kz-foco[data-tem-foto="1"] .kz-foco__foto { border-color: #d9b96a; }
  .kz-foco__foto img { width: 100%; height: 100%; object-fit: cover; }
  .kz-avt--foco { font-size: 3.1rem; }
  .kz-foco__nome {
    margin: 0;
    font-family: var(--fonte-titulo);
    font-size: clamp(1.5rem, 3vmin, 2.05rem);
    font-weight: 600;
    color: #26332b;
    line-height: 1.12;
    max-width: 88%;
  }
  .kz-foco__anos { margin: 0; font-size: 1.05rem; color: #5d6a5f; }
  .kz-foco__ger { margin: 0; font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; color: #a8935a; font-weight: 700; }
  .kz-foco__bio, .kz-foco__orn { display: none; }
  .kz-foco__det {
    margin-top: 0.18rem;
    border: 1px solid #496b54;
    background: #496b54;
    color: #f6f2e7;
    border-radius: 999px;
    padding: 0.3rem 0.8rem;
    font-size: 0.68rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }
  .kz-foco__det:hover { background: #38553f; transform: translateY(-1px); }
  .kz-foco__det:focus-visible { outline: 2px solid #b3a06a; outline-offset: 2px; }

  /* ---------- rodapé do palco ---------- */
  .kz-rodape {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.8rem;
    padding: 0 0.4rem;
    flex-wrap: wrap;
  }
  .kz-rodape__dica { margin: 0; font-size: 0.78rem; color: #8a7d5c; max-width: 46ch; }
  .kz-rodape__cont { margin: 0; font-size: 0.78rem; font-weight: 600; color: #496b54; }

  /* ---------- painel de detalhes ---------- */
  .kz-painel {
    background: #fffdf8;
    border: 1px solid #e6ddc7;
    border-radius: 18px;
    box-shadow: 0 14px 40px rgba(46, 40, 22, 0.18), 0 0 0 1px #ece2c6, inset 0 1px 0 #fffdf6;
    padding: 1rem 1.05rem 1.2rem;
    max-height: calc(100vh - 2rem);
    overflow: auto;
    position: sticky;
    top: 1rem;
    height: fit-content;
    width: 340px;
  }
  .kz-painel:not(.kz-painel--aberto) { display: none; }
  .kz-painel__topo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid #efe7d3;
    margin-bottom: 0.9rem;
  }
  .kz-painel__marca { color: #a8935a; }
  .kz-painel__topo h2 {
    margin: 0;
    flex: 1;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #5d6a5f;
  }
  .kz-painel__fechar {
    border: 0;
    background: #f1ead8;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 1.05rem;
    line-height: 1;
    color: #5d6a5f;
  }
  .kz-painel__fechar:hover { background: #e5dcc2; }
  /* ---------- hero do painel (dossiê) ---------- */
  .kz-painel__hero {
    position: relative;
    margin: -0.55rem -0.55rem 0.85rem;
    padding: 1.3rem 1rem 1rem;
    border-radius: 14px;
    text-align: center;
    overflow: hidden;
    color: #f3efe4;
    background: radial-gradient(130% 130% at 50% -10%, #3b5142 0%, #26332b 55%, #19241c 100%);
    border: 1px solid rgba(217, 185, 106, 0.4);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 10px 28px rgba(22, 31, 24, 0.45);
  }
  .kz-painel__crest {
    position: absolute;
    top: -1.6rem; right: -0.5rem;
    font-family: var(--fonte-jp);
    font-size: 6.4rem;
    line-height: 1;
    color: rgba(217, 185, 106, 0.2);
    pointer-events: none;
    user-select: none;
  }
  .kz-painel__onda {
    position: absolute;
    left: 0; right: 0; bottom: -48px; height: 78px;
    background-image: radial-gradient(circle at 50% 0, transparent 33%, rgba(217, 185, 106, 0.16) 34%, rgba(217, 185, 106, 0.16) 36%, transparent 37%, transparent 50%, rgba(217, 185, 106, 0.11) 51%, rgba(217, 185, 106, 0.11) 53%, transparent 54%);
    background-size: 58px 34px;
    pointer-events: none;
    opacity: 0.9;
  }
  .kz-painel__foto {
    position: relative;
    width: 80px; height: 80px;
    margin: 0.1rem auto 0.6rem;
    border-radius: 50%;
    border: 2px solid #d9b96a;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.42), inset 0 0 0 3px rgba(217, 185, 106, 0.3);
    overflow: hidden;
    background: #efe7d3;
    display: flex; align-items: center; justify-content: center;
  }
  .kz-painel__foto img { width: 100%; height: 100%; object-fit: cover; }
  .kz-avt--painel { font-size: 1.6rem; }
  .kz-painel__hero h3 { margin: 0; font-family: var(--fonte-titulo); font-size: 1.3rem; font-weight: 600; color: #f6f2e7; line-height: 1.15; }
  .kz-painel__anos { margin: 0.24rem 0 0; font-size: 0.8rem; color: rgba(243, 239, 228, 0.85); }
  .kz-painel__ger { margin: 0.12rem 0 0; font-size: 0.62rem; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: #d9b96a; }
  .kz-painel__meta { position: relative; display: flex; justify-content: center; gap: 0.35rem; flex-wrap: wrap; margin-top: 0.62rem; }
  .kz-painel__chip {
    display: inline-flex; align-items: center; gap: 0.3rem;
    border: 1px solid rgba(217, 185, 106, 0.6);
    background: rgba(217, 185, 106, 0.13);
    color: #ecdfae;
    padding: 0.16rem 0.62rem;
    border-radius: 999px;
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .kz-painel__divisor { display: flex; align-items: center; gap: 0.6rem; color: #c8b075; margin: 0 0 0.85rem; }
  .kz-painel__divisor::before, .kz-painel__divisor::after { content: ''; flex: 1; height: 1px; background: linear-gradient(90deg, transparent, #dccd9e, transparent); }
  .kz-painel__divisor span { font-size: 0.8rem; }

  .kz-painel__sec { margin-bottom: 1.05rem; }
  .kz-painel__sec h4 {
    margin: 0 0 0.5rem;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: #6f5f37;
    border-left: 3px solid #d9b96a;
    padding-left: 0.55rem;
    display: flex;
    align-items: center;
    gap: 0.42rem;
  }
  .kz-painel__sec h4 span[aria-hidden] { color: #a8935a; font-size: 0.85rem; }
  .kz-painel__sec p { margin: 0 0 0.35rem; font-size: 0.85rem; line-height: 1.55; color: #4c574d; }
  .kz-painel__citacao { font-style: italic; border-left: 2px solid #ece2c6; padding-left: 0.7rem; color: #56503c; }

  .kz-painel__vidadb { display: flex; flex-direction: column; gap: 0.45rem; }
  .kz-painel__vida {
    display: flex; align-items: center; gap: 0.6rem;
    background: #fbf6ea;
    border: 1px solid #efe7d3;
    border-radius: 12px;
    padding: 0.38rem 0.55rem;
  }
  .kz-painel__vida-ic {
    flex: 0 0 auto; width: 32px; height: 32px;
    border-radius: 9px;
    background: #efe7d3;
    color: #7b6c48;
    display: flex; align-items: center; justify-content: center;
    font-size: 0.95rem;
  }
  .kz-painel__vida em { display: block; font-style: normal; font-size: 0.58rem; text-transform: uppercase; letter-spacing: 0.16em; color: #a8935a; font-weight: 700; }
  .kz-painel__vida p { margin: 0; font-size: 0.8rem; color: #38362a; }
  .kz-painel__n { background: #efe7d3; border-radius: 999px; padding: 0 0.42rem; font-size: 0.7rem; color: #6c6248; }
  .kz-painel__evs { list-style: none; margin: 0; padding: 0.15rem 0 0.15rem 1.35rem; font-size: 0.83rem; line-height: 1.5; color: #4c574d; position: relative; }
  .kz-painel__evs::before { content: ''; position: absolute; left: 0.42rem; top: 0.5rem; bottom: 0.5rem; width: 2px; background: linear-gradient(#e3d6b6, #ece2c6); border-radius: 2px; }
  .kz-painel__evs li { position: relative; padding: 0.32rem 0; border: 0; }
  .kz-painel__evs li::before { content: ''; position: absolute; left: -1.15rem; top: 0.5rem; width: 11px; height: 11px; border-radius: 50%; background: #d9b96a; border: 2px solid #fffdf8; box-shadow: 0 0 0 1.5px #d9c99b; }
