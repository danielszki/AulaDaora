---
import Base from '../layouts/Base.astro';
import { pessoas, historias } from '../data/familia';

const dados = pessoas.map((p) => ({
  id: p.id,
  nome: p.nome,
  apelido: p.apelido || '',
  nascimento: p.nascimento || '',
  falecimento: p.falecimento || '',
  geracao: p.geracao,
  pais: p.pais || [],
  conjuges: p.conjuges || [],
  exDe: (p as any).exDe || [],
  foto: p.foto || '',
  bio: p.bio || '',
  local: p.local || '',
  profissao: p.profissao || '',
  observacao: p.observacao || '',
  agregado: !!p.agregado,
}));
const kzPayload = JSON.stringify({ pessoas: dados, historias }).replace(/</g, '\\u003c');
---

<Base title="Kizuna — Laços da Família Kato" description="Explore as relações da Família Kato, uma pessoa de cada vez.">
  <section class="kz-heading">
    <div class="kz-container">
      <div class="kz-heading__copy">
        <span class="kz-eyebrow"><span class="kz-eyebrow__mark" aria-hidden="true">絆</span> KIZUNA · LAÇOS</span>
        <h1>Kizuna — Laços da Família Kato</h1>
        <p class="kz-heading__lead">Uma família, muitas histórias que se encontram.</p>
        <p class="kz-heading__text">Escolha alguém para explorar seus vínculos. Cada familiar pode levar você a um novo ramo da história.</p>
      </div>
      <div class="kz-heading__note" aria-label="Significado de Kizuna">
        <span lang="ja">絆</span>
        <p>Laços que atravessam gerações.</p>
      </div>
    </div>
  </section>

  <section class="kz-explorer" aria-label="Explorador de parentesco">
    <div class="kz-container">
      <div class="kz-toolbar">
        <div class="kz-search">
          <label class="kz-sr-only" for="kz-busca">Pesquisar uma pessoa da família</label>
          <span class="kz-search__icon" aria-hidden="true">⌕</span>
          <input type="search" id="kz-busca" placeholder="Pesquisar pelo nome…" autocomplete="off" aria-autocomplete="list" aria-controls="kz-sugestoes" aria-expanded="false" />
          <div id="kz-sugestoes" class="kz-suggestions" role="listbox" hidden></div>
        </div>
        <div class="kz-toolbar__actions" aria-label="Ações do explorador">
          <button type="button" id="kz-voltar" class="kz-tool-button" disabled><span aria-hidden="true">←</span> Voltar</button>
          <button type="button" id="kz-centrar" class="kz-tool-button"><span aria-hidden="true">⌖</span> Centralizar</button>
          <button type="button" id="kz-inicio" class="kz-tool-button"><span aria-hidden="true">↺</span> Início</button>
          <button type="button" id="kz-relacao" class="kz-tool-button kz-tool-button--primary"><span aria-hidden="true">⌘</span> Como somos parentes?</button>
          <a class="kz-tool-button kz-tool-button--link" href="/arvore"><span aria-hidden="true">⌘</span> Árvore tradicional</a>
        </div>
      </div>

      <div class="kz-workspace">
        <section class="kz-stage" aria-label="Mapa de vínculos da pessoa selecionada">
          <div class="kz-stage__header">
            <div>
              <span class="kz-stage__kicker">SEU LUGAR NA FAMÍLIA</span>
              <h2>Explore os laços</h2>
            </div>
            <p id="kz-status" class="kz-status" role="status" aria-live="polite">Preparando a árvore familiar…</p>
          </div>

          <div class="kz-orbit" id="kz-orbit">
            <svg class="kz-lines" id="kz-linhas" aria-hidden="true" focusable="false"></svg>

            <section class="kz-zone kz-zone--parents" id="kz-zone-pais" data-zone="pais" aria-label="Pais">
              <div class="kz-zone__heading"><span>Pais</span><span class="kz-zone__count" id="kz-count-pais">0</span></div>
              <div class="kz-zone__nodes" id="kz-pais"></div>
            </section>

            <section class="kz-zone kz-zone--siblings" id="kz-zone-irmaos" data-zone="irmaos" aria-label="Irmãos">
              <div class="kz-zone__heading"><span>Irmãos</span><span class="kz-zone__count" id="kz-count-irmaos">0</span></div>
              <div class="kz-zone__nodes" id="kz-irmaos"></div>
            </section>

            <article class="kz-focus" id="kz-focus" aria-label="Pessoa selecionada"></article>

            <section class="kz-zone kz-zone--partners" id="kz-zone-conjuges" data-zone="conjuges" aria-label="Cônjuges">
              <div class="kz-zone__heading"><span>Casamento e união</span><span class="kz-zone__count" id="kz-count-conjuges">0</span></div>
              <div class="kz-zone__nodes" id="kz-conjuges"></div>
            </section>

            <section class="kz-zone kz-zone--children" id="kz-zone-filhos" data-zone="filhos" aria-label="Filhos">
              <div class="kz-zone__heading"><span>Filhos</span><span class="kz-zone__count" id="kz-count-filhos">0</span></div>
              <div class="kz-zone__nodes" id="kz-filhos"></div>
            </section>
          </div>

          <div class="kz-legend">
            <span class="kz-legend__line" aria-hidden="true"></span>
            <span>As linhas mostram vínculos registrados na árvore.</span>
            <span class="kz-legend__hint">Selecione um cartão para continuar explorando.</span>
          </div>
        </section>

        <aside class="kz-details" id="kz-painel" aria-labelledby="kz-detail-title" aria-live="polite">
          <div class="kz-details__eyebrow"><span class="kz-details__dot" aria-hidden="true"></span> PESSOA EM FOCO</div>
          <div id="kz-painel-conteudo">
            <h2 id="kz-detail-title">Carregando…</h2>
            <p>Os detalhes da pessoa selecionada aparecerão aqui.</p>
          </div>
        </aside>
      </div>
      <p class="kz-footnote">Os vínculos dependem dos registros da família. Quando uma informação ainda não foi confirmada, ela não é presumida.</p>
    </div>
  </section>

  <div class="kz-modal" id="kz-relacao-modal" hidden>
    <button class="kz-modal__backdrop" type="button" data-close-modal aria-label="Fechar janela"></button>
    <section class="kz-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="kz-modal-title" aria-describedby="kz-modal-description">
      <button type="button" class="kz-modal__close" id="kz-modal-close" aria-label="Fechar">×</button>
      <span class="kz-eyebrow">DESCUBRA A CONEXÃO</span>
      <h2 id="kz-modal-title">Como somos parentes?</h2>
      <p id="kz-modal-description" class="kz-modal__intro">Escolha duas pessoas. Vamos procurar um caminho usando somente os parentescos registrados na árvore.</p>
      <div class="kz-modal__fields">
        <div class="kz-modal__field">
          <label for="kz-rel-a">Primeira pessoa</label>
          <input type="search" id="kz-rel-a" placeholder="Digite um nome…" autocomplete="off" aria-autocomplete="list" aria-controls="kz-rel-a-list" aria-expanded="false" />
          <div class="kz-suggestions" id="kz-rel-a-list" role="listbox" hidden></div>
        </div>
        <div class="kz-modal__field">
          <label for="kz-rel-b">Segunda pessoa</label>
          <input type="search" id="kz-rel-b" placeholder="Digite outro nome…" autocomplete="off" aria-autocomplete="list" aria-controls="kz-rel-b-list" aria-expanded="false" />
          <div class="kz-suggestions" id="kz-rel-b-list" role="listbox" hidden></div>
        </div>
      </div>
      <div class="kz-result" id="kz-rel-resultado" role="status" aria-live="polite">O caminho encontrado aparecerá aqui.</div>
      <div class="kz-modal__actions">
        <button type="button" class="kz-tool-button" data-close-modal>Fechar</button>
        <button type="button" class="kz-tool-button kz-tool-button--primary" id="kz-rel-calcular">Calcular caminho</button>
      </div>
    </section>
  </div>

  <script type="application/json" id="kz-dados" set:html={kzPayload}></script>
</Base>

<script>
  import { fetchPessoas, isCloudEnabled, savePessoa, uploadPhoto } from '../scripts/data';
  import { getSession, signIn, signUp, signOut, isAdmin } from '../scripts/supabase';

  const dataEl = document.getElementById('kz-dados');
  const initialPayload = dataEl ? JSON.parse(dataEl.textContent || '{}') : {};
  let PESSOAS = Array.isArray(initialPayload.pessoas) ? initialPayload.pessoas : [];
  const HISTORIAS = Array.isArray(initialPayload.historias) ? initialPayload.historias : [];
  const byId = new Map();

  window.__katoCloud = { fetchPessoas, isCloudEnabled, savePessoa, uploadPhoto, getSession, signIn, signUp, signOut, isAdmin };
  window.dispatchEvent(new Event('kato-cloud-ready'));

  const $ = (id) => document.getElementById(id);
  const orbit = $('kz-orbit');
  const focus = $('kz-focus');
  const linesSvg = $('kz-linhas');
  const searchInput = $('kz-busca');
  const searchList = $('kz-sugestoes');
  const backButton = $('kz-voltar');
  const resetButton = $('kz-inicio');
  const detailsContent = $('kz-painel-conteudo');
  const modal = $('kz-relacao-modal');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const initialId = 'yotaro-kato';
  let selectedId = null;
  const historyStack = [];
  let relationAId = null;
  let relationBId = null;
  let previousFocus = null;

  function normalizeText(value) {
    return String(value || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('pt-BR').trim();
  }

  function makeElement(tag, className, text) {
    const el = document.createElement(tag);
    if (className) el.className = className;
    if (text !== undefined && text !== null) el.textContent = String(text);
    return el;
  }

  function makeLink(href, label, className) {
    const link = makeElement('a', className || '', label);
    link.href = href;
    return link;
  }

  function initials(name) {
    return String(name || '?').split(/\s+/).filter(Boolean).slice(0, 2).map((part) => part.charAt(0)).join('').toLocaleUpperCase('pt-BR');
  }

  function dates(person) {
    if (person.nascimento && person.falecimento) return person.nascimento + ' – ' + person.falecimento;
    if (person.nascimento) return 'Nasc. ' + person.nascimento;
    if (person.falecimento) return 'Fal. ' + person.falecimento;
    return 'Datas a confirmar';
  }

  function generation(person) {
    const value = Number(person.geracao || 0);
    if (!value) return 'Antepassados';
    const ordinals = ['1ª', '2ª', '3ª', '4ª', '5ª', '6ª', '7ª', '8ª', '9ª', '10ª'];
    return (ordinals[value - 1] || value + 'ª') + ' geração';
  }

  function dateSortKey(person) {
    const match = String(person.nascimento || '').match(/^(\d{2})\/(\d{2})\/(\d{4})$/);
    return match ? Number(match[3] + match[2] + match[1]) : Number.MAX_SAFE_INTEGER;
  }

  function sortByBirth(list) {
    return list.slice().sort((a, b) => dateSortKey(a) - dateSortKey(b) || a.nome.localeCompare(b.nome, 'pt-BR'));
  }

  function parentsOf(id) {
    const person = byId.get(id);
    return (person && Array.isArray(person.pais) ? person.pais : []).map((parentId) => byId.get(parentId)).filter(Boolean);
  }

  function partnersOf(id) {
    const person = byId.get(id);
    if (!person) return [];
    const current = Array.isArray(person.conjuges) ? person.conjuges : [];
    const former = Array.isArray(person.exDe) ? person.exDe : [];
    const ids = Array.from(new Set(current.concat(former)));
    return ids.map((partnerId) => byId.get(partnerId)).filter(Boolean).map((partner) => ({
      ...partner,
      __relationship: former.includes(partner.id) ? 'Ex-cônjuge' : 'Cônjuge',
    }));
  }

  function siblingsOf(id) {
    const person = byId.get(id);
    if (!person || !Array.isArray(person.pais) || !person.pais.length) return [];
    const parentIds = new Set(person.pais);
    return sortByBirth(PESSOAS.filter((candidate) => candidate.id !== id && (candidate.pais || []).some((parentId) => parentIds.has(parentId))));
  }

  function childrenOf(id) {
    return sortByBirth(PESSOAS.filter((person) => Array.isArray(person.pais) && person.pais.includes(id)));
  }

  function rebuildIndex() {
    byId.clear();
    PESSOAS = PESSOAS.map((person) => ({
      ...person,
      pais: Array.isArray(person.pais) ? person.pais : [],
      conjuges: Array.isArray(person.conjuges) ? person.conjuges : [],
      exDe: Array.isArray(person.exDe) ? person.exDe : [],
      foto: person.foto || '',
      bio: person.bio || '',
      local: person.local || '',
      profissao: person.profissao || '',
      observacao: person.observacao || '',
    }));
    PESSOAS.forEach((person) => byId.set(person.id, person));
  }

  function personPortrait(person, size) {
    const portrait = makeElement('div', 'kz-portrait' + (size ? ' kz-portrait--' + size : ''));
    portrait.setAttribute('aria-hidden', 'true');
    if (person.foto) {
      const img = makeElement('img', '', '');
      img.src = person.foto;
      img.alt = '';
      img.loading = 'lazy';
      img.decoding = 'async';
      img.addEventListener('error', () => {
        portrait.replaceChildren(makeElement('span', 'kz-initials', initials(person.nome)));
      }, { once: true });
      portrait.append(img);
    } else {
      portrait.append(makeElement('span', 'kz-initials', initials(person.nome)));
    }
    return portrait;
  }

  function relationshipLabel(person, zone) {
    if (zone === 'pais') return 'Pai ou mãe';
    if (zone === 'irmaos') return 'Irmão ou irmã';
    if (zone === 'filhos') return 'Filho ou filha';
    return person.__relationship || 'Cônjuge';
  }

  function personCard(person, zone) {
    const button = makeElement('button', 'kz-node', '');
    button.type = 'button';
    button.dataset.id = person.id;
    button.setAttribute('aria-label', 'Explorar ' + person.nome + ', ' + relationshipLabel(person, zone));
    if (person.id === selectedId) button.setAttribute('aria-current', 'true');
    button.append(personPortrait(person, 'small'));
    const text = makeElement('span', 'kz-node__text');
    text.append(makeElement('strong', 'kz-node__name', person.nome));
    text.append(makeElement('span', 'kz-node__relationship', relationshipLabel(person, zone)));
    const year = person.nascimento ? person.nascimento : (person.falecimento ? 'Fal. ' + person.falecimento : '');
    if (year) text.append(makeElement('span', 'kz-node__year', year));
    button.append(text);
    button.addEventListener('click', () => selectPerson(person.id));
    return button;
  }

  function renderZone(zoneKey, list) {
    const zoneInfo = {
      pais: { nodes: $('kz-pais'), count: $('kz-count-pais'), empty: 'Pais não registrados.' },
      irmaos: { nodes: $('kz-irmaos'), count: $('kz-count-irmaos'), empty: 'Não há irmãos registrados.' },
      conjuges: { nodes: $('kz-conjuges'), count: $('kz-count-conjuges'), empty: 'Nenhum cônjuge registrado.' },
      filhos: { nodes: $('kz-filhos'), count: $('kz-count-filhos'), empty: 'Não há filhos registrados.' },
    };
    const info = zoneInfo[zoneKey];
    if (!info) return;
    info.count.textContent = String(list.length);
    info.nodes.replaceChildren();
    if (!list.length) {
      info.nodes.append(makeElement('p', 'kz-zone__empty', info.empty));
      return;
    }
    list.forEach((person) => info.nodes.append(personCard(person, zoneKey)));
  }

  function renderFocus(person) {
    focus.replaceChildren();
    focus.append(makeElement('span', 'kz-focus__overline', 'PESSOA EM FOCO'));
    focus.append(personPortrait(person, 'large'));
    focus.append(makeElement('h3', 'kz-focus__name', person.nome));
    focus.append(makeElement('p', 'kz-focus__dates', dates(person)));
    focus.append(makeElement('span', 'kz-focus__generation', generation(person)));
    if (person.apelido) focus.append(makeElement('p', 'kz-focus__nickname', '“' + person.apelido + '”'));
    if (person.bio) focus.append(makeElement('p', 'kz-focus__bio', person.bio));
    focus.append(makeElement('span', 'kz-focus__hint', 'Escolha um familiar ao redor para seguir os laços'));
  }

  function addDetailsSection(title, relatives, relationship) {
    if (!relatives.length) return;
    const section = makeElement('section', 'kz-details__section');
    section.append(makeElement('h3', 'kz-details__section-title', title));
    const list = makeElement('div', 'kz-details__relative-list');
    relatives.forEach((person) => {
      const item = makeElement('button', 'kz-details__relative', person.nome);
      item.type = 'button';
      item.title = relationship || 'Explorar ' + person.nome;
      item.addEventListener('click', () => selectPerson(person.id));
      list.append(item);
    });
    section.append(list);
    detailsContent.append(section);
  }

  function relatedStories(person) {
    const fullName = normalizeText(person.nome);
    const firstName = normalizeText(person.nome.split(/\s+/)[0]);
    return HISTORIAS.filter((story) => {
      const normalized = normalizeText((story.titulo || '') + ' ' + (story.texto || '') + ' ' + (story.autor || ''));
      const words = new Set(normalized.replace(/[.,;:!?()'"“”]/g, ' ').split(/\s+/).filter(Boolean));
      return (fullName && normalized.includes(fullName)) || (firstName.length >= 5 && words.has(firstName));
    }).slice(0, 4);
  }

  function renderDetails(person) {
    detailsContent.replaceChildren();
    const heading = makeElement('div', 'kz-details__person');
    heading.append(personPortrait(person, 'medium'));
    const headingCopy = makeElement('div', 'kz-details__person-copy');
    const detailHeading = makeElement('h2', '', person.nome);
    detailHeading.id = 'kz-detail-title';
    headingCopy.append(detailHeading);
    headingCopy.append(makeElement('p', 'kz-details__dates', dates(person)));
    headingCopy.append(makeElement('span', 'kz-details__generation', generation(person)));
    heading.append(headingCopy);
    detailsContent.append(heading);

    if (person.bio) detailsContent.append(makeElement('p', 'kz-details__bio', person.bio));
    if (person.local) {
      const local = makeElement('p', 'kz-details__metadata');
      local.append(makeElement('strong', '', 'Localidade '));
      local.append(document.createTextNode(person.local));
      detailsContent.append(local);
    }
    if (person.profissao) {
      const job = makeElement('p', 'kz-details__metadata');
      job.append(makeElement('strong', '', 'Profissão '));
      job.append(document.createTextNode(person.profissao));
      detailsContent.append(job);
    }
    if (person.observacao) {
      const note = makeElement('div', 'kz-details__note');
      note.append(makeElement('strong', '', 'Nota da família'));
      note.append(makeElement('p', '', person.observacao));
      detailsContent.append(note);
    }

    const parents = parentsOf(person.id);
    const partners = partnersOf(person.id);
    const siblings = siblingsOf(person.id);
    const children = childrenOf(person.id);
    addDetailsSection('Pais', parents, 'Selecionar pai ou mãe');
    addDetailsSection('Cônjuges e uniões anteriores', partners, 'Selecionar cônjuge');
    addDetailsSection('Irmãos', siblings, 'Selecionar irmão ou irmã');
    addDetailsSection('Filhos', children, 'Selecionar filho ou filha');

    const stories = relatedStories(person);
    if (stories.length) {
      const storySection = makeElement('section', 'kz-details__section');
      storySection.append(makeElement('h3', 'kz-details__section-title', 'Histórias relacionadas'));
      stories.forEach((story) => {
        const link = makeLink('/historias#' + encodeURIComponent(story.id), story.titulo, 'kz-story-link');
        const meta = makeElement('span', 'kz-story-link__author', story.autor || 'Memória de família');
        const item = makeElement('div', 'kz-story');
        item.append(link, meta);
        storySection.append(item);
      });
      detailsContent.append(storySection);
    }

    const actions = makeElement('div', 'kz-details__actions');
    actions.append(makeLink('/pessoa/' + encodeURIComponent(person.id), 'Perfil completo', 'kz-tool-button kz-tool-button--primary'));
    actions.append(makeLink('/arvore?focar=' + encodeURIComponent(person.id), 'Ver na árvore', 'kz-tool-button'));
    detailsContent.append(actions);
  }

  function updateUrl(id) {
    const url = new URL(window.location.href);
    url.searchParams.set('pessoa', id);
    window.history.replaceState({}, '', url.toString());
  }

  function drawConnections() {
    if (!orbit || !linesSvg || !selectedId) return;
    const orbitRect = orbit.getBoundingClientRect();
    const focusRect = focus.getBoundingClientRect();
    if (!orbitRect.width || !focusRect.width) return;
    const x1 = focusRect.left + focusRect.width / 2 - orbitRect.left;
    const y1 = focusRect.top + focusRect.height / 2 - orbitRect.top;
    const paths = [];
    orbit.querySelectorAll('.kz-node').forEach((card) => {
      const rect = card.getBoundingClientRect();
      if (!rect.width || !rect.height) return;
      const x2 = rect.left + rect.width / 2 - orbitRect.left;
      const y2 = rect.top + rect.height / 2 - orbitRect.top;
      const dx = x2 - x1;
      const dy = y2 - y1;
      const cx1 = x1 + dx * 0.35;
      const cy1 = y1 + dy * 0.12;
      const cx2 = x2 - dx * 0.25;
      const cy2 = y2 - dy * 0.12;
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', ['M', x1, y1, 'C', cx1, cy1, cx2, cy2, x2, y2].join(' '));
      path.setAttribute('class', 'kz-line');
      paths.push(path);
    });
    linesSvg.setAttribute('width', String(orbitRect.width));
    linesSvg.setAttribute('height', String(orbitRect.height));
    linesSvg.setAttribute('viewBox', '0 0 ' + orbitRect.width + ' ' + orbitRect.height);
    linesSvg.replaceChildren(...paths);
  }

  function render(id) {
    const person = byId.get(id);
    if (!person) return;
    selectedId = id;
    renderFocus(person);
    renderZone('pais', parentsOf(id));
    renderZone('irmaos', siblingsOf(id));
    renderZone('conjuges', partnersOf(id));
    renderZone('filhos', childrenOf(id));
    renderDetails(person);
    backButton.disabled = historyStack.length === 0;
    $('kz-status').textContent = 'Explorando: ' + person.nome;
    if (searchInput !== document.activeElement) searchInput.value = person.nome;
    updateUrl(id);
    orbit.classList.remove('kz-orbit--enter');
    if (!reducedMotion) {
      void orbit.offsetWidth;
      orbit.classList.add('kz-orbit--enter');
    }
    requestAnimationFrame(drawConnections);
  }

  function selectPerson(id, options) {
    const opts = options || {};
    if (!byId.has(id)) return;
    if (selectedId === id) {
      render(id);
      return;
    }
    if (selectedId && opts.recordHistory !== false) historyStack.push(selectedId);
    selectedId = id;
    render(id);
    if (opts.scrollIntoView) {
      orbit.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'center' });
    }
  }

  function resetToStart() {
    historyStack.length = 0;
    const startId = byId.has(initialId) ? initialId : (PESSOAS[0] ? PESSOAS[0].id : '');
    if (!startId) return;
    selectPerson(startId, { recordHistory: false });
    searchList.hidden = true;
    searchInput.value = byId.get(startId).nome;
    backButton.disabled = true;
  }

  function filterPeople(query) {
    const normalized = normalizeText(query);
    if (!normalized) return [];
    return PESSOAS
      .filter((person) => normalizeText(person.nome).includes(normalized))
      .sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'))
      .slice(0, 8);
  }

  function renderSuggestions(input, list, query, onChoose) {
    list.replaceChildren();
    const matches = filterPeople(query);
    if (!matches.length) {
      list.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      return matches;
    }
    matches.forEach((person) => {
      const option = makeElement('button', 'kz-suggestion', '');
      option.type = 'button';
      option.setAttribute('role', 'option');
      const name = makeElement('strong', '', person.nome);
      const small = makeElement('span', '', person.nascimento || generation(person));
      option.append(name, small);
      option.addEventListener('click', () => {
        onChoose(person);
        list.hidden = true;
        input.setAttribute('aria-expanded', 'false');
      });
      list.append(option);
    });
    list.hidden = false;
    input.setAttribute('aria-expanded', 'true');
    return matches;
  }

  searchInput.addEventListener('input', () => {
    renderSuggestions(searchInput, searchList, searchInput.value, (person) => selectPerson(person.id, { scrollIntoView: true }));
  });
  searchInput.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      searchList.hidden = true;
      searchInput.setAttribute('aria-expanded', 'false');
    }
    if (event.key === 'Enter') {
      const exact = PESSOAS.find((person) => normalizeText(person.nome) === normalizeText(searchInput.value));
      const first = filterPeople(searchInput.value)[0];
      if (exact || first) {
        event.preventDefault();
        const person = exact || first;
        searchList.hidden = true;
        searchInput.setAttribute('aria-expanded', 'false');
        selectPerson(person.id, { scrollIntoView: true });
      }
    }
  });
  document.addEventListener('click', (event) => {
    if (!searchInput.contains(event.target) && !searchList.contains(event.target)) {
      searchList.hidden = true;
      searchInput.setAttribute('aria-expanded', 'false');
    }
  });

  backButton.addEventListener('click', () => {
    const previous = historyStack.pop();
    if (!previous) return;
    selectPerson(previous, { recordHistory: false });
  });
  $('kz-centrar').addEventListener('click', () => {
    orbit.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'center' });
    requestAnimationFrame(drawConnections);
  });
  resetButton.addEventListener('click', resetToStart);

  function closeModal() {
    modal.hidden = true;
    document.body.style.overflow = '';
    relationAId = null;
    relationBId = null;
    relAInput.value = '';
    relBInput.value = '';
    relAList.hidden = true;
    relBList.hidden = true;
    relAInput.setAttribute('aria-expanded', 'false');
    relBInput.setAttribute('aria-expanded', 'false');
    $('kz-rel-resultado').textContent = 'O caminho encontrado aparecerá aqui.';
    if (previousFocus && typeof previousFocus.focus === 'function') previousFocus.focus();
  }

  $('kz-relacao').addEventListener('click', () => {
    previousFocus = document.activeElement;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
    $('kz-rel-a').focus();
  });
  modal.querySelectorAll('[data-close-modal]').forEach((button) => button.addEventListener('click', closeModal));
  $('kz-modal-close').addEventListener('click', closeModal);
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !modal.hidden) closeModal();
  });

  const relAInput = $('kz-rel-a');
  const relBInput = $('kz-rel-b');
  const relAList = $('kz-rel-a-list');
  const relBList = $('kz-rel-b-list');

  relAInput.addEventListener('input', () => {
    relationAId = null;
    renderSuggestions(relAInput, relAList, relAInput.value, (person) => {
      relationAId = person.id;
      relAInput.value = person.nome;
    });
  });
  relBInput.addEventListener('input', () => {
    relationBId = null;
    renderSuggestions(relBInput, relBList, relBInput.value, (person) => {
      relationBId = person.id;
      relBInput.value = person.nome;
    });
  });

  function neighborsOf(id) {
    const person = byId.get(id);
    if (!person) return [];
    const ids = new Set([
      ...(person.pais || []),
      ...(person.conjuges || []),
      ...(person.exDe || []),
      ...childrenOf(id).map((child) => child.id),
      ...PESSOAS.filter((candidate) => (candidate.conjuges || []).includes(id) || (candidate.exDe || []).includes(id)).map((candidate) => candidate.id),
    ]);
    ids.delete(id);
    return Array.from(ids).filter((neighborId) => byId.has(neighborId));
  }

  function findPath(start, end) {
    if (!byId.has(start) || !byId.has(end)) return null;
    if (start === end) return [start];
    const queue = [start];
    const visited = new Set([start]);
    const predecessor = new Map();
    while (queue.length) {
      const current = queue.shift();
      for (const next of neighborsOf(current)) {
        if (visited.has(next)) continue;
        visited.add(next);
        predecessor.set(next, current);
        if (next === end) {
          const path = [end];
          let cursor = end;
          while (predecessor.has(cursor)) {
            cursor = predecessor.get(cursor);
            path.unshift(cursor);
          }
          return path;
        }
        queue.push(next);
      }
    }
    return null;
  }

  function edgeLabel(fromId, toId) {
    const from = byId.get(fromId);
    const to = byId.get(toId);
    if (!from || !to) return 'parente';
    if ((from.pais || []).includes(toId)) return 'pai ou mãe';
    if ((to.pais || []).includes(fromId)) return 'filho ou filha';
    if ((from.conjuges || []).includes(toId) || (to.conjuges || []).includes(fromId)) return 'cônjuge';
    if ((from.exDe || []).includes(toId) || (to.exDe || []).includes(fromId)) return 'ex-cônjuge';
    const fromParents = new Set(from.pais || []);
    if ((to.pais || []).some((parentId) => fromParents.has(parentId))) return 'irmão ou irmã';
    return 'parente por vínculo registrado';
  }

  $('kz-rel-calcular').addEventListener('click', () => {
    const result = $('kz-rel-resultado');
    result.replaceChildren();
    if (!relationAId || !relationBId) {
      result.textContent = 'Selecione as duas pessoas nas sugestões para calcular o caminho.';
      return;
    }
    const path = findPath(relationAId, relationBId);
    if (!path) {
      result.textContent = 'Não foi encontrado um caminho entre essas pessoas com os vínculos registrados.';
      return;
    }
    result.append(makeElement('p', 'kz-result__summary', 'Caminho encontrado: ' + path.length + ' pessoa' + (path.length === 1 ? '' : 's') + ' no percurso.'));
    const list = makeElement('ol', 'kz-result__path');
    path.forEach((id, index) => {
      const person = byId.get(id);
      const item = makeElement('li', '');
      const choose = makeElement('button', 'kz-result__person', person.nome);
      choose.type = 'button';
      choose.addEventListener('click', () => {
        closeModal();
        selectPerson(id, { scrollIntoView: true });
      });
      item.append(choose);
      if (index < path.length - 1) {
        item.append(makeElement('span', 'kz-result__relation', edgeLabel(id, path[index + 1])));
      }
      list.append(item);
    });
    result.append(list);
  });

  async function boot() {
    rebuildIndex();
    try {
      const currentData = await fetchPessoas(PESSOAS.slice());
      if (Array.isArray(currentData) && currentData.length) {
        PESSOAS = currentData;
        rebuildIndex();
      }
    } catch (error) {
      console.warn('Não foi possível atualizar os dados locais do Kizuna.', error);
    }
    const requestedId = new URLSearchParams(window.location.search).get('pessoa');
    const startId = requestedId && byId.has(requestedId) ? requestedId : (byId.has(initialId) ? initialId : (PESSOAS[0] ? PESSOAS[0].id : ''));
    if (!startId) {
      $('kz-status').textContent = 'Nenhuma pessoa disponível para explorar.';
      return;
    }
    selectPerson(startId, { recordHistory: false });
  }

  window.addEventListener('resize', () => requestAnimationFrame(drawConnections));
  if ('ResizeObserver' in window) {
    const observer = new ResizeObserver(() => requestAnimationFrame(drawConnections));
    observer.observe(orbit);
  }

  boot().catch((error) => {
    console.error('Falha ao iniciar Kizuna.', error);
    $('kz-status').textContent = 'Não foi possível carregar a exploração familiar.';
  });
</script>

