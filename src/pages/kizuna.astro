  .kz-painel__acoes { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1.2rem; }
  .kz-painel__acoes .btn { flex: 1; justify-content: center; text-decoration: none; text-align: center; }

  /* mini-linha de parente no painel */
  .kz-mini {
    display: flex;
    align-items: center;
    gap: 0.62rem;
