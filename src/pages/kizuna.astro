  }
  .kz-mini:hover, .kz-mini:focus-visible {
    background: #f8f2e0;
    border-color: #d9c99b;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(46, 40, 22, 0.12);
    outline: none;
  }
  .kz-mini__foto { flex: 0 0 auto; width: 44px; height: 44px; border-radius: 50%; overflow: hidden; background: #efe7d3; display: flex; align-items: center; justify-content: center; border: 1.5px solid #efe7d3; }
  .kz-mini__foto img { width: 100%; height: 100%; object-fit: cover; }
  .kz-mini__foto .kz-avt { font-size: 0.75rem; }
  .kz-mini__txt { display: flex; flex-direction: column; gap: 0.02rem; min-width: 0; flex: 1; }
  .kz-mini__txt strong { font-family: var(--fonte-titulo); font-size: 0.9rem; color: #26332b; font-weight: 600; }
  .kz-mini__txt > span { font-size: 0.72rem; color: #8a7d5c; }
  .kz-mini__rot { font-size: 0.58rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: #a8935a; }
  .kz-mini__seta { color: #c3b587; font-size: 1.1rem; }

  /* ---------- modal parentesco ---------- */
  .kz-relacao-modal { position: fixed; inset: 0; z-index: 900; display: flex; align-items: center; justify-content: center; padding: 1rem; }
  .kz-relacao-modal[hidden] { display: none; }
  .kz-relacao-backdrop { position: absolute; inset: 0; background: rgba(24, 30, 25, 0.62); backdrop-filter: blur(2px); }
  .kz-relacao-caixa {
    position: relative;
    z-index: 1;
    background: #fffdf8;
    border: 1px solid #e6ddc7;
    border-radius: 20px;
    padding: 1.5rem 1.6rem 1.4rem;
    width: min(94vw, 620px);
    max-height: 88vh;
    overflow: auto;
    box-shadow: 0 30px 80px rgba(20, 24, 20, 0.4);
  }
  .kz-relacao-caixa h2 { margin: 0 0 0.3rem; font-family: var(--fonte-titulo); font-size: 1.4rem; color: #26332b; }
  .kz-relacao-hint { margin: 0 0 1rem; font-size: 0.85rem; color: #6c6248; line-height: 1.5; }
  .kz-relacao-escolhas { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  .kz-relacao-escolhas label { position: relative; display: block; font-size: 0.78rem; font-weight: 600; color: #5d6a5f; }
  .kz-relacao-escolhas input {
    width: 100%;
    margin-top: 0.3rem;
    padding: 0.55rem 0.8rem;
    border: 1px solid #ddd2b2;
    border-radius: 11px;
    font-size: 0.95rem;
    background: #fdfbf4;
    outline: none;
  }
  .kz-relacao-escolhas input:focus { border-color: #496b54; }
  .kz-relacao-resultado { margin: 1rem 0; padding: 0.9rem 1rem; background: #f6f1e2; border-radius: 13px; font-size: 0.88rem; line-height: 1.6; min-height: 2.6rem; color: #4c574d; }
  .kz-rel-caminho { display: flex; flex-wrap: wrap; align-items: center; gap: 0.3rem 0.15rem; margin-top: 0.4rem; }
  .kz-rel-caminho small { color: #a8935a; font-size: 0.7rem; }
  .kz-rel-pess {
    border: 1px solid #cfc3a0;
    background: #fffdf8;
    border-radius: 999px;
    padding: 0.22rem 0.75rem;
    font-size: 0.82rem;
    font-weight: 600;
    color: #38553f;
    cursor: pointer;
  }
  .kz-rel-pess:hover { background: #efe7d3; }
  .kz-rel-nota { margin: 0.5rem 0 0; font-size: 0.74rem; color: #8a7d5c; }
  .kz-relacao-acoes { display: flex; gap: 0.5rem; justify-content: flex-end; }

  @media (prefers-reduced-motion: reduce) {
    .kz-card, .kz-rail__btn, .kz-foco__det { transition: none; }
  }

  /* ---------- Roda da família ---------- */
  .kz-rod {
    position: relative;
    height: 780px;
    min-width: 0;
    overflow: hidden;
    display: block;
    padding: 1rem 1rem 0;
  }
  .kz-rod__orbit {
    position: absolute;
    top: 50%; left: 50%;
    width: calc(var(--kz-r, 200) * 2px);
    height: calc(var(--kz-r, 200) * 2px);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    border: 1.5px solid rgba(179, 160, 106, 0.6);
    background: radial-gradient(circle, rgba(73, 107, 84, 0.07) 62%, rgba(73, 107, 84, 0.02) 100%);
    box-shadow: inset 0 0 60px rgba(179, 160, 106, 0.18);
    z-index: 0;
  }
  .kz-rod__orbit::before {
    content: '';
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    border: 1px dashed rgba(179, 160, 106, 0.42);
  }
  .kz-rod__orbit::after {
    content: '';
    position: absolute;
    inset: -26px;
    border-radius: 50%;
    border: 1px dotted rgba(179, 160, 106, 0.3);
  }

  #kz-anel { position: absolute; inset: 0; z-index: 2; }
  .kz-sat {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 92px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.15rem;
    background: #fffdf8;
    border: 1.5px solid #e0d2a8;
    border-radius: 15px;
    padding: 0.3rem 0.25rem 0.38rem;
    box-shadow: 0 6px 18px rgba(64, 52, 28, 0.16);
    text-align: center;
    cursor: pointer;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .kz-sat:hover, .kz-sat:focus-visible {
    transform: translate(-50%, -50%) scale(1.06);
    box-shadow: 0 10px 26px rgba(64, 52, 28, 0.22);
    border-color: #c8b075;
    outline: none;
  }
  .kz-sat--mais { background: #f0eadb; color: #5d6a5f; }
  .kz-sat__rot { font-size: 0.52rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.12em; color: #a8935a; }
  .kz-sat__foto { width: 46px; height: 46px; border-radius: 50%; overflow: hidden; border: 2px solid #efe7d3; background: #ece4d2; flex: 0 0 auto; }
  .kz-sat__foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .kz-sat__foto .kz-retrato--placeholder { width: 100%; height: 100%; background: #f3ead4; color: #8a7d5c; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.7rem; }
  .kz-sat__nome { font-size: 0.68rem; font-weight: 700; color: #26332b; line-height: 1.15; max-width: 88px; }
  .kz-sat__anos { font-size: 0.55rem; color: #6c6248; }
  .kz-sat__mais { width: 26px; height: 26px; border-radius: 50%; background: #496b54; color: #fffdf8; display: flex; align-items: center; justify-content: center; font-size: 1rem; }
  .kz-sat[aria-hidden="true"] { opacity: 0; pointer-events: none; }

  .kz-rod__topo { position: absolute; top: 0.9rem; right: 1rem; display: flex; align-items: center; gap: 0.6rem; z-index: 5; }
  .kz-rod__tit { font-family: var(--fonte-titulo); font-size: 0.85rem; color: #26332b; letter-spacing: 0.02em; }
  .kz-rod__nav { display: flex; gap: 0.35rem; }
  .kz-rod__navbtn {
    font-family: var(--fonte-corpo); font-size: 0.72rem; font-weight: 700; color: #5d6a5f;
    background: #efe7d3; border: 1px solid #e6ddc7; border-radius: 999px; padding: 0.25rem 0.7rem; cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
  }
  .kz-rod__navbtn:hover { background: #496b54; color: #fffdf8; border-color: #496b54; }
  .kz-rod__navbtn:disabled { opacity: 0.4; cursor: default; }

  .kz-rod__rodape { position: absolute; bottom: 0.8rem; left: 0.9rem; right: 0.9rem; display: flex; align-items: center; justify-content: space-between; z-index: 5; font-size: 0.72rem; color: #6c6248; }
  .kz-rod__status strong { color: #26332b; }

  .kz-linha { stroke: #b3a06a; stroke-width: 1.2; fill: none; stroke-opacity: 0.7; }
  .kz-linha__pt { fill: #9a8c64; }
  .kz-foco__det { background: #496b54; }
  .kz-foco__det:hover { background: #38553f; }

  /* ===================== KAWAII — fofinho ❀ ===================== */
  .kz-main {
    position: relative;
    font-family: 'Zen Maru Gothic', var(--fonte-corpo, 'Segoe UI', sans-serif);
    background:
      radial-gradient(circle at 92% 8%, rgba(243, 169, 184, 0.28), transparent 44%),
      radial-gradient(circle at 4% 96%, rgba(191, 227, 205, 0.4), transparent 46%),
      radial-gradient(circle at 96% 88%, rgba(246, 211, 139, 0.28), transparent 38%),
      #fdf6ef;
  }
  .kz-floaty {
    position: absolute;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    animation: kzFloaty 6.5s ease-in-out infinite alternate;
    opacity: 0.75;
  }
  .kz-floaty--1 { top: 4%; left: 2%; font-size: 28px; color: #e9a3b2; }
  .kz-floaty--2 { top: 12%; right: 4%; font-size: 22px; color: #d4788e; animation-delay: -1.4s; }
  .kz-floaty--3 { top: 44%; right: 2%; font-size: 24px; color: #e4b95b; animation-delay: -2.8s; }
  .kz-floaty--4 { bottom: 12%; left: 3%; font-size: 26px; color: #9fdcb8; animation-delay: -4s; }
  .kz-floaty--5 { bottom: 26%; right: 30%; font-size: 20px; color: #c3aede; animation-delay: -5.2s; }
  @keyframes kzFloaty { from { transform: translateY(0) rotate(-7deg); } to { transform: translateY(-16px) rotate(9deg); } }

  /* hero rosê-sakura */
  .kz-hero { background: #241a26; }
  .kz-kanji {
    font-family: 'Zen Maru Gothic', var(--fonte-jp), serif;
    color: #f7c6cf;
    border: 2px solid rgba(247, 198, 207, 0.75);
    outline: 1px solid rgba(247, 198, 207, 0.35);
    background: rgba(60, 38, 50, 0.45);
    border-radius: 22px;
    transform: rotate(-2.5deg);
    text-shadow: 0 0 26px rgba(247, 198, 207, 0.55), 0 2px 10px rgba(0, 0, 0, 0.4);
  }
  .kz-hero__textos h1 {
    font-family: 'Zen Maru Gothic', var(--fonte-titulo), serif;
    font-weight: 900;
    background: linear-gradient(175deg, #ffffff 10%, #fbd9de 48%, #eda0b0 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: 0.035em;
    text-shadow: none;
    filter: drop-shadow(0 3px 14px rgba(237, 160, 176, 0.35));
  }
  .kz-hero__sub {
    font-family: 'Zen Maru Gothic', var(--fonte-titulo), serif;
    font-style: normal;
    font-weight: 500;
    color: #f3bfba;
    letter-spacing: 0.06em;
  }
  .kz-hero__desc { color: rgba(250, 235, 238, 0.92); }

  /* rail fofinho */
  .kz-rail {
    background: #fffdf6;
    border: 1.5px solid #f2dcd0;
    border-radius: 22px;
    box-shadow: 0 8px 24px rgba(214, 121, 143, 0.14);
  }
  .kz-rail__btn {
    font-family: 'Zen Maru Gothic', var(--fonte-corpo), sans-serif;
    font-weight: 700;
    border-radius: 16px;
    transition: background 0.22s cubic-bezier(0.2, 1.5, 0.4, 1), color 0.2s, transform 0.22s cubic-bezier(0.2, 1.5, 0.4, 1);
  }
  .kz-rail__btn:hover:not(:disabled) { background: #ffe4ea; color: #a3405f; transform: translateY(-2px) rotate(-1.2deg); }
  .kz-rail__btn:focus-visible { outline: 2px solid #d4788e; outline-offset: 2px; }

  /* busca de doces */
  .kz-busca {
    border: 2px solid #f2cdd2;
    box-shadow: 0 6px 18px rgba(217, 127, 148, 0.16);
    background: #fffdfa;
  }
  .kz-busca:focus-within {
    border-color: #e8a4b0;
    box-shadow: 0 0 0 4px rgba(232, 164, 176, 0.28), 0 10px 26px rgba(217, 127, 148, 0.22);
  }
  .kz-busca svg { stroke: #d98d9c; }
  .kz-busca input::placeholder { color: #cf9d99; font-style: italic; }
  .kz-sugestoes { border-radius: 18px; border: 1.5px solid #f2cdd2; box-shadow: 0 16px 40px rgba(214, 121, 143, 0.22); }
  .kz-sugestoes li button:hover, .kz-sugestoes li button:focus-visible { background: #ffeef1; }

  /* chips de filtro */
  .kz-filtro {
    font-family: 'Zen Maru Gothic', var(--fonte-corpo), sans-serif;
    background: #fffdf6;
    border: 1.5px solid #ecdfd0;
    box-shadow: 0 2px 6px rgba(217, 127, 148, 0.08);
  }
  .kz-filtro:hover { background: #ffeef1; border-color: #eec3c9; color: #a3405f; transform: translateY(-1px); }
  .kz-filtro[aria-selected="true"] {
    background: linear-gradient(180deg, #e98ba0 0%, #d36a86 100%);
    border-color: #d36a86;
    color: #fffdfa;
    box-shadow: 0 4px 14px rgba(211, 106, 134, 0.45);
  }
  .kz-filtro[role="tab"]:focus-visible { outline: 2px solid #d4788e; outline-offset: 1px; }

  /* palco pêssego com bolinhas */
  .kz-palco {
    background:
      radial-gradient(circle, rgba(217, 127, 148, 0.12) 1.3px, transparent 1.6px) 0 0 / 22px 22px,
      radial-gradient(circle at 86% 12%, rgba(243, 169, 184, 0.3), transparent 46%),
      radial-gradient(circle at 8% 88%, rgba(191, 227, 205, 0.4), transparent 46%),
      linear-gradient(180deg, #fff9f3 0%, #fdeee4 100%);
    border: 2px solid #f3ddd0;
    border-radius: 26px;
    box-shadow: 0 14px 44px rgba(214, 121, 143, 0.2), inset 0 1px 0 #fffdfa;
  }
  .kz-palco::before {
    background-image: radial-gradient(circle at 50% 100%, transparent 22%, rgba(217, 127, 148, 0.09) 23%, rgba(217, 127, 148, 0.09) 25%, transparent 26%, transparent 33%, rgba(217, 127, 148, 0.075) 34%, rgba(217, 127, 148, 0.075) 36%, transparent 37%);
  }
  .kz-rod__tit {
    font-family: 'Zen Maru Gothic', var(--fonte-titulo), serif;
    font-weight: 800;
    color: #a3405f;
    letter-spacing: 0.04em;
  }
  .kz-rod__navbtn {
    font-family: 'Zen Maru Gothic', var(--fonte-corpo), sans-serif;
    color: #a3405f;
    background: #fffdfa;
    border: 1.5px solid #eec3c9;
    box-shadow: 0 2px 6px rgba(217, 127, 148, 0.14);
  }
  .kz-rod__navbtn:hover { background: linear-gradient(180deg, #e98ba0, #d36a86); color: #fffdfa; border-color: #d36a86; }
  .kz-rod__rodape { color: #8a6258; font-family: 'Zen Maru Gothic', var(--fonte-corpo), sans-serif; }
  .kz-rod__rodape strong { color: #7c3b4c; }

  /* anel orbital rosê */
  .kz-rod__orbit {
    border: 2px solid #f0c3ca;
    background: radial-gradient(circle, rgba(248, 213, 220, 0.45) 62%, rgba(255, 255, 255, 0) 100%);
    box-shadow: inset 0 0 70px rgba(243, 169, 184, 0.4);
  }
  .kz-rod__orbit::before { border: 1.5px dashed rgba(232, 164, 176, 0.6); }
  .kz-rod__orbit::after { border: 1.5px dotted rgba(159, 220, 184, 0.55); }
  .kz-linha { stroke: #dfa0ac; stroke-width: 1.8; stroke-linecap: round; }
  .kz-linha__pt { fill: #fff5f3; stroke: #dfa0ac; stroke-width: 1.6; }

  /* disco central — pêssego corado */
  .kz-foco {
    background: radial-gradient(circle at 50% 30%, #fffaf0 0%, #fce0d4 46%, #f5c0ae 84%, #ecab99 100%);
    border: 3px solid #fffdfa;
    box-shadow: 0 22px 48px rgba(214, 121, 143, 0.36), 0 0 0 5px #f7d0c7, 0 0 0 9px rgba(255, 253, 250, 0.78), inset 0 -8px 18px rgba(188, 108, 96, 0.2), inset 0 5px 12px #fffdfa;
  }
  .kz-foco::after { border: 2px dashed rgba(217, 127, 148, 0.55); inset: 9px; }
  .kz-foco[data-tem-foto="1"] {
    border-color: #fffdfa;
    box-shadow: 0 22px 52px rgba(214, 121, 143, 0.42), 0 0 0 5px #f2a9b8, 0 0 0 9px rgba(255, 253, 250, 0.78), inset 0 -8px 18px rgba(188, 108, 96, 0.22), inset 0 5px 12px #fffdfa;
  }
  .kz-foco[data-tem-foto="1"]::after { border-color: rgba(211, 106, 134, 0.6); }
  .kz-foco__selo {
    font-family: 'Zen Maru Gothic', var(--fonte-corpo), sans-serif;
    background: linear-gradient(180deg, #e98ba0, #d36a86);
    color: #fffdfa;
    border-radius: 999px;
    padding: 0.34rem 1.05rem;
    box-shadow: 0 4px 12px rgba(211, 106, 134, 0.45);
    transform: rotate(-2deg);
  }
  .kz-foco__nome {
    font-family: 'Zen Maru Gothic', var(--fonte-titulo), serif;
    font-weight: 900;
    color: #4f333e;
  }
  .kz-foco__anos { color: #a5716d; font-weight: 500; }
  .kz-foco__ger { color: #d15f7f; font-weight: 700; }
  .kz-foco__foto {
    position: relative;
    border: 4px solid #fffdfa;
    box-shadow: 0 10px 24px rgba(214, 121, 143, 0.35), 0 0 0 2px #f2a9b8;
    background: #fde3d7;
  }
  .kz-foco[data-tem-foto="1"] .kz-foco__foto { box-shadow: 0 12px 26px rgba(211, 106, 134, 0.4), 0 0 0 2px #d36a86; }
  .kz-avt--foco { color: #d15f7f; }
  /* bochechas coradas no placeholder */
  .kz-foco__foto::before, .kz-foco__foto::after {
    content: '';
    position: absolute;
    bottom: 22%;
    width: 16%;
    height: 10%;
    border-radius: 50%;
    background: rgba(244, 130, 152, 0.55);
    filter: blur(2px);
    pointer-events: none;
  }
  .kz-foco__foto::before { left: 20%; }
  .kz-foco__foto::after { right: 20%; }
  .kz-foco__det {
    font-family: 'Zen Maru Gothic', var(--fonte-corpo), sans-serif;
    background: linear-gradient(180deg, #e98ba0 0%, #d36a86 100%);
    border: 0;
    color: #fffdfa;
    padding: 0.48rem 1.25rem;
    border-radius: 999px;
    box-shadow: 0 6px 16px rgba(211, 106, 134, 0.45);
    transition: transform 0.2s cubic-bezier(0.2, 1.6, 0.4, 1), box-shadow 0.2s, filter 0.2s;
  }
  .kz-foco__det:hover { background: linear-gradient(180deg, #ee9cae, #da7592); transform: translateY(-2px) scale(1.04); box-shadow: 0 10px 22px rgba(211, 106, 134, 0.5); filter: brightness(1.04); }
  .kz-foco__det:focus-visible { outline: 2px solid #a3405f; outline-offset: 2px; }

  /* satélites doces, coloridos por parentesco */
  .kz-sat {
    font-family: 'Zen Maru Gothic', var(--fonte-corpo), sans-serif;
    background: #fffdfa;
    border: 2px solid #efd9cd;
    border-radius: 20px;
    box-shadow: 0 7px 17px rgba(214, 121, 143, 0.16);
    transition: transform 0.22s cubic-bezier(0.2, 1.6, 0.4, 1), box-shadow 0.22s, border-color 0.2s;
  }
  .kz-sat:hover, .kz-sat:focus-visible {
    transform: translate(-50%, -50%) scale(1.09) rotate(-1.4deg);
    box-shadow: 0 13px 28px rgba(214, 121, 143, 0.3);
    border-color: #e7b3ac;
    outline: none;
  }
  .kz-sat__rot {
    border-radius: 999px;
    padding: 0.14rem 0.52rem;
    font-size: 0.5rem;
    background: #fbe6d8;
    color: #8a5230;
    letter-spacing: 0.1em;
  }
  .kz-sat__nome { font-weight: 700; color: #533f45; }
  .kz-sat__anos { color: #a5716d; }
  .kz-sat__foto { box-shadow: 0 0 0 2px #f4d7cd; }
  .kz-sat--mais {
    background: linear-gradient(160deg, #efe2f7 0%, #f7dcea 100%);
    border: 2px solid #d3bfe2;
    color: #6d4a5f;
