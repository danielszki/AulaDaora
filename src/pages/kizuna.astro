  .kz-painel { position: fixed; top: 0; right: 0; bottom: 0; width: min(380px, 92vw); background: var(--papel); border-left: 1px solid var(--borda); box-shadow: -8px 0 32px rgba(0,0,0,0.18); padding: 1.2rem; overflow: auto; z-index: 60; }
