---
import Base from '../layouts/Base.astro';
import { pessoas, historias, eventos } from '../data/familia';

const dados = pessoas.map((p) => ({
  id: p.id,
  nome: p.nome,
  nascimento: p.nascimento || '',
  falecimento: p.falecimento || '',
  geracao: p.geracao,
  pais: p.pais,
  conjuges: p.conjuges,
  exDe: p.exDe || [],
  foto: p.foto || '',
  bio: p.bio || '',
  local: p.local || '',
  profissao: p.profissao || '',
  observacao: p.observacao || '',
}));

const eventosJSON = eventos.map((e) => ({ ano: e.ano, titulo: e.titulo, pessoa: e.pessoa }));
---

<Base title="Kizuna — Laços da Família Kato" description="Cada pessoa tem uma história. Cada história nos conecta. Explore os vínculos da Família Kato pessoa a pessoa.">
  <!-- ===================== HERO JAPONÊS ===================== -->
  <section class="kz-hero">
    <svg class="kz-hero__paisagem" viewBox="0 0 1440 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="kzCeu" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#202d26" />
          <stop offset="0.55" stop-color="#33443a" />
          <stop offset="1" stop-color="#4c5a48" />
        </linearGradient>
        <linearGradient id="kzAquecer" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#000000" stop-opacity="0" />
          <stop offset="1" stop-color="#7a6a45" stop-opacity="0.22" />
        </linearGradient>
      </defs>
      <rect width="1440" height="300" fill="url(#kzCeu)" />
      <rect width="1440" height="300" fill="url(#kzAquecer)" />
      <!-- montanhas distantes -->
      <path d="M0 218 L160 150 L300 205 L430 140 L470 250 L850 250 L900 165 L1050 215 L1200 150 L1330 210 L1440 165 L1440 300 L0 300 Z" fill="#2c3a31" opacity="0.9" />
      <!-- Monte Fuji -->
      <path d="M430 252 L640 78 L852 252 Z" fill="#37453c" />
      <path d="M584 126 L640 78 L696 126 L674 117 L640 130 L612 115 Z" fill="#dfe6dc" opacity="0.85" />
      <!-- névoa -->
      <ellipse cx="640" cy="258" rx="520" ry="26" fill="#cdd8cc" opacity="0.14" />
      <ellipse cx="240" cy="270" rx="360" ry="22" fill="#cdd8cc" opacity="0.1" />
      <!-- pagode -->
      <g fill="#151d18">
        <rect x="1146" y="120" width="8" height="132" />
        <path d="M1110 138 L1190 138 L1176 152 L1124 152 Z" />
        <rect x="1122" y="152" width="56" height="22" />
        <path d="M1098 174 L1202 174 L1186 190 L1114 190 Z" />
        <rect x="1116" y="190" width="68" height="24" />
        <path d="M1084 214 L1216 214 L1198 232 L1102 232 Z" />
        <rect x="1110" y="232" width="80" height="20" />
        <rect x="1148" y="98" width="4" height="24" />
      </g>
      <!-- cerejeira -->
      <g stroke="#1a231c" stroke-width="7" fill="none" stroke-linecap="round">
        <path d="M1440 16 C1330 34 1262 66 1212 118" />
        <path d="M1330 48 C1300 74 1284 102 1280 132" />
        <path d="M1262 78 C1236 88 1218 104 1206 124" />
      </g>
      <g fill="#e5aeb8">
        <circle cx="1382" cy="40" r="7" /><circle cx="1348" cy="60" r="6" /><circle cx="1316" cy="78" r="7" />
        <circle cx="1288" cy="98" r="6" /><circle cx="1262" cy="118" r="7" /><circle cx="1238" cy="140" r="6" />
        <circle cx="1306" cy="52" r="5" /><circle cx="1276" cy="66" r="5" /><circle cx="1250" cy="84" r="6" />
        <circle cx="1298" cy="118" r="6" /><circle cx="1284" cy="146" r="5" /><circle cx="1222" cy="106" r="5" />
        <circle cx="1204" cy="132" r="6" /><circle cx="1360" cy="30" r="5" /><circle cx="1416" cy="24" r="6" />
      </g>
      <g fill="#f2cdd4" opacity="0.8">
        <circle cx="1330" cy="94" r="3" /><circle cx="1268" cy="150" r="3" /><circle cx="1200" cy="164" r="3" /><circle cx="1388" cy="66" r="3" />
      </g>
    </svg>
    <div class="kz-hero__conteudo container">
      <div class="kz-kanji" aria-hidden="true">絆</div>
      <div class="kz-hero__textos">
        <h1>Kizuna</h1>
        <p class="kz-hero__sub">Laços que atravessam gerações</p>
        <p class="kz-hero__desc">Explore os parentes ao redor e descubra as conexões que formam nossa história.</p>
      </div>
    </div>
  </section>

  <!-- ===================== ÁREA PRINCIPAL ===================== -->
  <section class="kz-main">
    <div class="container kz-main__grid">

      <!-- barra lateral de comandos -->
      <nav class="kz-rail" aria-label="Comandos do Kizuna">
        <button type="button" class="kz-rail__btn" id="kz-inicio" aria-label="Início da exploração (Yotaro Kato)">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="8" cy="8" r="3.2" /><circle cx="16" cy="9" r="2.6" /><path d="M3.5 19c.6-3.2 2.4-5 4.5-5s3.9 1.8 4.5 5" /><path d="M13 18.6c.5-2.4 1.8-3.8 3.4-3.8 1.7 0 3 1.4 3.5 3.8" /></svg>
          <span>Explorar</span>
        </button>
        <button type="button" class="kz-rail__btn" id="kz-voltar" aria-label="Voltar ao familiar anterior" disabled>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 6l-6 6 6 6" /></svg>
          <span>Voltar</span>
        </button>
        <button type="button" class="kz-rail__btn" id="kz-centrar" aria-label="Recentralizar na pessoa selecionada">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="7" height="7" rx="1.5" /><rect x="13" y="4" width="7" height="7" rx="1.5" /><rect x="4" y="13" width="7" height="7" rx="1.5" /><rect x="13" y="13" width="7" height="7" rx="1.5" /></svg>
          <span>Centralizar</span>
        </button>
        <button type="button" class="kz-rail__btn" id="kz-relacao" aria-label="Como somos parentes?">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 14.5l5-5" /><path d="M7 12l-2.2 2.2a3.1 3.1 0 004.4 4.4L11.5 16" /><path d="M17 12l2.2-2.2a3.1 3.1 0 00-4.4-4.4L12.5 8" /></svg>
          <span>Parentesco</span>
        </button>
        <a class="kz-rail__btn" href="/arvore" aria-label="Abrir a árvore genealógica tradicional">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="3" width="6" height="4.4" rx="1" /><rect x="3" y="16.6" width="6" height="4.4" rx="1" /><rect x="15" y="16.6" width="6" height="4.4" rx="1" /><path d="M12 7.4v4.4M6 16.6v-2.4h12v2.4M12 11.8v2.4" /></svg>
          <span>Árvore</span>
        </a>
      </nav>

      <!-- palco -->
      <div class="kz-palco-col">
        <div class="kz-busca">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="M20 20l-3.5-3.5" /></svg>
          <input type="search" id="kz-busca-input" placeholder="Pesquisar familiar pelo nome…" autocomplete="off" aria-label="Pesquisar familiar pelo nome" />
          <ul id="kz-sugestoes" class="kz-sugestoes" hidden></ul>
        </div>

        <div class="kz-palco" id="kz-palco">
          <svg class="kz-linhas" id="kz-linhas" aria-hidden="true"></svg>
          <div class="kz-zona kz-zona--topo" id="kz-zona-pais"></div>
          <div class="kz-zona kz-zona--esq" id="kz-zona-irmaos"></div>
          <div class="kz-centro" id="kz-centro"></div>
          <div class="kz-zona kz-zona--dir" id="kz-zona-conjuge"></div>
          <div class="kz-zona kz-zona--baixo" id="kz-zona-filhos"></div>
          <div class="kz-overlay" id="kz-overlay" hidden></div>
        </div>

        <div class="kz-rodape">
          <p class="kz-rodape__dica">Clique em um parente para ver mais detalhes e explorar suas conexões.</p>
          <p class="kz-rodape__cont" id="kz-contador"></p>
        </div>
      </div>

      <!-- painel de detalhes -->
      <aside class="kz-painel" id="kz-painel" aria-label="Detalhes da pessoa selecionada">
        <header class="kz-painel__topo">
          <span class="kz-painel__marca" aria-hidden="true">✿</span>
          <h2>Detalhes da pessoa</h2>
          <button type="button" class="kz-painel__fechar" id="kz-painel-fechar" aria-label="Fechar painel">×</button>
        </header>
        <div class="kz-painel__corpo" id="kz-painel-conteudo"></div>
      </aside>
    </div>
  </section>

  <!-- ===================== MODAL PARENTESCO ===================== -->
  <div class="kz-relacao-modal" id="kz-relacao-modal" hidden>
    <div class="kz-relacao-backdrop" data-close></div>
    <div class="kz-relacao-caixa" role="dialog" aria-modal="true" aria-labelledby="kz-rel-titulo">
      <h2 id="kz-rel-titulo">Como somos parentes?</h2>
      <p class="kz-relacao-hint">Escolha duas pessoas. O caminho é calculado apenas com os vínculos registrados — nada é inventado.</p>
      <div class="kz-relacao-escolhas">
        <label>Primeira pessoa
          <input type="search" id="kz-rel-a" placeholder="Pesquisar…" autocomplete="off" />
        </label>
        <label>Segunda pessoa
          <input type="search" id="kz-rel-b" placeholder="Pesquisar…" autocomplete="off" />
        </label>
      </div>
      <div class="kz-relacao-resultado" id="kz-rel-resultado"></div>
      <div class="kz-relacao-acoes">
        <button type="button" class="btn btn--ghost" data-close>Fechar</button>
        <button type="button" class="btn" id="kz-rel-calcular">Calcular caminho</button>
      </div>
    </div>
  </div>

  <script type="application/json" id="kz-dados" set:html={JSON.stringify(dados)}></script>
  <script type="application/json" id="kz-eventos" set:html={JSON.stringify(eventosJSON)}></script>
</Base>

<script>
  import { fetchPessoas, isCloudEnabled } from '../scripts/data';

  const dataEl = document.getElementById('kz-dados');
  const evEl = document.getElementById('kz-eventos');
  const PESSOAS = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];
  const EVENTOS = evEl ? JSON.parse(evEl.textContent || '[]') : [];
  const byId = new Map(PESSOAS.map((p) => [p.id, p]));

  const $ = (id) => document.getElementById(id);
  const palco = $('kz-palco');
  const centroEl = $('kz-centro');
  const zonaPais = $('kz-zona-pais');
  const zonaIrmaos = $('kz-zona-irmaos');
  const zonaConjuge = $('kz-zona-conjuge');
  const zonaFilhos = $('kz-zona-filhos');
  const linhasSvg = $('kz-linhas');
  const painel = $('kz-painel');
  const painelCont = $('kz-painel-conteudo');
  const busca = $('kz-busca-input');
  const sugestoes = $('kz-sugestoes');
  const btnVoltar = $('kz-voltar');
  const btnCentrar = $('kz-centrar');
  const btnInicio = $('kz-inicio');
  const btnRelacao = $('kz-relacao');
  const modalRel = $('kz-relacao-modal');
  const contador = $('kz-contador');

  const reduzido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const LIMITE = 6;
  const ENTRADA = 'yotaro-kato';

  let selecionado = null;
  const historico = [];

  /* ---------- utilitários ---------- */
  function esc(s) {
    return String(s || '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  }
  function geracaoLabel(g) {
    const o = ['1ª', '2ª', '3ª', '4ª', '5ª', '6ª', '7ª', '8ª', '9ª', '10ª'];
    return g === 0 ? 'Antepassados' : (o[g - 1] || g + 'ª') + ' geração';
  }
  function anos(p) {
    if (p.nascimento && p.falecimento) return `${p.nascimento} – ${p.falecimento}`;
    if (p.nascimento) return p.nascimento + ' –';
    if (p.falecimento) return '† ' + p.falecimento;
    return 'Datas a confirmar';
  }
  function iniciais(nome) {
    return nome.split(' ').map((n) => n[0]).slice(0, 2).join('').toUpperCase();
  }
  /* consultas genealógicas — sempre a partir dos dados reais */
  function paisDe(id) { const p = byId.get(id); return (p?.pais || []).map((x) => byId.get(x)).filter(Boolean); }
  function filhosDe(id) {
    return PESSOAS.filter((p) => p.pais.includes(id))
      .sort((a, b) => (a.nascimento || '9999').localeCompare(b.nascimento || '9999'));
  }
  function irmaosDe(id) {
    const p = byId.get(id);
    if (!p || !p.pais.length) return [];
    const ids = new Set(p.pais);
    return PESSOAS.filter((q) => q.id !== id && q.pais.some((pp) => ids.has(pp)));
  }
  function conjugesDe(id) { const p = byId.get(id); return (p?.conjuges || []).map((x) => byId.get(x)).filter(Boolean); }
  function exDe(id) { const p = byId.get(id); return (p?.exDe || []).map((x) => byId.get(x)).filter(Boolean); }

  /* rótulos de vínculo — neutros quando o sexo não está registrado nos dados */

  /* ---------- cartões ---------- */
  function fotoHTML(p, classe) {
    if (p.foto) {
      return `<span class="kz-retrato kz-retrato--real ${classe || ''}" aria-hidden="true"><img src="${esc(p.foto)}" alt="Foto de ${esc(p.nome)}" loading="lazy" decoding="async" /></span>`;
    }
    return `<span class="kz-retrato kz-retrato--placeholder ${classe || ''}" aria-hidden="true">${esc(iniciais(p.nome))}</span>`;
  }

  function cardHTML(p, rotulo) {
    return `<button type="button" class="kz-card" data-id="${esc(p.id)}" aria-label="Selecionar ${esc(p.nome)}${rotulo ? ', ' + esc(rotulo) : ''}">
      <span class="kz-card__foto">${fotoHTML(p)}</span>
      <span class="kz-card__txt">
        ${rotulo ? `<span class="kz-card__rot">${esc(rotulo)}</span>` : ''}
        <strong class="kz-card__nome">${esc(p.nome)}</strong>
        <span class="kz-card__anos">${esc(anos(p))}</span>
        <span class="kz-card__ger">${esc(geracaoLabel(p.geracao))}</span>
      </span>
    </button>`;
  }

  function zonaHTML(titulo, lista, chave, rotuloFn, limite) {
    if (!lista.length) return '';
    const lim = limite || LIMITE;
    const vis = lista.slice(0, lim);
    const resto = lista.length - vis.length;
    return `<div class="kz-grupo">
      <h3 class="kz-grupo__tit">${esc(titulo)}</h3>
      <div class="kz-grupo__cards">${vis.map((p, i) => cardHTML(p, rotuloFn ? rotuloFn(p, i) : titulo.replace(/s$/, ''))).join('')}</div>
      ${resto > 0 ? `<button type="button" class="kz-grupo__mais" data-ver-todos="${esc(chave)}" data-titulo="${esc(titulo)}">+ ${resto} — Ver todos (${lista.length})</button>` : ''}
    </div>`;
  }

  /* overlay com todos os membros de um grupo grande */
  const overlay = $('kz-overlay');
  function abrirOverlay(chave, titulo) {
    const lista = listasAtuais[chave] || [];
    if (!lista.length) return;
    const rotulos = { pais: 'Pai/Mãe', irmaos: 'Irmão(a)', conjuges: 'Cônjuge', filhos: 'Filho(a)' };
    overlay.innerHTML = `<div class="kz-overlay__fundo" data-fechar-overlay></div>
      <div class="kz-overlay__caixa" role="dialog" aria-modal="true" aria-label="${esc(titulo)}">
        <header class="kz-overlay__topo">
          <h3>${esc(titulo)} <span>${lista.length}</span></h3>
          <button type="button" data-fechar-overlay aria-label="Fechar lista">×</button>
        </header>
        <div class="kz-overlay__cards">${lista.map((p) => cardHTML(p, rotulos[chave] || titulo)).join('')}</div>
      </div>`;
    overlay.hidden = false;
    overlay.querySelectorAll('[data-fechar-overlay]').forEach((el) => el.addEventListener('click', fecharOverlay));
    overlay.querySelectorAll('.kz-card').forEach((btn) => btn.addEventListener('click', () => { fecharOverlay(); selecionar(btn.dataset.id); }));
    const f = overlay.querySelector('[data-fechar-overlay]');
    if (f) f.focus();
  }
  function fecharOverlay() { overlay.hidden = true; overlay.innerHTML = ''; }
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !overlay.hidden) fecharOverlay(); });

  /* ---------- render do palco ---------- */
  let listasAtuais = {};

  function render(id) {
    const p = byId.get(id);
    if (!p) return;
    const ps = paisDe(id);
    const cs = conjugesDe(id);
    const xs = exDe(id);
    const is = irmaosDe(id);
    const fs = filhosDe(id);
    listasAtuais = { pais: ps, conjuges: cs.concat(xs), irmaos: is, filhos: fs };

    const bioCurta = p.bio ? (p.bio.length > 150 ? p.bio.slice(0, 148).trim() + '…' : p.bio) : '';
    centroEl.innerHTML = `<article class="kz-foco" data-tem-foto="${p.foto ? 1 : 0}">
      <span class="kz-foco__selo">Pessoa em foco</span>
      <div class="kz-foco__foto">${fotoHTML(p, 'kz-avt--foco')}</div>
      <h2 class="kz-foco__nome">${esc(p.nome)}</h2>
      <p class="kz-foco__anos">${esc(anos(p))}</p>
      <p class="kz-foco__ger">${esc(geracaoLabel(p.geracao))}</p>
      ${bioCurta ? `<p class="kz-foco__bio">${esc(bioCurta)}</p>` : ''}
      <span class="kz-foco__orn" aria-hidden="true">✿</span>
      <button type="button" class="kz-foco__det" data-abrir-painel>Ver detalhes</button>
    </article>`;

    zonaPais.innerHTML = zonaHTML('Pais', ps, 'pais', () => 'Pai/Mãe', 2);
    zonaIrmaos.innerHTML = zonaHTML('Irmãos', is, 'irmaos', () => 'Irmão(a)', 3);
    const csRot = (pp) => (xs.some((x) => x.id === pp.id) ? 'Ex-cônjuge' : 'Cônjuge');
    zonaConjuge.innerHTML = zonaHTML(cs.length + xs.length > 1 ? 'Cônjuges' : 'Cônjuge', cs.concat(xs), 'conjuges', csRot, 2);
    zonaFilhos.innerHTML = zonaHTML('Filhos', fs, 'filhos', () => 'Filho(a)', 3);

    ligarEventos();
    requestAnimationFrame(desenharLinhas);
    atualizarURL(id);
    renderPainel(p);
    const total = ps.length + cs.length + xs.length + is.length + fs.length;
    contador.textContent = total
      ? `${total} ${total === 1 ? 'parente relacionado' : 'parentes relacionados'}`
      : 'Nenhum vínculo registrado para esta pessoa.';

    if (!reduzido) {
      [zonaPais, zonaIrmaos, zonaConjuge, zonaFilhos, centroEl].forEach((z) => {
        z.classList.remove('kz-in');
        void z.offsetWidth;
        z.classList.add('kz-in');
      });
    }
  }

  function ligarEventos() {
    document.querySelectorAll('.kz-palco .kz-card').forEach((btn) => {
      btn.addEventListener('click', () => selecionar(btn.dataset.id));
    });
    document.querySelectorAll('[data-ver-todos]').forEach((btn) => {
      btn.addEventListener('click', () => abrirOverlay(btn.dataset.verTodos, btn.dataset.titulo));
    });
    const ab = centroEl.querySelector('[data-abrir-painel]');
    if (ab) ab.addEventListener('click', () => {
      painel.classList.add('kz-painel--aberto');
      const f = painel.querySelector('button, a');
      if (f) f.focus();
    });
  }

  /* ---------- conexões SVG ---------- */
  function desenharLinhas() {
    if (!palco || !linhasSvg) return;
    const foco = centroEl.querySelector('.kz-foco');
    if (!foco) return;
    const pr = palco.getBoundingClientRect();
    const fr = foco.getBoundingClientRect();
    const cx = fr.left + fr.width / 2 - pr.left;
    const cy = fr.top + fr.height / 2 - pr.top;
    let svg = '';
    const pontos = (zona, lado) => {
      zona.querySelectorAll('.kz-card').forEach((card) => {
        const r = card.getBoundingClientRect();
        let x1 = cx, y1 = cy, x2, y2;
        if (lado === 'top') { x2 = r.left + r.width / 2 - pr.left; y2 = r.bottom - pr.top + 2; y1 = fr.top - pr.top - 2; }
        else if (lado === 'bottom') { x2 = r.left + r.width / 2 - pr.left; y2 = r.top - pr.top - 2; y1 = fr.bottom - pr.top + 2; }
        else if (lado === 'left') { x2 = r.right - pr.left + 2; y2 = r.top + r.height / 2 - pr.top; x1 = fr.left - pr.left - 2; }
        else { x2 = r.left - pr.left - 2; y2 = r.top + r.height / 2 - pr.top; x1 = fr.right - pr.left + 2; }
        const mx = (x1 + x2) / 2;
        const my = (y1 + y2) / 2;
        const horizontal = lado === 'left' || lado === 'right';
        const d = horizontal
          ? `M${x1} ${y1} C${mx} ${y1} ${mx} ${y2} ${x2} ${y2}`
          : `M${x1} ${y1} C${x1} ${my} ${x2} ${my} ${x2} ${y2}`;
        svg += `<path class="kz-linha" d="${d}" />`;
        svg += `<circle class="kz-linha__pt" cx="${x2}" cy="${y2}" r="3.5" />`;
      });
    };
    pontos(zonaPais, 'top');
    pontos(zonaIrmaos, 'left');
    pontos(zonaConjuge, 'right');
    pontos(zonaFilhos, 'bottom');
    linhasSvg.setAttribute('width', pr.width);
    linhasSvg.setAttribute('height', pr.height);
    linhasSvg.setAttribute('viewBox', `0 0 ${pr.width} ${pr.height}`);
    linhasSvg.innerHTML = svg;
  }

  /* ---------- painel de detalhes ---------- */
  function miniHTML(p, rot) {
    return `<button type="button" class="kz-mini" data-nav="${esc(p.id)}">
      <span class="kz-mini__foto">${fotoHTML(p)}</span>
      <span class="kz-mini__txt">
        ${rot ? `<span class="kz-mini__rot">${esc(rot)}</span>` : ''}
        <strong>${esc(p.nome)}</strong>
        <span>${esc(anos(p))} · ${esc(geracaoLabel(p.geracao))}</span>
      </span>
      <span class="kz-mini__seta" aria-hidden="true">›</span>
    </button>`;
  }

  function renderPainel(p) {
    const ps = paisDe(p.id);
    const cs = conjugesDe(p.id);
    const xs = exDe(p.id);
    const is = irmaosDe(p.id);
    const fs = filhosDe(p.id);
    const evs = EVENTOS.filter((e) => e.pessoa === p.id);
    const obsCurta = p.observacao && p.observacao !== p.bio ? p.observacao : '';

    painelCont.innerHTML = `
      <div class="kz-painel__ident">
        <span class="kz-painel__foto">${fotoHTML(p, 'kz-avt--painel')}</span>
        <div>
          <h3>${esc(p.nome)}</h3>
          <p class="kz-painel__anos">${esc(anos(p))}</p>
          <p class="kz-painel__ger">${esc(geracaoLabel(p.geracao))}</p>
        </div>
      </div>
      ${p.bio ? `<section class="kz-painel__sec"><h4><span aria-hidden="true">☰</span> Sobre</h4><p>${esc(p.bio)}</p></section>` : ''}
      ${p.local || p.profissao ? `<section class="kz-painel__sec"><h4><span aria-hidden="true">◉</span> Vida</h4>${p.local ? `<p><strong>Local:</strong> ${esc(p.local)}</p>` : ''}${p.profissao ? `<p><strong>Profissão:</strong> ${esc(p.profissao)}</p>` : ''}</section>` : ''}
      ${obsCurta ? `<section class="kz-painel__sec"><h4><span aria-hidden="true">✎</span> Observações</h4><p>${esc(obsCurta)}</p></section>` : ''}
      ${ps.length ? `<section class="kz-painel__sec"><h4><span aria-hidden="true">⚭</span> Pais</h4>${ps.map((x) => miniHTML(x, 'Pai/Mãe')).join('')}</section>` : ''}
      ${cs.length + xs.length ? `<section class="kz-painel__sec"><h4><span aria-hidden="true">♡</span> ${cs.length + xs.length > 1 ? 'Cônjuges' : 'Cônjuge'}</h4>${cs.concat(xs).map((x) => miniHTML(x, xs.some((e) => e.id === x.id) ? 'Ex-cônjuge' : 'Cônjuge')).join('')}</section>` : ''}
      ${is.length ? `<section class="kz-painel__sec"><h4><span aria-hidden="true">⚭</span> Irmãos</h4>${is.map((x) => miniHTML(x, 'Irmão(a)')).join('')}</section>` : ''}
      ${fs.length ? `<section class="kz-painel__sec"><h4><span aria-hidden="true">⚭</span> Filhos <span class="kz-painel__n">${fs.length}</span></h4>${fs.map((x) => miniHTML(x, 'Filho(a)')).join('')}</section>` : ''}
      ${evs.length ? `<section class="kz-painel__sec"><h4><span aria-hidden="true">◷</span> Acontecimentos</h4><ul class="kz-painel__evs">${evs.map((e) => `<li><strong>${esc(e.ano)}</strong> — ${esc(e.titulo)}</li>`).join('')}</ul></section>` : ''}
      ${!ps.length && !cs.length && !xs.length && !is.length && !fs.length ? '<section class="kz-painel__sec"><p>Nenhum vínculo familiar registrado até o momento.</p></section>' : ''}
      <div class="kz-painel__acoes">
        <a class="btn" href="/pessoa/${esc(p.id)}">Ver perfil completo</a>
        <a class="btn btn--ghost" href="/arvore?focar=${esc(p.id)}">Ver na árvore</a>
      </div>`;

    painelCont.querySelectorAll('[data-nav]').forEach((a) => {
      a.addEventListener('click', () => selecionar(a.dataset.nav));
    });
  }

  /* ---------- seleção e navegação ---------- */
  function selecionar(id, silencioso) {
    if (!byId.has(id)) return;
    if (!silencioso) {
      if (selecionado && selecionado !== id) historico.push(selecionado);
      if (historico.length > 30) historico.shift();
    }
    selecionado = id;
    btnVoltar.disabled = historico.length === 0;
    render(id);
  }

  function voltar() {
    const anterior = historico.pop();
    if (!anterior) return;
    selecionado = anterior;
    btnVoltar.disabled = historico.length === 0;
    render(anterior);
  }

  function atualizarURL(id) {
    const u = new URL(window.location.href);
    u.searchParams.set('pessoa', id);
    window.history.replaceState({}, '', u.toString());
  }

  /* ---------- pesquisa ---------- */
  function filtrar(q) {
    q = (q || '').toLowerCase().trim();
    if (!q) return [];
    return PESSOAS.filter((p) => p.nome.toLowerCase().includes(q)).slice(0, 8);
  }
  function renderSug(el, q, onPick) {
    const res = filtrar(q);
    if (!res.length) { el.hidden = true; el.innerHTML = ''; return; }
    el.hidden = false;
    el.innerHTML = res.map((p) => `<li><button type="button" data-id="${esc(p.id)}"><strong>${esc(p.nome)}</strong><small>${esc(anos(p))} · ${esc(geracaoLabel(p.geracao))}</small></button></li>`).join('');
    el.querySelectorAll('button').forEach((b) => b.addEventListener('click', () => onPick(b.dataset.id)));
  }
  busca.addEventListener('input', () => renderSug(sugestoes, busca.value, (id) => {
    busca.value = byId.get(id).nome;
    sugestoes.hidden = true;
    selecionar(id);
    document.querySelector('.kz-palco')?.scrollIntoView({ behavior: reduzido ? 'auto' : 'smooth', block: 'nearest' });
  }));
  document.addEventListener('click', (e) => {
    if (!busca.contains(e.target) && !sugestoes.contains(e.target)) sugestoes.hidden = true;
  });

  /* ---------- comandos ---------- */
  btnVoltar.addEventListener('click', voltar);
  btnCentrar.addEventListener('click', () => {
    if (!selecionado) return;
    render(selecionado);
    centroEl.scrollIntoView({ behavior: reduzido ? 'auto' : 'smooth', block: 'center' });
  });
  btnInicio.addEventListener('click', () => {
    historico.length = 0;
    selecionar(byId.has(ENTRADA) ? ENTRADA : PESSOAS[0].id);
  });
  $('kz-painel-fechar').addEventListener('click', () => painel.classList.remove('kz-painel--aberto'));

  /* ---------- modal parentesco ---------- */
  function abrirModal() { modalRel.hidden = false; document.body.style.overflow = 'hidden'; $('kz-rel-a').focus(); }
  function fecharModal() { modalRel.hidden = true; document.body.style.overflow = ''; }
  btnRelacao.addEventListener('click', abrirModal);
  modalRel.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', fecharModal));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modalRel.hidden) fecharModal(); });

  const relA = $('kz-rel-a'), relB = $('kz-rel-b');
  let relAId = null, relBId = null;
  const wrapA = document.createElement('ul'); wrapA.className = 'kz-sugestoes'; wrapA.hidden = true; relA.after(wrapA);
  const wrapB = document.createElement('ul'); wrapB.className = 'kz-sugestoes'; wrapB.hidden = true; relB.after(wrapB);
  relA.addEventListener('input', () => renderSug(wrapA, relA.value, (id) => { relA.value = byId.get(id).nome; relAId = id; wrapA.hidden = true; }));
  relB.addEventListener('input', () => renderSug(wrapB, relB.value, (id) => { relB.value = byId.get(id).nome; relBId = id; wrapB.hidden = true; }));
  document.addEventListener('click', (e) => {
    if (!relA.contains(e.target) && !wrapA.contains(e.target)) wrapA.hidden = true;
    if (!relB.contains(e.target) && !wrapB.contains(e.target)) wrapB.hidden = true;
  });

  function bfs(a, b) {
    if (a === b) return [a];
    const vis = new Set([a]);
    const prev = new Map();
    const fila = [a];
    while (fila.length) {
      const cur = fila.shift();
      const p = byId.get(cur);
      if (!p) continue;
      const viz = [...p.pais, ...p.conjuges, ...(p.exDe || []), ...PESSOAS.filter((x) => x.pais.includes(cur)).map((x) => x.id)];
      for (const v of viz) {
        if (vis.has(v)) continue;
        vis.add(v);
        prev.set(v, cur);
        if (v === b) {
          const caminho = [b];
          let c = b;
          while (prev.has(c)) { c = prev.get(c); caminho.unshift(c); }
          return caminho;
        }
        fila.push(v);
      }
    }
    return null;
  }
  function descreve(a, b) {
    const pa = byId.get(a), pb = byId.get(b);
    if (!pa || !pb) return 'parentesco';
    if (pa.pais.includes(b)) return 'pai/mãe';
    if (pb.pais.includes(a)) return 'filho(a)';
    if (pa.conjuges.includes(b)) return 'cônjuge';
    if ((pa.exDe || []).includes(b)) return 'ex-cônjuge';
    const ids = new Set(pa.pais);
    if (pb.pais.some((pp) => ids.has(pp))) return 'irmão/irmã';
    return 'parente';
  }
  $('kz-rel-calcular').addEventListener('click', () => {
    const res = $('kz-rel-resultado');
    if (!relAId || !relBId) { res.textContent = 'Escolha as duas pessoas para calcular o caminho.'; return; }
    const caminho = bfs(relAId, relBId);
    if (!caminho) { res.innerHTML = '<p>Não foi encontrado um caminho usando apenas os vínculos registrados. É possível que o parentesco seja real, mas esteja incompleto nos registros.</p>'; return; }
    const partes = caminho.map((id, i) => {
      const p = byId.get(id);
      const rot = i > 0 ? ` <small>— ${esc(descreve(caminho[i - 1], id))} →</small>` : '';
      return `<button type="button" class="kz-rel-pess" data-nav="${esc(id)}">${esc(p.nome)}</button>${rot}`;
    }).join(' ');
    res.innerHTML = `<p><strong>Caminho com ${caminho.length} ${caminho.length === 1 ? 'pessoa' : 'pessoas'}:</strong></p><p class="kz-rel-caminho">${partes}</p><p class="kz-rel-nota">Cada salto usa um vínculo registrado entre as pessoas.</p>`;
    res.querySelectorAll('[data-nav]').forEach((b) => b.addEventListener('click', () => { fecharModal(); selecionar(b.dataset.nav); }));
  });

  /* ---------- arranque ---------- */
  (async () => {
    if (isCloudEnabled()) {
      try {
        const remoto = await fetchPessoas(PESSOAS.slice());
        if (remoto && remoto.length) {
          PESSOAS.length = 0;
          PESSOAS.push(...remoto);
          byId.clear();
          for (const p of PESSOAS) byId.set(p.id, p);
        }
      } catch (e) { console.warn('Kizuna: nuvem indisponível, usando dados locais.', e); }
    }
    const foco = new URLSearchParams(window.location.search).get('pessoa');
    const inicial = (foco && byId.has(foco)) ? foco : (byId.has(ENTRADA) ? ENTRADA : (PESSOAS[0]?.id || ''));
    if (inicial) selecionar(inicial, true);
    // no desktop o painel abre por padrão; no celular/folha inferior fica fechado até pedido
    if (window.innerWidth > 1180) painel.classList.add('kz-painel--aberto');
  })().catch((e) => console.error('Kizuna: falha no arranque.', e));

  let tRedim;
  window.addEventListener('resize', () => {
    clearTimeout(tRedim);
    tRedim = setTimeout(() => { if (selecionado) desenharLinhas(); }, 120);
  });
</script>

