  .kz-card { display: flex; align-items: center; gap: 0.6rem; background: var(--creme); border: 1px solid var(--borda); border-radius: 10px; padding: 0.5rem; cursor: pointer; text-align: left; transition: transform 0.15s, box-shadow 0.15s; }
