---
import Base from '../layouts/Base.astro';
import TimelineEvent from '../components/TimelineEvent.astro';
import { eventos, tipoDeEvento } from '../data/familia';

const filtros = [
  { chave: 'todas', rotulo: 'Todas' },
  { chave: 'nascimento', rotulo: 'Nascimentos' },
  { chave: 'despedida', rotulo: 'Despedidas' },
  { chave: 'marco', rotulo: 'Marcos' },
] as const;

const conta = (chave: string) =>
  chave === 'todas'
    ? eventos.length
    : eventos.filter((e) => tipoDeEvento(e) === chave).length;
---

<Base title="Linha do Tempo" description="A trajetória da Família Kato em ordem cronológica.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">Linha do Tempo</span>
      <h1>Como tudo foi acontecendo</h1>
      <p class="lead">
        Nascimentos, despedidas e marcos — do mais antigo para o mais recente.
        Clique numa pessoa para conhecê-la.
      </p>

      <div class="filtros" role="group" aria-label="Filtrar marcos">
        {filtros.map((f) => (
          <button class="filtros__botao" data-filtro={f.chave} type="button">
            {f.rotulo}
            <span class="filtros__conta">{conta(f.chave)}</span>
          </button>
        ))}
      </div>

      <div class="timeline">
        {eventos.map((evento) => <TimelineEvent evento={evento} />)}
      </div>

      <p class="timeline__fim">… e a história continua sendo escrita. 🎋</p>

      <p class="empty">
        Faltando um marco importante? <a href="/admin">Manda para a gente</a>.
      </p>
    </div>
  </section>
</Base>

<script>
  const botoes = Array.from(document.querySelectorAll<HTMLButtonElement>('.filtros__botao'));
  botoes.forEach((botao) => {
    botao.addEventListener('click', () => {
      botoes.forEach((b) => b.classList.toggle('is-ativo', b === botao));
      const alvo = botao.dataset.filtro;
      document.querySelectorAll<HTMLElement>('.evento[data-tipo]').forEach((e) => {
        e.classList.toggle('evento--oculto', alvo !== 'todas' && e.dataset.tipo !== alvo);
      });
    });
  });
</script>

<style>
  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.8rem 0 1.4rem;
  }

  .filtros__botao {
    font: inherit;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #fff;
    color: var(--texto);
    border: 1px solid var(--montanha);
    border-radius: 999px;
    padding: 0.45rem 1rem;
    cursor: pointer;
    transition: all 0.2s;
  }

  .filtros__botao:hover {
    border-color: var(--vinho);
    color: var(--vinho);
  }

  .filtros__botao.is-ativo {
    background: var(--vinho);
    border-color: var(--vinho);
    color: #fff;
  }

  .filtros__conta {
    font-size: 0.72rem;
    font-weight: 700;
    background: var(--montanha-claro);
    color: var(--texto-suave);
    border-radius: 999px;
    padding: 0.08rem 0.5rem;
  }

  .filtros__botao.is-ativo .filtros__conta {
    background: rgba(255, 255, 255, 0.22);
    color: #fff;
  }

  .timeline {
    margin: 0 0 1rem;
    max-width: 820px;
  }

  .evento--oculto {
    display: none !important;
  }

  .timeline__fim {
    max-width: 820px;
    text-align: center;
    color: var(--texto-suave);
    font-size: 0.9rem;
    margin: 2.4rem 0 1.4rem;
  }
</style>